# GURTBUILD for linusr34 — made with the upload form on the GURT site
pkgname=linusr34
pkgver=1.0.0
pkgrel=1
pkgdesc="Fake Linus Torvalds R34"
url="https://tinyurl.com/linus-torvalds-r34-gurt"
license=('MIT')
maintainer="clrealy"
arch=('any')
depends=('xdg-utils')
makedepends=()
source=("myapp.png::https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT4P_uYAGdXm9qL7Yt9avvu9JlQv-zZGuxC9riOIjbSTRrWMAR6lH3QQAZhUDOpUpTmUzaeCSPmhE5d0XyvthcUTqDK9pgOkRZVzIPGnc68&s=10")
sha256sums=('SKIP')

build() {
  # Nothing to compile for a desktop shortcut script
  true
}

package() {
  # Create bin directory and executable script
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/$pkgname" <<'EOF'
#!/bin/sh
exec xdg-open "https://tinyurl.com/linus-torvalds-r34-gurt"
EOF
  chmod 755 "$pkgdir/usr/bin/$pkgname"

  # Install launcher icon
  install -Dm644 "$srcdir/myapp.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/$pkgname.png"

  # Install .desktop file
  install -d "$pkgdir/usr/share/applications"
  cat > "$pkgdir/usr/share/applications/$pkgname.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Linus Torvalds R34
Exec=$pkgname
Icon=$pkgname
Terminal=false
Categories=Network;
EOF
}
