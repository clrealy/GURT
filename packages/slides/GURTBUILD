sha256sums_aarch64=(00a84b2ccd12554bd27983ba46dbdab3542d4af6e4858e1929c7f93785880768)

package() {
  local f
  f=$(find . -type f -name slides -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name slides | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/slides"
}
