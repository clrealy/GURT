# API client like Postman, but in your terminal
pkgname=atac
pkgver=0.23.1
pkgrel=1
pkgdesc="API client like Postman, but in your terminal"
url="https://github.com/Julien-cpsn/ATAC"
license="MIT"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/Julien-cpsn/ATAC/releases/download/${_tag}/atac-${_tag}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/Julien-cpsn/ATAC/releases/download/${_tag}/atac-${_tag}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=(dcd61727c3871e3643439dd32d3182995bb5337feeba5bdbbcd3d6432cf00618)
sha256sums_aarch64=(fea0eb4adb7d3df156b94e95d74c59c7489da6d8c6ad5c0be0ca1e3b910952e4)

package() {
  local f
  f=$(find . -type f -name atac -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name atac | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/atac"
}
