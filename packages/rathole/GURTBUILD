package() {
  local f
  f=$(find . -type f -name rathole -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name rathole | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/rathole"
}
