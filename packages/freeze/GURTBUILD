# Turn code and terminal output into pretty images
pkgname=freeze
pkgver=0.2.2
pkgrel=1
pkgdesc="Turn code and terminal output into pretty images"
url="https://github.com/charmbracelet/freeze"
license="MIT"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/charmbracelet/freeze/releases/download/${_tag}/freeze_${pkgver}_Linux_x86_64.tar.gz")
source_aarch64=("https://github.com/charmbracelet/freeze/releases/download/${_tag}/freeze_${pkgver}_Linux_arm64.tar.gz")
sha256sums_x86_64=(012fdbdd16c0c19570f9052aac34d16d93d7d0d3b565b05374cc59492f53539b)
sha256sums_aarch64=(ba1164c2e6d573af32df13ddc5868f7cdfc8b9992f26f53695787ca5f4274023)

package() {
  local f
  f=$(find . -type f -name freeze -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name freeze | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/freeze"
}
