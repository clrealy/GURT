url="https://github.com/rclone/rclone"
license="MIT"
maintainer="clrealy"
category="internet"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/rclone/rclone/releases/download/${_tag}/rclone-${_tag}-linux-amd64.zip")
