sha256sums_x86_64=(982b5aa772841168f8e380f139e9e787b2a105403e32b94da8676a0e1c0a13ab)
sha256sums_aarch64=(03f2504174034b6d004152ed7369251c9a9ec1f7e0836eda420f5c7a5ec0dff9)

package() {
  local f
  f=$(find . -type f -name rclone -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name rclone | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/rclone"
}
