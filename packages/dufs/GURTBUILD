package() {
  local f
  f=$(find . -type f -name dufs -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name dufs | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/dufs"
}
