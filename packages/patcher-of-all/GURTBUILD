# patcher-of-all: the patcher that patches patchers 🩹
# one CLI for every patch on ur system, with status, revert, and auto re-patch after app updates
# replaces photogimp-patcher + geode-patcher (now the photogimp + geode recipes)
pkgname=patcher-of-all
pkgver=1.1.1
pkgrel=1
pkgdesc="One hub for every patch: PhotoGIMP, Geode, Balatro mods, Spicetify, Betterfox, fonts, GTK themes + auto re-patch"
aliases=(patcher-patcher poa)
url="https://github.com/clrealy/GURT"
license="MIT"
maintainer="clrealy"
category="system"
arch=(any)
depends=(curl python3)
makedepends=()
_recipes=(adw balatro betterfox geode msfonts nerdfont photogimp spicetify steam-shortcuts)
source=("patcher-of-all" "patcher-of-all.png" "${_recipes[@]/%/.sh}")
sha256sums=("2caaf292f80e6c633eea67b4d8ad5db0769e45de03861977af1a39f2c0667d9f"
            "4a7e2d5f686ce51764365359bd26d029404227698843d17288b9ae8d9208efbf"
            "c1fcae53514aa2466b759d8f618a1586d556c5d411dbe4fa8b4204ba52682d6e"
            "91fbd2f097eb3d3fce925b9594cdb3d0ab97f84f61102dc86b96d8e3e20b3a42"
            "eac4b80c7b6d802134a7927926c07ef43969cc60d57ad3745935a82a361e623f"
            "87aa86e4c8cac1f8da7a07d09fa3b8723ac0ca4e58c4ca8d08b9aa8a7120546d"
            "211b245261ee3366b4dbb87749fe6c757903c0622567cadc3f5a50159a58062e"
            "cb42e04532d98042f8de5209171573a00752d43d22d24e63129beabbf6fff919"
            "013883fb389fd9493583303aedfc7518742e4f06b3cd6d9f648775a0a24b981a"
            "d92e0600fdddabc8ac777d7cda3ef169cd52788de1e6fe81735df54b04b248af"
