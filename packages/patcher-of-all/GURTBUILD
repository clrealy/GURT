# patcher-of-all: the patcher that patches patchers 🩹
# one app + CLI for every patch on ur system, with status, revert, and auto re-patch after app updates
# replaces photogimp-patcher + geode-patcher (now the photogimp + geode recipes)
pkgname=patcher-of-all
pkgver=1.3.1
pkgrel=1
pkgdesc="One hub for every patch: PhotoGIMP, Geode, Balatro mods, Spicetify, Betterfox, fresh yt-dlp, fonts, GTK themes + auto re-patch"
aliases=(patcher-patcher poa)
url="https://github.com/clrealy/GURT"
license="MIT"
maintainer="clrealy"
category="system"
arch=(any)
depends=(curl python3 python3-tk)
makedepends=()
_recipes=(adw balatro betterfox geode msfonts nerdfont photogimp spicetify steam-shortcuts yt-dlp)
source=("patcher-of-all" "patcher-of-all-gui" "patcher-of-all.png" "${_recipes[@]/%/.sh}")
