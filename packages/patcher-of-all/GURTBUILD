package() {
  install -Dm755 "$srcdir/patcher-of-all" "$pkgdir$prefix/bin/patcher-of-all"
  ln -sf patcher-of-all "$pkgdir$prefix/bin/patcher-patcher"
  install -Dm755 "$srcdir/patcher-of-all-gui" "$pkgdir$prefix/share/patcher-of-all/patcher-of-all-gui"
  install -Dm644 "$srcdir/patcher-of-all.png" "$pkgdir$prefix/share/pixmaps/patcher-of-all.png"
  # app-menu launcher opens the GUI. absolute paths: launchers don't read your shell PATH
  printf '[Desktop Entry]\nType=Application\nName=Patcher of All\nComment=Patch anything*: see and fix every patch on your system\nExec=%s/bin/patcher-of-all gui\nIcon=%s/share/pixmaps/patcher-of-all.png\nTerminal=false\nStartupWMClass=patcher-of-all\nCategories=System;Utility;\nKeywords=patch;patcher;photogimp;geode;balatro;spicetify;mods;\n' \
    "$prefix" "$prefix" > patcher-of-all.desktop
  install -Dm644 patcher-of-all.desktop "$pkgdir$prefix/share/applications/patcher-of-all.desktop"
  local r
  for r in "${_recipes[@]}"; do
    install -Dm644 "$srcdir/$r.sh" "$pkgdir$prefix/share/patcher-of-all/recipes/$r.sh"
  done
}
