#!/usr/bin/env bash
# patcher-of-all — the patcher that patches patchers
# aka patcher-patcher. one hub for every patch on ur system.
set -uo pipefail

VERSION="1.1.1"
PROG="$(basename "$0")"

SELF_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SYS_RECIPES="${POA_SYS_RECIPES:-/usr/share/patcher-of-all/recipes}"
PREFIX_RECIPES="$(cd "$SELF_DIR/.." && pwd)/share/patcher-of-all/recipes"  # wherever we got installed (gurt, /usr/local, ~/.local)
USER_RECIPES="${XDG_DATA_HOME:-$HOME/.local/share}/patcher-of-all/recipes"
DEV_RECIPES="$SELF_DIR/recipes"
POA_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/patcher-of-all"
export POA_CONFIG
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/patcher-of-all"
STATE_FILE="$STATE_DIR/applied"
BACKUP_DIR="$STATE_DIR/backups"
SELF_COUNT="$STATE_DIR/.self"

mkdir -p "$STATE_DIR" "$BACKUP_DIR" "$USER_RECIPES"
touch "$STATE_FILE"

# ---------- pretty output ----------
if [[ -t 1 ]]; then
  B=$'\e[1m'; R=$'\e[31m'; G=$'\e[32m'; Y=$'\e[33m'; C=$'\e[36m'; D=$'\e[2m'; N=$'\e[0m'
else
  B=""; R=""; G=""; Y=""; C=""; D=""; N=""
fi
say()  { printf '%s\n' "${C}::${N} $*"; }
ok()   { printf '%s\n' "${G}✔${N} $*"; }
warn() { printf '%s\n' "${Y}!${N} $*" >&2; }
die()  { printf '%s\n' "${R}✘${N} $*" >&2; exit 1; }

# ---------- helpers recipes can use ----------
# every recipe is sourced after these exist, so recipes just call them

# print each Steam library folder (native, Flatpak, Snap + extra drives), one per line
poa_steam_libs() {
  local r
  for r in "$HOME/.steam/steam" "$HOME/.steam/root" "$HOME/.local/share/Steam" \
           "$HOME/.var/app/com.valvesoftware.Steam/.local/share/Steam" \
           "$HOME/snap/steam/common/.local/share/Steam"; do
    [[ -d "$r/steamapps" ]] || continue
    printf '%s\n' "$r"
    grep -o '"path"[[:space:]]*"[^"]*"' "$r/steamapps/libraryfolders.vdf" 2>/dev/null \
      | sed 's/.*"path"[[:space:]]*"\(.*\)"/\1/'
  done | while IFS= read -r r; do
    r="$(readlink -f "$r" 2>/dev/null)" && [[ -d "$r/steamapps" ]] && printf '%s\n' "$r"
  done | awk '!seen[$0]++'
}

# poa_steam_game <appid> <exe-to-confirm> [fallback-folder] -> game folder
poa_steam_game() {
  local appid="$1" exe="$2" fb="${3:-}" lib dir
  while read -r lib; do
    dir="$(grep -o '"installdir"[[:space:]]*"[^"]*"' "$lib/steamapps/appmanifest_$appid.acf" 2>/dev/null \
           | sed 's/.*"installdir"[[:space:]]*"\(.*\)"/\1/')"
    [[ -n "$dir" && -e "$lib/steamapps/common/$dir/$exe" ]] && { echo "$lib/steamapps/common/$dir"; return 0; }
    [[ -n "$fb" && -e "$lib/steamapps/common/$fb/$exe" ]] && { echo "$lib/steamapps/common/$fb"; return 0; }
  done < <(poa_steam_libs)
  return 1
}

# poa_steam_prefix <appid> -> the game's Proton prefix (drive_c lives in here)
poa_steam_prefix() {
  local lib
  while read -r lib; do
    [[ -d "$lib/steamapps/compatdata/$1/pfx" ]] && { echo "$lib/steamapps/compatdata/$1/pfx"; return 0; }
  done < <(poa_steam_libs)
  return 1
}

# poa_gh_asset <owner/repo> <grep -E regex for the asset name> -> download URL of latest release asset
poa_gh_asset() {
  curl -fsSL -H "Accept: application/vnd.github+json" "https://api.github.com/repos/$1/releases/latest" \
    | grep -o '"browser_download_url":[[:space:]]*"[^"]*"' | sed 's/.*"\(http[^"]*\)"/\1/' \
    | grep -Ei "$2" | head -n1
}

# poa_unzip <zip> <dest> — refuses zips with ../ or absolute paths
poa_unzip() {
  mkdir -p "$2"
  if command -v python3 >/dev/null; then
    python3 - "$1" "$2" <<'PY'
import sys, zipfile, os
z, dest = zipfile.ZipFile(sys.argv[1]), os.path.realpath(sys.argv[2])
for m in z.infolist():
    t = os.path.realpath(os.path.join(dest, m.filename))
    if t != dest and not t.startswith(dest + os.sep):
        sys.exit(f"sketchy path in zip: {m.filename}")
z.extractall(dest)
PY
  elif command -v unzip >/dev/null; then
    unzip -Z1 "$1" | grep -qE '(^/|(^|/)\.\.(/|$))' && { echo "sketchy path in zip" >&2; return 1; }
    unzip -oq "$1" -d "$2"
  elif command -v bsdtar >/dev/null; then
    bsdtar -xf "$1" -C "$2"   # bsdtar strips ../ and leading / by default
  else
    echo "need python3, unzip or bsdtar to extract zips" >&2; return 1
  fi
}

# poa_clip <text> — copies to clipboard if it can, always prints it
poa_clip() {
  printf '%s' "$1" | { wl-copy 2>/dev/null || xclip -selection clipboard 2>/dev/null || xsel -b 2>/dev/null; } \
    && echo "(copied to ur clipboard)"
  return 0
}

# poa_setting <ENV_VAR> <file-in-config> [default] -> env var wins (and gets saved), else saved file, else default
poa_setting() {
  local v="${!1:-}" f="$POA_CONFIG/$2"
  if [[ -n "$v" ]]; then mkdir -p "$POA_CONFIG"; printf '%s\n' "$v" > "$f"; printf '%s\n' "$v"
  elif [[ -s "$f" ]]; then head -n1 "$f"
  else printf '%s\n' "${3:-}"; fi
}

poa_need() { local c; for c; do command -v "$c" >/dev/null || { echo "missing '$c' — install it first (gurt install $c)" >&2; return 1; }; done; }

# ---------- recipes ----------
recipe_dirs() { printf '%s\n' "$USER_RECIPES" "$DEV_RECIPES" "$PREFIX_RECIPES" "$SYS_RECIPES"; }

find_recipe() {
  local d
  while read -r d; do
    [[ -f "$d/$1.sh" ]] && { printf '%s\n' "$d/$1.sh"; return 0; }
  done < <(recipe_dirs)
  return 1
}

all_recipes() {
  local d f
  while read -r d; do
    [[ -d "$d" ]] || continue
    for f in "$d"/*.sh; do
      [[ -f "$f" ]] && basename "$f" .sh
    done
  done < <(recipe_dirs) | sort -u
}

# run one hook from a recipe in a sandboxed subshell
# hooks: poa_detect poa_check poa_apply poa_revert
run_hook() {
  local name="$1" hook="$2" file
  file="$(find_recipe "$name")" || return 2
  (
    POA_NAME="$name"
    POA_BACKUP="$BACKUP_DIR/$name"
    mkdir -p "$POA_BACKUP"
    export POA_NAME POA_BACKUP
    # shellcheck disable=SC1090
    source "$file"
    declare -F "$hook" >/dev/null || exit 3
    "$hook"
  )
}

meta() { # meta <name> <VAR>
  local file; file="$(find_recipe "$1")" || return 1
  # shellcheck disable=SC1090
  ( source "$file" >/dev/null 2>&1; printf '%s' "${!2:-}" )
}

is_marked() { grep -qxF "$1" "$STATE_FILE"; }
mark()      { is_marked "$1" || echo "$1" >> "$STATE_FILE"; }
unmark()    { local t; t="$(grep -vxF "$1" "$STATE_FILE" || true)"; printf '%s\n' "$t" | sed '/^$/d' > "$STATE_FILE"; }

status_of() { # prints: missing | patched | broken | unpatched
  local n="$1"
  if ! run_hook "$n" poa_detect >/dev/null 2>&1; then echo missing
  elif run_hook "$n" poa_check >/dev/null 2>&1; then echo patched
  elif is_marked "$n"; then echo broken
  else echo unpatched; fi
}

badge() {
  case "$1" in
    patched)   printf '%s' "${G}✅ patched${N}" ;;
    broken)    printf '%s' "${R}❌ broken (update nuked it?)${N}" ;;
    unpatched) printf '%s' "${Y}⬜ not patched${N}" ;;
    missing)   printf '%s' "${D}➖ app not installed${N}" ;;
  esac
}

# ---------- the self-patch bit ----------
is_self() { [[ "$1" == "patcher-of-all" || "$1" == "patcher-patcher" || "$1" == "poa" ]]; }

self_patch() {
  local c=0
  [[ -f "$SELF_COUNT" ]] && c="$(cat "$SELF_COUNT")"
  c=$((c + 1)); echo "$c" > "$SELF_COUNT"
  say "patching patcher-of-all with patcher-of-all..."
  sleep 1
  case "$c" in
    1) ok "done?? i think?? nothing changed but it feels different" ;;
    2) warn "bro patched himself twice 🤨" ;;
    *) printf '%s\n' "${R}${B}bro is NOT okay 💀${N}"; echo 0 > "$SELF_COUNT" ;;
  esac
}

# ---------- commands ----------
cmd_list() {
  local n any=0
  for n in $(all_recipes); do
    any=1
    printf '%s%-22s%s %s\n' "$B" "$n" "$N" "$(meta "$n" DESC)"
  done
  [[ $any == 1 ]] || warn "no recipes found. make one with: $PROG new <name>"
}

cmd_status() {
  local n s any=0
  [[ "${1:-}" == --wait ]] && printf '%s\n\n' "${B}patcher-of-all${N} — patch anything*"
  for n in $(all_recipes); do
    any=1
    s="$(status_of "$n")"
    printf '%s%-22s%s %s\n' "$B" "$n" "$N" "$(badge "$s")"
  done
  [[ $any == 1 ]] || warn "no recipes found"
  if [[ "${1:-}" == --wait ]]; then
    printf '\n%s\n' "${D}patch something: patcher-of-all apply <name>   ·   all commands: patcher-of-all --help${N}"
    [[ -t 0 ]] && read -r -p "press enter to close " _
  fi
  return 0
}

cmd_apply() {
  [[ $# -gt 0 ]] || die "usage: $PROG apply <name>..."
  local n rc fail=0
  for n in "$@"; do
    if is_self "$n"; then self_patch; continue; fi
    find_recipe "$n" >/dev/null || { warn "no recipe called '$n'"; fail=1; continue; }
    run_hook "$n" poa_detect >/dev/null 2>&1 || { warn "$n: the app isn't installed, skipping"; fail=1; continue; }
    say "applying ${B}$n${N}..."
    run_hook "$n" poa_apply; rc=$?
    if [[ $rc -ne 0 ]]; then warn "$n: apply failed (exit $rc)"; fail=1; continue; fi
    mark "$n"
    if run_hook "$n" poa_check >/dev/null 2>&1; then ok "$n patched"
    else warn "$n: apply ran but the check doesn't see the patch yet (might need an app restart)"; fi
  done
  return $fail
}

cmd_revert() {
  [[ $# -gt 0 ]] || die "usage: $PROG revert <name>..."
  local n rc fail=0
  for n in "$@"; do
    if is_self "$n"; then ok "reverted patcher-of-all to factory vibes"; echo 0 > "$SELF_COUNT"; continue; fi
    find_recipe "$n" >/dev/null || { warn "no recipe called '$n'"; fail=1; continue; }
    say "reverting ${B}$n${N}..."
    run_hook "$n" poa_revert; rc=$?
    if [[ $rc -eq 3 ]]; then warn "$n has no revert hook"; fail=1; continue; fi
    if [[ $rc -ne 0 ]]; then warn "$n: revert failed (exit $rc)"; fail=1; continue; fi
    unmark "$n"; ok "$n back to stock"
  done
  return $fail
}

cmd_repatch() {
  local n s fixed=0
  [[ -s "$STATE_FILE" ]] || { say "nothing has been patched yet"; return 0; }
  while read -r n; do
    [[ -n "$n" ]] || continue
    find_recipe "$n" >/dev/null || { warn "$n: recipe is gone, forgetting it"; unmark "$n"; continue; }
    s="$(status_of "$n")"
    case "$s" in
      broken)  say "$n got un-patched, fixing..."; cmd_apply "$n" && fixed=$((fixed + 1)) ;;
      missing) warn "$n: app isn't installed anymore" ;;
      *)       [[ "${QUIET:-0}" == 1 ]] || ok "$n still patched" ;;
    esac
  done < <(cat "$STATE_FILE")
  [[ $fixed -gt 0 ]] && ok "re-patched $fixed thing(s)"
  return 0
}

cmd_info() {
  local n="${1:-}" f; [[ -n "$n" ]] || die "usage: $PROG info <name>"
  f="$(find_recipe "$n")" || die "no recipe called '$n'"
  printf '%sname%s    %s\n' "$B" "$N" "$n"
  printf '%sdesc%s    %s\n' "$B" "$N" "$(meta "$n" DESC)"
  printf '%surl%s     %s\n' "$B" "$N" "$(meta "$n" URL)"
  printf '%sstatus%s  %s\n' "$B" "$N" "$(badge "$(status_of "$n")")"
  printf '%srecipe%s  %s\n' "$B" "$N" "$f"
}

cmd_add() {
  local f="${1:-}" n; [[ -f "$f" ]] || die "usage: $PROG add <recipe.sh>"
  bash -n "$f" || die "that recipe has syntax errors"
  grep -q 'poa_apply' "$f" && grep -q 'poa_detect' "$f" && grep -q 'poa_check' "$f" \
    || die "recipe needs poa_detect, poa_check and poa_apply"
  n="$(basename "$f" .sh)"
  cp "$f" "$USER_RECIPES/$n.sh"
  ok "added recipe '$n'"
}

cmd_new() {
  local n="${1:-}" out
  [[ "$n" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "usage: $PROG new <name> (lowercase, no spaces)"
  out="$USER_RECIPES/$n.sh"
  [[ -e "$out" ]] && die "'$n' already exists at $out"
  cat > "$out" <<EOF
# patcher-of-all recipe: $n
DESC="what this patch does"
URL=""

# return 0 if the app this patches is installed
poa_detect() {
  command -v some-app >/dev/null
}

# return 0 if the patch is currently applied
poa_check() {
  false
}

# apply the patch. \$POA_BACKUP is a folder u can stash originals in
poa_apply() {
  echo "apply stuff here"
}

# undo it
poa_revert() {
  echo "revert stuff here"
}
EOF
  ok "made $out — go edit it"
}

cmd_autopatch() {
  local unit_dir="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user" bin
  bin="$(readlink -f "$0")"
  case "${1:-on}" in
    on)
      if command -v systemctl >/dev/null && systemctl --user show-environment >/dev/null 2>&1; then
        mkdir -p "$unit_dir"
        printf '[Unit]\nDescription=patcher-of-all auto re-patch\n\n[Service]\nType=oneshot\nEnvironment=QUIET=1\nExecStart=%s repatch\n' "$bin" > "$unit_dir/patcher-of-all.service"
        printf '[Unit]\nDescription=run patcher-of-all repatch every hour\n\n[Timer]\nOnBootSec=2min\nOnUnitActiveSec=1h\n\n[Install]\nWantedBy=timers.target\n' > "$unit_dir/patcher-of-all.timer"
        systemctl --user daemon-reload && systemctl --user enable --now patcher-of-all.timer \
          && ok "auto re-patch on (systemd user timer, hourly + at login)"
      else
        local ad="${XDG_CONFIG_HOME:-$HOME/.config}/autostart"
        mkdir -p "$ad"
        printf '[Desktop Entry]\nType=Application\nName=patcher-of-all repatch\nExec=env QUIET=1 %s repatch\nX-GNOME-Autostart-enabled=true\n' "$bin" > "$ad/patcher-of-all.desktop"
        ok "auto re-patch on (runs at login — no systemd, no problem)"
      fi ;;
    off)
      systemctl --user disable --now patcher-of-all.timer >/dev/null 2>&1 || true
      rm -f "$unit_dir/patcher-of-all.service" "$unit_dir/patcher-of-all.timer" \
            "${XDG_CONFIG_HOME:-$HOME/.config}/autostart/patcher-of-all.desktop"
      ok "auto re-patch off" ;;
    *) die "usage: $PROG autopatch [on|off]" ;;
  esac
}

usage() {
  cat <<EOF
${B}patcher-of-all${N} $VERSION — the patcher that patches patchers 🩹

  ${B}list${N}                 every patch recipe u have
  ${B}status${N}               ✅ / ❌ / ⬜ for everything
  ${B}apply${N} <name>...      patch it
  ${B}revert${N} <name>...     back to stock
  ${B}repatch${N}              re-apply anything an update un-patched
  ${B}autopatch${N} [on|off]   run repatch automatically
  ${B}info${N} <name>          details on one recipe
  ${B}new${N} <name>           scaffold ur own recipe
  ${B}add${N} <file.sh>        install a recipe file

recipes live in:
  $USER_RECIPES
  $SYS_RECIPES
EOF
}

case "${1:-}" in
  list|ls)        shift; cmd_list "$@" ;;
  status|st)      shift; cmd_status "$@" ;;
  apply|patch)    shift; cmd_apply "$@" ;;
  revert|unpatch) shift; cmd_revert "$@" ;;
  repatch|fix)    shift; cmd_repatch "$@" ;;
  autopatch)      shift; cmd_autopatch "$@" ;;
  info)           shift; cmd_info "$@" ;;
  new)            shift; cmd_new "$@" ;;
  add)            shift; cmd_add "$@" ;;
  -v|--version)   echo "patcher-of-all $VERSION" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command '$1' — try $PROG --help" ;;
esac
