pkgname=btop
pkgver=1.4.4
pkgrel=2
pkgdesc="Good-looking system monitor for your CPU, memory, disks, network and processes"
url="https://github.com/aristocratos/btop"
license="Apache-2.0"
maintainer="clrealy"
category="cli"
arch=(x86_64 aarch64 armv7l riscv64)
depends=()
makedepends=(cc make git linux-headers)   # Intel GPU support includes <linux/*.h> (Alpine ships those separately)
source=("git+https://github.com/aristocratos/btop.git#tag=v$pkgver")
sha256sums=(SKIP)

build() {
  cd btop
  make PREFIX="$prefix" STATIC=false
}

package() {
  cd btop
  make install PREFIX="$prefix" DESTDIR="$pkgdir"
}
