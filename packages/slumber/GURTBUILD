package() {
  local f
  f=$(find . -type f -name slumber -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name slumber | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/slumber"
}
