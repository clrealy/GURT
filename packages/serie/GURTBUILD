arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/lusingander/serie/releases/download/${_tag}/serie-${pkgver}-x86_64-unknown-linux-musl.tar.gz")
