# Like awk and sed, but for CSV, TSV and JSON (run mlr)
pkgname=miller
pkgver=6.22.0
pkgrel=1
pkgdesc="Like awk and sed, but for CSV, TSV and JSON (run mlr)"
url="https://github.com/johnkerl/miller"
license="BSD-2-Clause"
maintainer="clrealy"
category="cli"
arch=(x86_64 aarch64)
aliases=(mlr)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/johnkerl/miller/releases/download/${_tag}/miller-${pkgver}-linux-amd64.tar.gz")
source_aarch64=("https://github.com/johnkerl/miller/releases/download/${_tag}/miller-${pkgver}-linux-arm64.tar.gz")
sha256sums_x86_64=(0551f8696e8f42dae1c67c782bbe04e0589e718268722fa98561e2566e4623b8)
sha256sums_aarch64=(86dbf9078cf4cd96fef7a8306b3786a441cdf7f8526324a233e38c37c4bfe742)

package() {
  local f
  f=$(find . -type f -name mlr -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name mlr | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/mlr"
}
