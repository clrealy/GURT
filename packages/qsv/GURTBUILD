# Blazing fast CSV toolkit
pkgname=qsv
pkgver=25.0.0
pkgrel=1
pkgdesc="Blazing fast CSV toolkit"
url="https://github.com/dathere/qsv"
license="MIT OR Unlicense"
maintainer="clrealy"
category="cli"
arch=(x86_64)
# official prebuilt release binary
source=("https://github.com/dathere/qsv/releases/download/${pkgver}/qsv-${pkgver}-x86_64-unknown-linux-musl.zip")
sha256sums=('8d04b7ce68bc839778a6daf203978168ae5ad23f22b62749c5063be6a84b4865')

package() {
  local f
  f=$(find . -type f -name qsv -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name qsv | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/qsv"
}
