# Run AI models like Llama, Gemma and Qwen locally on your own PC
pkgname=ollama
pkgver=0.35.1
pkgrel=1
pkgdesc="Run AI models like Llama, Gemma and Qwen locally on your own PC (big download: it brings GPU support)"
url="https://ollama.com"
license="MIT"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
makedepends=(zstd)
# the official prebuilt release (same files ollama's own install script uses)
source_x86_64=("https://github.com/ollama/ollama/releases/download/v$pkgver/ollama-linux-amd64.tar.zst")
source_aarch64=("https://github.com/ollama/ollama/releases/download/v$pkgver/ollama-linux-arm64.tar.zst")
sha256sums_x86_64=(9fcd79ac4575b2bd31b992eee18b1000c8ad126b451627c8f8cd091714cfbb10)
sha256sums_aarch64=(b1b1c85d25136b256d3740f6ecd2f7c0105e8ca71642fd6ff2fc199f3cefd69d)

package() {
  # ollama looks for its GPU libraries in ../lib/ollama next to the binary
  install -Dm755 bin/ollama "$pkgdir$prefix/bin/ollama"
  mkdir -p "$pkgdir$prefix/lib"
  cp -a lib/ollama "$pkgdir$prefix/lib/"
}
