# Tail logs from lots of Kubernetes pods at once
pkgname=stern
pkgver=1.34.0
pkgrel=1
pkgdesc="Tail logs from lots of Kubernetes pods at once"
url="https://github.com/stern/stern"
license="Apache-2.0"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/stern/stern/releases/download/${_tag}/stern_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/stern/stern/releases/download/${_tag}/stern_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=(7754adfa653939240f7d20fff4ada9b69cda40c9e70732301f67bb8045f1ef3e)
sha256sums_aarch64=(e215cfc5e42d71e93b77d3fac8f0df7d736271f44b2d92a5b417eaa588edff3a)

package() {
  local f
  f=$(find . -type f -name stern -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name stern | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/stern"
}
