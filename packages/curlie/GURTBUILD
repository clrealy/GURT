# curl with the friendly output of httpie
pkgname=curlie
pkgver=1.8.2
pkgrel=1
pkgdesc="curl with the friendly output of httpie"
url="https://github.com/rs/curlie"
license="MIT"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/rs/curlie/releases/download/${_tag}/curlie_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/rs/curlie/releases/download/${_tag}/curlie_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=(033d39a06d7a4320f923c49b488b89ec415c1901413ae85d26b9f7a09b38f1a1)
sha256sums_aarch64=(570d505ad08e51ffe98e2ee39ee969cb340e846bc17a10ed2e4ba7a5e9d64c1a)

package() {
  local f
  f=$(find . -type f -name curlie -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name curlie | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/curlie"
}
