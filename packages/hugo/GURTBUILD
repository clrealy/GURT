package() {
  local f
  f=$(find . -type f -name hugo -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name hugo | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/hugo"
}
