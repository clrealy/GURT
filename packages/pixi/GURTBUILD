# Package manager for Python, C++ and more, built on conda
pkgname=pixi
pkgver=0.81.0
pkgrel=1
pkgdesc="Package manager for Python, C++ and more, built on conda"
url="https://github.com/prefix-dev/pixi"
license="BSD-3-Clause"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/prefix-dev/pixi/releases/download/${_tag}/pixi-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/prefix-dev/pixi/releases/download/${_tag}/pixi-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=(7aa3ec39aecceff9062fa2ed4d42cbaa0bdc25ddea727d048e061cf188d434f6)
sha256sums_aarch64=(9f8d2113fe9dc01788a65f5c2acec34fa56b1193461a5c3e9a775d6d2d621bcb)

package() {
  local f
  f=$(find . -type f -name pixi -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name pixi | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/pixi"
}
