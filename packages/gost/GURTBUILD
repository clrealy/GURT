maintainer="clrealy"
category="internet"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/go-gost/gost/releases/download/${_tag}/gost_${pkgver}_linux_amd64.tar.gz")
