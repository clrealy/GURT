sha256sums_aarch64=(d03699e3f385d4ff5dad68046712adfcc7515325a064d2ab046e0bece30f8f8f)

package() {
  local f
  f=$(find . -type f -name gost -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name gost | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/gost"
}
