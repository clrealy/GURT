# Traceroute and ping combined in a nice terminal UI (run trip)
pkgname=trippy
pkgver=0.13.0
pkgrel=1
pkgdesc="Traceroute and ping combined in a nice terminal UI (run trip)"
url="https://github.com/fujiapple852/trippy"
license="Apache-2.0"
maintainer="clrealy"
category="internet"
arch=(x86_64 aarch64)
aliases=(trip)
# official prebuilt release binary
source_x86_64=("https://github.com/fujiapple852/trippy/releases/download/${pkgver}/trippy-${pkgver}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/fujiapple852/trippy/releases/download/${pkgver}/trippy-${pkgver}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=(aa2b7b2a0773f3cc04da691100419049950b690fe3736d25e24ac955b63d6056)
sha256sums_aarch64=(73af939aa94e9e0f07cac2b3c8177e02a6b1c3be88299d85988e02be81ae7004)

package() {
  local f
  f=$(find . -type f -name trip -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name trip | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/trip"
}
