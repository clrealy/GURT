# Build and bundle Rust WebAssembly web apps
pkgname=trunk
pkgver=0.21.14
pkgrel=1
pkgdesc="Build and bundle Rust WebAssembly web apps"
url="https://github.com/trunk-rs/trunk"
license="MIT OR Apache-2.0"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/trunk-rs/trunk/releases/download/${_tag}/trunk-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/trunk-rs/trunk/releases/download/${_tag}/trunk-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=(a67f4054b249fe9acc5fabc25de1aebf19783aca3ad6ff64bf34d7da44d0ea20)
sha256sums_aarch64=(e8e2a2bb423ce6702ab9f4f02f8c9ae99d790f0301f7634e986b2dd8706019cc)

package() {
  local f
  f=$(find . -type f -name trunk -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name trunk | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/trunk"
}
