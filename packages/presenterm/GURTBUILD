package() {
  local f
  f=$(find . -type f -name presenterm -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name presenterm | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/presenterm"
