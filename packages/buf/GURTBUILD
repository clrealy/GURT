pkgdesc="Better tooling for Protocol Buffers"
url="https://github.com/bufbuild/buf"
license="Apache-2.0"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/bufbuild/buf/releases/download/${_tag}/buf-Linux-x86_64.tar.gz")
source_aarch64=("https://github.com/bufbuild/buf/releases/download/${_tag}/buf-Linux-aarch64.tar.gz")
sha256sums_x86_64=('cc482285b2c388c93f8bed0a972330695c1c8dd121d5ece460d25ceed93f21ac')
sha256sums_aarch64=('54a5d5500992deb3239bfee61c9f0ef7646b6f6b231d2c255fdfc16eeb50564c')

package() {
  local f
  f=$(find . -type f -name buf -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name buf | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/buf"
}
