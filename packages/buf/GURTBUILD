url="https://github.com/bufbuild/buf"
license="Apache-2.0"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/bufbuild/buf/releases/download/${_tag}/buf-Linux-x86_64.tar.gz")
source_aarch64=("https://github.com/bufbuild/buf/releases/download/${_tag}/buf-Linux-aarch64.tar.gz")
