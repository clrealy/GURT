# opsex
# holy opsec
pkgname=opsec
pkgver=balls
pkgrel=1
pkgdesc="Geektyper + NordVPN = HOLY OPSEC"
url="https://geektyper.com"
license="MIT"
maintainer="clrealy"
arch=(any)
depends=(xdg-utils)
makedepends=()
source=()
sha256sums=()

package() {
  install -d "$pkgdir$prefix/bin" "$pkgdir$prefix/share/applications"

  cat > "$pkgdir$prefix/bin/opsec" <<'SCRIPT'
#!/bin/sh
# Opsec.exe — opens GeekTyper in its own app window
URL="https://geektyper.com/"
for b in chromium chromium-browser google-chrome-stable google-chrome brave brave-browser microsoft-edge-stable vivaldi-stable; do
  command -v "$b" >/dev/null 2>&1 && exec "$b" --app="$URL" "$@"
done
command -v firefox >/dev/null 2>&1 && exec firefox --new-window "$URL"
exec xdg-open "$URL"
SCRIPT
  chmod 755 "$pkgdir$prefix/bin/opsec"

  cat > "$pkgdir$prefix/share/applications/opsec.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Opsec.exe
Comment=Look like a movie hacker
Exec=opsec
Icon=utilities-terminal
Terminal=false
Categories=Game;Amusement;
Keywords=hacker;opsec;geektyper;
DESKTOP
}
