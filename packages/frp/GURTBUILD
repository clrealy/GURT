# Expose local servers behind NAT to the internet
pkgname=frp
pkgver=0.71.0
pkgrel=1
pkgdesc="Expose local servers behind NAT to the internet"
url="https://github.com/fatedier/frp"
license="Apache-2.0"
maintainer="clrealy"
category="internet"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binaries
source_x86_64=("https://github.com/fatedier/frp/releases/download/${_tag}/frp_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/fatedier/frp/releases/download/${_tag}/frp_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=(84f27e39f11169f7adcef8e8b70c9329de17747b1f14dad9fb95eef5682ea716)
sha256sums_aarch64=(f33c293c275d8fc68c654b6fba8f10b2551d6463d09a9fc9cffb7227eae82266)

package() {
  local f
  f=$(find . -type f -name frpc -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name frpc | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/frpc"
  f=$(find . -type f -name frps -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name frps | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/frps"
}
