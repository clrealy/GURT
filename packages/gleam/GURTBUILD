# Friendly, type-safe language for the Erlang VM
pkgname=gleam
pkgver=1.18.1
pkgrel=1
pkgdesc="Friendly, type-safe language for the Erlang VM"
url="https://github.com/gleam-lang/gleam"
license="Apache-2.0"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/gleam-lang/gleam/releases/download/${_tag}/gleam-${_tag}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/gleam-lang/gleam/releases/download/${_tag}/gleam-${_tag}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=(4955a38c2e8c99457458e2471472ccd5ee3c45bd7637a315ce33bccf0dd75d9e)
sha256sums_aarch64=(ea08a64846677f36da7f2e9163c4393dd9a9dee814d13a8fb28fbe7dcbf32f6d)

package() {
  local f
  f=$(find . -type f -name gleam -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name gleam | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/gleam"
}
