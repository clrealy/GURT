# List every package inside a container image or folder
pkgname=syft
pkgver=1.54.0
pkgrel=1
pkgdesc="List every package inside a container image or folder"
url="https://github.com/anchore/syft"
license="Apache-2.0"
maintainer="clrealy"
category="security"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/anchore/syft/releases/download/${_tag}/syft_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/anchore/syft/releases/download/${_tag}/syft_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=(54a87372498168b2d033e876fd41fa4e8035b872699e525a57046e1f2f09c860)
sha256sums_aarch64=(ee6d4566373a05b344bc6b5f1706f14419bf9338ba39ff686e247deefe9b8818)

package() {
  local f
  f=$(find . -type f -name syft -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name syft | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/syft"
}
