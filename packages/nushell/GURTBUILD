# A new kind of shell where everything is structured data (run nu)
pkgname=nushell
pkgver=0.116.0
pkgrel=1
pkgdesc="A new kind of shell where everything is structured data (run nu)"
url="https://github.com/nushell/nushell"
license="MIT"
maintainer="clrealy"
category="cli"
arch=(x86_64 aarch64)
aliases=(nu)
# official prebuilt release binary
source_x86_64=("https://github.com/nushell/nushell/releases/download/${pkgver}/nu-${pkgver}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/nushell/nushell/releases/download/${pkgver}/nu-${pkgver}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=(7b91aeef575080f4b90405ba4512f4ccd0c21a6fbcd99f18bde3272c75213f00)
sha256sums_aarch64=(bc3503d0588caa7c2835d61337825152141c748c126817739cb86519c593416e)

package() {
  local f
  f=$(find . -type f -name nu -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name nu | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/nu"
}
