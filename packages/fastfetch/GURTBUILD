pkgname=fastfetch
pkgver=2.69.0
pkgrel=2
pkgdesc="Like neofetch, but much faster because written mostly in C"
url="https://github.com/fastfetch-cli/fastfetch"
license="MIT"
maintainer="clrealy"
arch=(x86_64 aarch64 armv7l riscv64)
depends=()
makedepends=(cc cmake git)
source=("git+https://github.com/fastfetch-cli/fastfetch.git#tag=$pkgver")
sha256sums=(SKIP)

build() {
  cmake -S fastfetch -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$prefix" \
    -DBUILD_TESTS=OFF \
    -DENABLE_VULKAN=OFF
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
