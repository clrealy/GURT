package() {
  local f
  f=$(find . -type f -name dockle -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name dockle | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/dockle"
}
