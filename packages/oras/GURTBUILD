# Push and pull any files to container registries
pkgname=oras
pkgver=1.3.4
pkgrel=1
pkgdesc="Push and pull any files to container registries"
url="https://github.com/oras-project/oras"
license="Apache-2.0"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/oras-project/oras/releases/download/${_tag}/oras_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/oras-project/oras/releases/download/${_tag}/oras_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=(f27adb935022d94df8dc77719c322dda592c78a0d57a6f7dcdd8d900b248c454)
sha256sums_aarch64=(15702c6e3a4a56a8bd8ac5c17efdbcab56d9bada661ccbcf017f5b10c1d89399)

package() {
  local f
  f=$(find . -type f -name oras -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name oras | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/oras"
}
