# Fast multi-purpose DNS toolkit
pkgname=dnsx
pkgver=1.3.1
pkgrel=1
pkgdesc="Fast multi-purpose DNS toolkit"
url="https://github.com/projectdiscovery/dnsx"
license="MIT"
maintainer="clrealy"
category="security"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/projectdiscovery/dnsx/releases/download/${_tag}/dnsx_${pkgver}_linux_amd64.zip")
source_aarch64=("https://github.com/projectdiscovery/dnsx/releases/download/${_tag}/dnsx_${pkgver}_linux_arm64.zip")
sha256sums_x86_64=(438b964653056dd51dcfe614b1a16f8bced3cc48a1d27bc07cc6fdf2ef2a9533)
sha256sums_aarch64=(dd657dd1ccee5e137eca2dbad0e97dbd067555f744adb97efcda774f1b2fbde1)

package() {
  local f
  f=$(find . -type f -name dnsx -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name dnsx | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/dnsx"
}
