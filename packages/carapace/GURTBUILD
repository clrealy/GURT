pkgname=carapace
pkgver=1.8.0
pkgrel=1
pkgdesc="Tab completions for hundreds of commands in any shell"
url="https://github.com/carapace-sh/carapace-bin"
license="MIT"
maintainer="clrealy"
category="cli"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/carapace-sh/carapace-bin/releases/download/${_tag}/carapace-bin_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/carapace-sh/carapace-bin/releases/download/${_tag}/carapace-bin_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=(6883bb61fe88a8f56c7b74bc9ff68445791ee22697f705b59a063443d8ffc8ad)
sha256sums_aarch64=(d501dfb17f3d1fe32d71e2a3704ef92572fc407f90fa9684d07c64f50d9d2fe4)

package() {
  local f
  f=$(find . -type f -name carapace -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name carapace | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/carapace"
}
