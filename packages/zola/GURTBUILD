# Fast static site generator in a single binary
pkgname=zola
pkgver=0.23.6
pkgrel=1
pkgdesc="Fast static site generator in a single binary"
url="https://github.com/getzola/zola"
license="MIT"
maintainer="clrealy"
category="dev"
arch=(x86_64)
_tag=v$pkgver
# official prebuilt release binary
source=("https://github.com/getzola/zola/releases/download/${_tag}/zola-${_tag}-x86_64-unknown-linux-musl.tar.gz")
sha256sums=(7d77a4220a4f699cba2fc0e0c7859f780e887e269159ad4fab90e11ea16c906f)

package() {
  local f
  f=$(find . -type f -name zola -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name zola | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/zola"
}
