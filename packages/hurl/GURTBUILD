# Run and test HTTP requests written in plain text
pkgname=hurl
pkgver=8.0.1
pkgrel=1
pkgdesc="Run and test HTTP requests written in plain text"
url="https://github.com/Orange-OpenSource/hurl"
license="Apache-2.0"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
aliases=(hurlfmt)
# official prebuilt release binaries
source_x86_64=("https://github.com/Orange-OpenSource/hurl/releases/download/${pkgver}/hurl-${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("https://github.com/Orange-OpenSource/hurl/releases/download/${pkgver}/hurl-${pkgver}-aarch64-unknown-linux-gnu.tar.gz")
sha256sums_x86_64=(cac7c4670d69444db120edb21fe06c97ba8c80dcc52279957c8dd18f05fb0c06)
sha256sums_aarch64=(bc4732df4754748e9bf296aa3832ec019f798afb399f1279b72ed37b6e04525c)

package() {
  local f
  f=$(find . -type f -name hurl -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name hurl | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/hurl"
  f=$(find . -type f -name hurlfmt -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name hurlfmt | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/hurlfmt"
}
