package() {
  local f
  f=$(find . -type f -name kubens -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name kubens | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/kubens"
}
