# GitHub's official command line tool: PRs, issues, repos and more
pkgname=gh
pkgver=2.102.0
pkgrel=1
pkgdesc="GitHub's official command line tool: PRs, issues, repos and more"
url="https://github.com/cli/cli"
license="MIT"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
aliases=(github-cli)
makedepends=(go git)
source=("cli::git+https://github.com/cli/cli.git#tag=v$pkgver")
sha256sums=(SKIP)

build() {
  cd cli
  # your distro's Go too old for this release? Go fetches the right toolchain itself
  export GOTOOLCHAIN=auto CGO_ENABLED=0 GOFLAGS="-trimpath -mod=readonly -buildvcs=false"
  go build -ldflags "-s -w -X github.com/cli/cli/v2/internal/build.Version=$pkgver" -o out/gh ./cmd/gh
}

package() {
  install -Dm755 cli/out/gh "$pkgdir$prefix/bin/gh"
}
