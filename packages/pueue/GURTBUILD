sha256sums_aarch64=(759bf5100a51024997111c6913aaf3330a0cdfd893ff552dcf429ae9b5e01e09 332c5ef74270b64aeaf04894c8c04826f3422eb7d50dbd1a8e0706d74a42f653)

package() {
  install -Dm755 pueue "$pkgdir$prefix/bin/pueue"
