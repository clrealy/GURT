# Fast terminal file manager inspired by ranger
pkgname=lf
pkgver=42
pkgrel=1
pkgdesc="Fast terminal file manager inspired by ranger"
url="https://github.com/gokcehan/lf"
license="MIT"
maintainer="clrealy"
category="cli"
arch=(x86_64 aarch64)
makedepends=(go git)
source=("lf::git+https://github.com/gokcehan/lf.git#tag=r$pkgver")
sha256sums=(SKIP)

build() {
  cd lf
  # your distro's Go too old for this release? Go fetches the right toolchain itself
  export GOTOOLCHAIN=auto CGO_ENABLED=0 GOFLAGS="-trimpath -mod=readonly -buildvcs=false"
  go build -ldflags "-s -w -X main.gVersion=r$pkgver" -o out/lf .
}

package() {
  install -Dm755 lf/out/lf "$pkgdir$prefix/bin/lf"
}
