# Valve's game store and launcher
# installs the Flathub build. gurt sets up flatpak + Flathub for you if needed (just for your user, no root needed)
pkgname=steam
pkgver=flathub
pkgrel=1
pkgdesc="Valve's game store and launcher"
url="https://flathub.org/apps/com.valvesoftware.Steam"
license="Proprietary"
maintainer="clrealy"
category="gaming"
arch=(x86_64)

via_repo=flathub
via_type=flatpak
via_pkg=com.valvesoftware.Steam
# your distro's own Steam when it has one (Ubuntu multiverse, Arch multilib, RPM Fusion, openSUSE non-oss)
native_apt=steam-installer
native_pacman=steam
native_dnf=steam
native_zypper=steam
