# Make changelogs from your git history
pkgname=git-cliff
pkgver=2.14.2
pkgrel=1
pkgdesc="Make changelogs from your git history"
url="https://github.com/orhun/git-cliff"
license="MIT OR Apache-2.0"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/orhun/git-cliff/releases/download/${_tag}/git-cliff-${pkgver}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/orhun/git-cliff/releases/download/${_tag}/git-cliff-${pkgver}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=(fa21e2fc70046fcfd0e43e5e4613873ab799aff3d9dc8559c00d31b270e417d0)
sha256sums_aarch64=(4be21b21ec9699af4d330b224aeba8a41d41d8f5b351ca2da8a9ea2bdc36380f)

package() {
  local f
  f=$(find . -type f -name git-cliff -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name git-cliff | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/git-cliff"
}
