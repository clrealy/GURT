# Security scanner for containers, code and configs
pkgname=trivy
pkgver=0.75.0
pkgrel=1
pkgdesc="Security scanner for containers, code and configs"
url="https://github.com/aquasecurity/trivy"
license="Apache-2.0"
maintainer="clrealy"
category="security"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/aquasecurity/trivy/releases/download/${_tag}/trivy_${pkgver}_Linux-64bit.tar.gz")
source_aarch64=("https://github.com/aquasecurity/trivy/releases/download/${_tag}/trivy_${pkgver}_Linux-ARM64.tar.gz")
sha256sums_x86_64=(c6e65abddb348e25f10549df887045629cf28cc72453cd1c63acb717316b3f3f)
sha256sums_aarch64=(a1ee9f6ffb7d112b64ff726a2a0717c21175c1114361391f4a132956751a13b3)

package() {
  local f
  f=$(find . -type f -name trivy -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name trivy | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/trivy"
}
