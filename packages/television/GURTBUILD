# Fuzzy finder for files, text, git and more (run tv)
pkgname=television
pkgver=0.15.9
pkgrel=1
pkgdesc="Fuzzy finder for files, text, git and more (run tv)"
url="https://github.com/alexpasmantier/television"
license="MIT"
maintainer="clrealy"
category="cli"
arch=(x86_64)
aliases=(tv)
# official prebuilt release binary
source=("https://github.com/alexpasmantier/television/releases/download/${pkgver}/tv-${pkgver}-x86_64-unknown-linux-musl.tar.gz")
sha256sums=(3410e34132f4e44fd439c711f08c15b3a21f51630657cb03f248b2c7aef3e29a)

package() {
  local f
  f=$(find . -type f -name tv -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name tv | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/tv"
}
