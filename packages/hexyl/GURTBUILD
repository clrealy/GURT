# Colorful hex viewer for the terminal
pkgname=hexyl
pkgver=0.17.0
pkgrel=1
pkgdesc="Colorful hex viewer for the terminal"
url="https://github.com/sharkdp/hexyl"
license="MIT OR Apache-2.0"
maintainer="clrealy"
category="dev"
arch=(x86_64)
_tag=v$pkgver
# official prebuilt release binary
source=("https://github.com/sharkdp/hexyl/releases/download/${_tag}/hexyl-${_tag}-x86_64-unknown-linux-musl.tar.gz")
sha256sums=(82b374b800cc965f4116b9d5d6a50394945170d4f65b9ef6ced3b82b014de8a6)

package() {
  local f
  f=$(find . -type f -name hexyl -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name hexyl | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/hexyl"
}
