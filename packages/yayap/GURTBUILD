# YaYaP — Yet Another "Yet Another" Program
pkgname=yayap
pkgver=0.2.0
pkgrel=1
pkgdesc="Yet Another \"Yet Another\" Program — a YaST-style control center for any distro: services, users, firewall, packages & more 🧰"
url="https://github.com/clrealy/YaYaP"
license="MIT"
maintainer="clrealy"
category="system"
arch=(any)
makedepends=(git)
source=("yayap::git+https://github.com/clrealy/YaYaP.git#commit=4b75c55b33364734a52ae82d2fcdace184139961")
sha256sums=(SKIP)

check() {
  cd yayap
  tests/run.sh
}

package() {
  cd yayap
  DESTDIR="$pkgdir" PREFIX="$prefix" ./install.sh
  install -Dm644 LICENSE "$pkgdir$prefix/share/licenses/yayap/LICENSE"
}
