# YaYaP (Yet Another "Yet Another" Program): a YaST-style control center
pkgname=yayap
pkgver=0.3.0
pkgrel=1
pkgdesc="YaST-style control center for any distro, with a desktop app and a terminal UI: services, users, firewall, packages and more 🧰"
url="https://github.com/clrealy/YaYaP"
license="MIT"
maintainer="clrealy"
category="system"
arch=(any)
depends=(python3)            # for `yayap gui`
makedepends=(git)
source=("yayap::git+https://github.com/clrealy/YaYaP.git#commit=ddc75e5e392103ed4f7a4177fcf4e06e8f8e1f38")
sha256sums=(SKIP)

check() {
  cd yayap
  tests/run.sh
}

package() {
  cd yayap
  DESTDIR="$pkgdir" PREFIX="$prefix" ./install.sh
  install -Dm644 LICENSE "$pkgdir$prefix/share/licenses/yayap/LICENSE"
}
