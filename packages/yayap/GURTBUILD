# YaYaP — Yet Another "Yet Another" Program
pkgname=yayap
pkgver=0.1.0
pkgrel=1
pkgdesc="Yet Another \"Yet Another\" Program — a Linux toolbox: sysinfo, pkg, ports, extract, backup, clean & more 🧰"
url="https://github.com/clrealy/YaYaP"
license="MIT"
maintainer="clrealy"
category="cli"
arch=(any)
makedepends=(git)
source=("yayap::git+https://github.com/clrealy/YaYaP.git#commit=be59b5965bdd5a96c12daf6bd62e74050da228fb")
sha256sums=(SKIP)

check() {
  cd yayap
  tests/run.sh
}

package() {
  cd yayap
  DESTDIR="$pkgdir" PREFIX="$prefix" ./install.sh
  install -Dm644 LICENSE "$pkgdir$prefix/share/licenses/yayap/LICENSE"
}
