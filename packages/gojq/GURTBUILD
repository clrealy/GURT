# jq written in Go, with nicer error messages
pkgname=gojq
pkgver=0.12.19
pkgrel=1
pkgdesc="jq written in Go, with nicer error messages"
url="https://github.com/itchyny/gojq"
license="MIT"
maintainer="clrealy"
category="cli"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/itchyny/gojq/releases/download/${_tag}/gojq_${_tag}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/itchyny/gojq/releases/download/${_tag}/gojq_${_tag}_linux_arm64.tar.gz")
sha256sums_x86_64=(bdfaf9acbe088973c549dadbf299c06dc9a84f1ca38c731ca04a08a901077f64)
sha256sums_aarch64=(b22794b4bebad11c42af52550bda317c5cd7ee79aaa729eb6ec91a63f623d8b5)

package() {
  local f
  f=$(find . -type f -name gojq -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name gojq | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/gojq"
}
