package() {
  local f
  f=$(find . -type f -name actionlint -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name actionlint | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/actionlint"
}
