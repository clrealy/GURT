# Personal key-value store for your terminal
pkgname=skate
pkgver=1.1.0
pkgrel=1
pkgdesc="Personal key-value store for your terminal"
url="https://github.com/charmbracelet/skate"
license="MIT"
maintainer="clrealy"
category="cli"
arch=(x86_64)
_tag=v$pkgver
# official prebuilt release binary
source=("https://github.com/charmbracelet/skate/releases/download/${_tag}/skate_${pkgver}_Linux_x86_64.tar.gz")
sha256sums=(7bfb03f62dcb1c76a7dec55403b897a5b176da78bb9dfc783e678f03d0aae8ca)

package() {
  local f
  f=$(find . -type f -name skate -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name skate | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/skate"
}
