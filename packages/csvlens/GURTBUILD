# View CSV files in the terminal, like less but for spreadsheets
pkgname=csvlens
pkgver=0.15.1
pkgrel=1
pkgdesc="View CSV files in the terminal, like less but for spreadsheets"
url="https://github.com/YS-L/csvlens"
license="MIT"
maintainer="clrealy"
category="cli"
arch=(x86_64)
_tag=v$pkgver
# official prebuilt release binary
source=("https://github.com/YS-L/csvlens/releases/download/${_tag}/csvlens-x86_64-unknown-linux-musl.tar.xz")
sha256sums=(ab086b420e453618fd1544eb4e09cc98279e8570b739725592feb241cd1bef4b)

package() {
  local f
  f=$(find . -type f -name csvlens -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name csvlens | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/csvlens"
}
