sha256sums_x86_64=('a248ae2b2b62b5baebb748f6fba7203bff1a27e5d01b55399a8406744cb539e8')
sha256sums_aarch64=('b2bcc040c213b44586b121bda6d983c35df121b917c3a7a66fb16f2fa0df1a4f')

package() {
  install -Dm755 bazelisk "$pkgdir$prefix/bin/bazelisk"
}
