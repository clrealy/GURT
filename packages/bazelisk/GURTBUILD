sha256sums_x86_64=('37c6c243a5a0d2cb6a16a74012c108c47ae9eb5c0455251881e66e7f393a4ce1')
sha256sums_aarch64=('202bd85dfd6b427187ffa0cf4892dbae7796ddd37a66f69c75519260492c4aaf')

package() {
  install -Dm755 bazelisk "$pkgdir$prefix/bin/bazelisk"
}
