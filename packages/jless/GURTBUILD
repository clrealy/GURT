# Browse JSON in the terminal with folding and search
pkgname=jless
pkgver=0.9.0
pkgrel=1
pkgdesc="Browse JSON in the terminal with folding and search"
url="https://github.com/PaulJuliusMartinez/jless"
license="MIT"
maintainer="clrealy"
category="cli"
arch=(x86_64)
_tag=v$pkgver
# official prebuilt release binary
source=("https://github.com/PaulJuliusMartinez/jless/releases/download/${_tag}/jless-${_tag}-x86_64-unknown-linux-gnu.zip")
sha256sums=(a1e0eb63ef347adc649989ac5c7d2dc896df6d494622b953c86e3a248e733a93)

package() {
  local f
  f=$(find . -type f -name jless -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name jless | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/jless"
}
