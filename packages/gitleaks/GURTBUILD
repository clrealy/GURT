# Find passwords and API keys accidentally committed to git
pkgname=gitleaks
pkgver=8.30.1
pkgrel=1
pkgdesc="Find passwords and API keys accidentally committed to git"
url="https://github.com/gitleaks/gitleaks"
license="MIT"
maintainer="clrealy"
category="security"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/gitleaks/gitleaks/releases/download/${_tag}/gitleaks_${pkgver}_linux_x64.tar.gz")
source_aarch64=("https://github.com/gitleaks/gitleaks/releases/download/${_tag}/gitleaks_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=(551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb)
sha256sums_aarch64=(e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080)

package() {
  local f
  f=$(find . -type f -name gitleaks -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name gitleaks | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/gitleaks"
}
