package() {
  local f
  f=$(find . -type f -name kubectx -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name kubectx | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/kubectx"
}
