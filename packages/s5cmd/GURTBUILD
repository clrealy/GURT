package() {
  local f
  f=$(find . -type f -name s5cmd -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name s5cmd | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/s5cmd"
}
