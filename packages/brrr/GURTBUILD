# Printing on Linux without CUPS or drivers
pkgname=brrr
pkgver=0.2.1
pkgrel=2
pkgdesc="Printing on Linux without CUPS or drivers: find the printer and print"
url="https://github.com/clrealy/brrr"
license="MIT"
maintainer="clrealy"
category="system"
icon="https://raw.githubusercontent.com/clrealy/brrr/main/assets/logo.png"
arch=(x86_64 aarch64)
aliases=(printer printez)
depends=(poppler)
makedepends=(rust git cc)
source=("git+https://github.com/clrealy/brrr.git#commit=63337440f420de80ad87be1c233a72e1e3f8befb")
sha256sums=(SKIP)

build() {
  cd brrr
  cargo build --release --locked
}

check() {
  cd brrr
  cargo test --release --locked
}

package() {
  cd brrr
  install -Dm755 target/release/brrr "$pkgdir$prefix/bin/brrr"
  install -Dm644 LICENSE "$pkgdir$prefix/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir$prefix/share/doc/$pkgname/README.md"
}
