# GitOps for Kubernetes: keep your cluster in sync with git
pkgname=flux
pkgver=2.9.6
pkgrel=1
pkgdesc="GitOps for Kubernetes: keep your cluster in sync with git"
url="https://github.com/fluxcd/flux2"
license="Apache-2.0"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/fluxcd/flux2/releases/download/${_tag}/flux_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/fluxcd/flux2/releases/download/${_tag}/flux_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=(b4d22673e9246cbd628881f1a9ef3b090085dced291e42d804555cee8e8d42c5)
sha256sums_aarch64=(6663c154755b732f43dc993d72321f71c2fc1ff0bcb94b2696e0a8638fa562b4)

package() {
  local f
  f=$(find . -type f -name flux -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name flux | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/flux"
}
