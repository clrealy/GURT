# Geode Patcher: one-click GUI to install the Geode mod loader into Geometry Dash on Linux
# finds Steam/Flatpak/Snap installs, grabs Geode from GitHub, uninstall + launch option copy included
pkgname=geode-patcher
pkgver=1.0.0
pkgrel=1
pkgdesc="GUI-Patch Geometry Dash with the Geode mod loader on Linux"
aliases=(geode gd-geode geode-gd)
url="https://github.com/clrealy/GURT"
license="MIT"
maintainer="clrealy"
category="gaming"
arch=(any)
depends=(python3 python3-tk)
makedepends=()
source=("geode-patcher.py" "geode-patcher.png")
sha256sums=("7e775b4b227cc1a9ce0207219890fbaa9eb79454adc4b77b07b2251df88e4d5a"
            "072bcaf7239c101b919ad6008713fdb315df455b97bf3e419adb7e801e52ebd1")

package() {
  install -Dm755 "$srcdir/geode-patcher.py" "$pkgdir$prefix/bin/geode-patcher"
  install -Dm644 "$srcdir/geode-patcher.png" "$pkgdir$prefix/share/pixmaps/geode-patcher.png"
  # absolute paths: launchers don't read your shell PATH. StartupWMClass matches the window so the icon sticks
  printf '[Desktop Entry]\nType=Application\nName=Geode Patcher\nComment=%s\nExec=%s/bin/geode-patcher\nIcon=%s/share/pixmaps/geode-patcher.png\nTerminal=false\nCategories=Game;Utility;\nKeywords=geode;geometry;dash;gd;mods;\nStartupWMClass=Geode-patcher\n' \
    "$pkgdesc" "$prefix" "$prefix" > geode-patcher.desktop
  install -Dm644 geode-patcher.desktop "$pkgdir$prefix/share/applications/geode-patcher.desktop"
}
