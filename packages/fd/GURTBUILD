# Find files fast, with way friendlier syntax than find
pkgname=fd
pkgver=10.5.0
pkgrel=1
pkgdesc="Find files fast, with way friendlier syntax than find"
url="https://github.com/sharkdp/fd"
license="MIT OR Apache-2.0"
maintainer="clrealy"
category="cli"
arch=(x86_64 aarch64)
aliases=(fd-find)
_tag=v$pkgver
# official prebuilt release binaries
source_x86_64=("https://github.com/sharkdp/fd/releases/download/$_tag/fd-$_tag-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/sharkdp/fd/releases/download/$_tag/fd-$_tag-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=(761c72dc8e120d85b22292063be8a796e2eeb20eb3e4f38b8fa2343ccf3514a7)
sha256sums_aarch64=(d76c4317f7d5dba69f8a2a15856c90c777e7f0dd4e85f0de8c76de6992c374d4)

package() {
  install -Dm755 "$(find . -type f -name fd -perm -u+x | head -n1)" "$pkgdir$prefix/bin/fd"
}
