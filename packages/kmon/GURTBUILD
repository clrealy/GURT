# Manage Linux kernel modules from a terminal UI
pkgname=kmon
pkgver=1.7.1
pkgrel=1
pkgdesc="Manage Linux kernel modules from a terminal UI"
url="https://github.com/orhun/kmon"
license="GPL-3.0"
maintainer="clrealy"
category="system"
arch=(x86_64)
_tag=v$pkgver
# official prebuilt release binary
source=("https://github.com/orhun/kmon/releases/download/${_tag}/kmon-${pkgver}-x86_64-unknown-linux-musl.tar.gz")
sha256sums=(2d8ba69d000f5f5a01ba9cb6d135aec5b323478f0dcb7f670766314ad306d565)

package() {
  local f
  f=$(find . -type f -name kmon -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name kmon | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/kmon"
}
