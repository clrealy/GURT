# Reverse proxy that configures itself from Docker and Kubernetes
pkgname=traefik
pkgver=3.7.13
pkgrel=1
pkgdesc="Reverse proxy that configures itself from Docker and Kubernetes"
url="https://github.com/traefik/traefik"
license="MIT"
maintainer="clrealy"
category="internet"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/traefik/traefik/releases/download/${_tag}/traefik_${_tag}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/traefik/traefik/releases/download/${_tag}/traefik_${_tag}_linux_arm64.tar.gz")
sha256sums_x86_64=(52cd039a34258dd61c617a95d69252bc6bcae27c520f338186c31c7fef8f6394)
sha256sums_aarch64=(9155048abd64c59000d2f3c07dc6d6919bc6be9b618e6a554bc3808338aaf8b8)

package() {
  local f
  f=$(find . -type f -name traefik -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name traefik | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/traefik"
}
