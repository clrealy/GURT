package() {
  local f
  f=$(find . -type f -name kubecolor -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name kubecolor | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/kubecolor"
}
