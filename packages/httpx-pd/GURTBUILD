package() {
  local f
  f=$(find . -type f -name httpx -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name httpx | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/httpx"
}
