# Fast web fuzzer
pkgname=ffuf
pkgver=2.3.0
pkgrel=1
pkgdesc="Fast web fuzzer"
url="https://github.com/ffuf/ffuf"
license="MIT"
maintainer="clrealy"
category="security"
arch=(x86_64 aarch64)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/ffuf/ffuf/releases/download/${_tag}/ffuf_${pkgver}_linux_amd64.tar.gz")
source_aarch64=("https://github.com/ffuf/ffuf/releases/download/${_tag}/ffuf_${pkgver}_linux_arm64.tar.gz")
sha256sums_x86_64=(b2a3c725fcb9da175159682f54d6e9149f2905b00d84d155e7efc5d599975ceb)
sha256sums_aarch64=(e2d712615d53da797ee929006e41f2df5a7960a5353133db9c150ddaa22ae4e8)

package() {
  local f
  f=$(find . -type f -name ffuf -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name ffuf | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/ffuf"
}
