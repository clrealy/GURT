# Flash OS images to USB drives and SD cards, safely
pkgname=balena-etcher
pkgver=2.1.8
pkgrel=1
pkgdesc="Flash OS images to USB drives and SD cards without wiping the wrong disk"
url="https://etcher.balena.io"
license="Apache-2.0"
maintainer="clrealy"
category="system"
arch=(x86_64)
aliases=(etcher balenaetcher)
# official prebuilt release (the Electron app, zipped)
source=("https://github.com/balena-io/etcher/releases/download/v$pkgver/balenaEtcher-linux-x64-$pkgver.zip")
sha256sums=('45b51cad0c8e1ebad3fde1d9c2e4c90c409d533b736b307d4b26f82fb3f05ce5')

package() {
  local dir="$prefix/lib/balena-etcher"
  mkdir -p "$pkgdir$dir" "$pkgdir$prefix/bin"
  cp -a balenaEtcher-linux-x64/. "$pkgdir$dir/"
  # chrome-sandbox would need to be setuid root, so run without it (like the AppImage does)
  printf '#!/bin/sh\nexec "%s/balena-etcher" --no-sandbox "$@"\n' "$dir" > balena-etcher
  install -Dm755 balena-etcher "$pkgdir$prefix/bin/balena-etcher"
  printf '[Desktop Entry]\nType=Application\nName=balenaEtcher\nGenericName=USB image writer\nComment=%s\nExec=%s/bin/balena-etcher %%U\nIcon=drive-removable-media\nTerminal=false\nCategories=System;Utility;\nKeywords=usb;iso;flash;sd;\n' \
    "$pkgdesc" "$prefix" > balena-etcher.desktop
  install -Dm644 balena-etcher.desktop "$pkgdir$prefix/share/applications/balena-etcher.desktop"
}
