# Conventional commits toolbox (run cog)
pkgname=cocogitto
pkgver=7.0.0
pkgrel=1
pkgdesc="Conventional commits toolbox (run cog)"
url="https://github.com/cocogitto/cocogitto"
license="MIT"
maintainer="clrealy"
category="dev"
arch=(x86_64)
aliases=(cog)
# official prebuilt release binary
source=("https://github.com/cocogitto/cocogitto/releases/download/${pkgver}/cocogitto-${pkgver}-x86_64-unknown-linux-musl.tar.gz")
sha256sums=(e03938ff2c4c86d71c00c0f3284dbbe95c5ca76fe34a51f33e945c23010d59bb)

package() {
  local f
  f=$(find . -type f -name cog -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name cog | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/cog"
}
