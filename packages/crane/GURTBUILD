# Work with container images and registries without Docker
pkgname=crane
pkgver=0.22.1
pkgrel=1
pkgdesc="Work with container images and registries without Docker"
url="https://github.com/google/go-containerregistry"
license="Apache-2.0"
maintainer="clrealy"
category="dev"
arch=(x86_64)
_tag=v$pkgver
# official prebuilt release binary
source=("https://github.com/google/go-containerregistry/releases/download/${_tag}/go-containerregistry_Linux_x86_64.tar.gz")
sha256sums=(0ab7a1d6932a213aed964ce97666c3077fe691c8606413674a8b3e0b9ec4cda0)

package() {
  local f
  f=$(find . -type f -name crane -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name crane | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/crane"
}
