# Shows info and stats about a git repo next to its logo
pkgname=onefetch
pkgver=3.0.0
pkgrel=1
pkgdesc="Shows info and stats about a git repo next to its logo"
url="https://github.com/o2sh/onefetch"
license="MIT"
maintainer="clrealy"
category="dev"
arch=(x86_64)
# official prebuilt release binary
source=("https://github.com/o2sh/onefetch/releases/download/${pkgver}/onefetch-linux.tar.gz")
sha256sums=('ae5bbdcb44201b17b75ab76f1cfca103972bf168f06897466385c09a05a9e954')

package() {
  local f
  f=$(find . -type f -name onefetch -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name onefetch | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/onefetch"
}
