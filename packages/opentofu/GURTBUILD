package() {
  local f
  f=$(find . -type f -name tofu -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name tofu | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/tofu"
}
