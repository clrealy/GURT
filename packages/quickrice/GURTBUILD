pkgname=quickrice
pkgver=0.3.0
pkgrel=1
pkgdesc="Load a whole desktop rice (GRUB, Plymouth, login screen, colors, sounds, terminal and more) from one .qrice file"
aliases=(qrice)
url="https://github.com/clrealy/GURT"
license="MIT"
maintainer="clrealy"
category="system"
arch=(any)
depends=(python3 python3-pyside6)
makedepends=()
source=("quickrice" "quickrice-gui" "quickrice.svg" "quickrice.desktop" "quickrice-mime.xml")
sha256sums=("a3e67bc524e5b8021c2e2381dee03199c74fdcf47adbf1752b66defe67e47cc1" "b7112b8344a1fe6f4f1cc9f41e8541c0f3e4c412f2a86afe662cae4e8f6b0c77" "5d71cf2efb706b72d5b36713916145f2ed65cd652bc41375b1af8efcd02d7a09" "33a4df672077b2cc41feb9530b1decffd7e4d15a6c16e320460383c0b462e8e7" "7746e53f3a9189c29c444303ecfd6f117a894e8fa43afe1dada15e1baefda498")

package() {
  install -Dm755 "$srcdir/quickrice"          "$pkgdir$prefix/bin/quickrice"
  install -Dm755 "$srcdir/quickrice-gui"      "$pkgdir$prefix/bin/quickrice-gui"
  install -Dm644 "$srcdir/quickrice.desktop"  "$pkgdir$prefix/share/applications/quickrice.desktop"
  install -Dm644 "$srcdir/quickrice-mime.xml" "$pkgdir$prefix/share/mime/packages/quickrice.xml"
  install -Dm644 "$srcdir/quickrice.svg"      "$pkgdir$prefix/share/icons/hicolor/scalable/apps/quickrice.svg"
}
