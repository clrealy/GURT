# Make a bootable USB once, then just copy ISO files onto it (Ventoy2Disk GUI included)
pkgname=ventoy
pkgver=1.1.17
pkgrel=2
pkgdesc="Make a bootable USB once, then just copy ISO files onto it and boot any of them"
url="https://www.ventoy.net"
license="GPL-3.0-or-later"
maintainer="clrealy"
category="system"
arch=(x86_64 aarch64 i686)
aliases=(ventoy2diskgui ventoygui ventoy2disk)
source=("https://github.com/ventoy/Ventoy/releases/download/v$pkgver/ventoy-$pkgver-linux.tar.gz")
sha256sums=(7fb4ed08cef6a6b4d39dd19260d8c80291a78dfdf9af7d461571e23cbbc43805)

package() {
  local dir="$prefix/lib/ventoy" gui
  mkdir -p "$pkgdir$dir"
  cp -a "ventoy-$pkgver/." "$pkgdir$dir/"
  case $CARCH in x86_64) gui=x86_64 ;; aarch64) gui=aarch64 ;; *) gui=i386 ;; esac
  # Ventoy needs root (it writes log.txt + unpacks its tools in its own folder, and it partitions USB sticks).
  # its GUI's own pkexec restart breaks in a root-owned folder and under SELinux ("Error executing … Permission
  # denied"), so gurt-ventoy gets root first (pkexec on itself, keeping your display), then starts Ventoy as root
  cat > gurt-ventoy <<LAUNCH
#!/bin/bash
# gurt-ventoy gui|cli|web [args] — runs Ventoy as root from $dir
if [[ \$(id -u) != 0 ]]; then
  if [[ \$1 == gui ]] && command -v pkexec >/dev/null && [[ -n \$DISPLAY\$WAYLAND_DISPLAY ]]; then
    keep=(); for v in DISPLAY WAYLAND_DISPLAY XAUTHORITY XDG_RUNTIME_DIR XDG_SESSION_TYPE XDG_CURRENT_DESKTOP LANG; do
      [[ -n \${!v:-} ]] && keep+=("\$v=\${!v}"); done
    [[ -z \${XAUTHORITY:-} && -f \$HOME/.Xauthority ]] && keep+=("XAUTHORITY=\$HOME/.Xauthority")
    exec pkexec env "\${keep[@]}" "\$0" "\$@"
  fi
  command -v pkexec >/dev/null && exec pkexec "\$0" "\$@"
  echo "Ventoy needs root — run it again as root" >&2; exit 1
fi
cd "$dir" || exit 1
case \$1 in
  gui) shift; exec ./VentoyGUI.$gui "\$@" ;;
  web) shift; exec bash ./VentoyWeb.sh "\$@" ;;
  *)   [[ \$1 == cli ]] && shift; exec bash ./Ventoy2Disk.sh "\$@" ;;
esac
LAUNCH
  install -Dm755 gurt-ventoy "$pkgdir$prefix/bin/gurt-ventoy"
  printf '#!/bin/sh\nexec "%s/bin/gurt-ventoy" gui "$@"\n' "$prefix" > ventoygui
  printf '#!/bin/sh\nexec "%s/bin/gurt-ventoy" cli "$@"\n' "$prefix" > ventoy
  printf '#!/bin/sh\nexec "%s/bin/gurt-ventoy" web "$@"\n' "$prefix" > ventoyweb
  for f in ventoygui ventoy ventoyweb; do install -Dm755 "$f" "$pkgdir$prefix/bin/$f"; done
  ln -s ventoygui "$pkgdir$prefix/bin/ventoy2diskgui"
  install -Dm644 "ventoy-$pkgver/WebUI/static/img/VentoyLogo.png" "$pkgdir$prefix/share/pixmaps/ventoy.png"
  printf '[Desktop Entry]\nType=Application\nName=Ventoy\nGenericName=Bootable USB maker\nComment=%s\nExec=%s/bin/ventoygui\nIcon=%s/share/pixmaps/ventoy.png\nTerminal=false\nCategories=System;Utility;\nKeywords=usb;iso;boot;ventoy2disk;\n' \
    "$pkgdesc" "$prefix" "$prefix" > ventoy.desktop
  install -Dm644 ventoy.desktop "$pkgdir$prefix/share/applications/ventoy.desktop"
}
