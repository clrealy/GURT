# GeekTyper launcher — opens geektyper.com in its own app window + adds a menu entry.
# (GeekTyper itself is a website by its own creators; this just launches it.)
pkgname=geektyper
pkgver=1.0.0
pkgrel=1
pkgdesc="Launcher for GeekTyper — mash your keyboard, look like a movie hacker 💻"
url="https://geektyper.com"
license="MIT"
maintainer="clrealy"
arch=(any)
depends=(xdg-utils)
makedepends=()
source=("geektyper.sh" "geektyper.desktop")
sha256sums=("3ed5c5885c666fae8093879a28f0db7382b69c1d5ddd1144d30b10614a520661"
            "a77cc1a7fa61d48b3aa710bb29dda6107de1a5e5ec2ead64998c4bc39602909d")

package() {
  install -Dm755 "$srcdir/geektyper.sh"      "$pkgdir$prefix/bin/geektyper"
  install -Dm644 "$srcdir/geektyper.desktop" "$pkgdir$prefix/share/applications/geektyper.desktop"
}
