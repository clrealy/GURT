pkgname=lychee
pkgver=0.15.1
pkgrel=1
pkgdesc="Find broken links in websites and Markdown"
url="https://github.com/lycheeverse/lychee"
license="MIT OR Apache-2.0"
maintainer="clrealy"
category="dev"
arch=(x86_64)
_tag=v$pkgver
# official prebuilt release binary
source=("https://github.com/lycheeverse/lychee/releases/download/${_tag}/lychee-${_tag}-x86_64-unknown-linux-musl.tar.gz")
sha256sums=(94a69befb2887374632945ba823561ac5e954dd803cd31094a5d33df3900581f)

package() {
  local f
  f=$(find . -type f -name lychee -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name lychee | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/lychee"
}
