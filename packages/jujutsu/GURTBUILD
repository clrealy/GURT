# Git-compatible version control that's easier to use (run jj)
pkgname=jujutsu
pkgver=0.45.1
pkgrel=1
pkgdesc="Git-compatible version control that's easier to use (run jj)"
url="https://github.com/jj-vcs/jj"
license="Apache-2.0"
maintainer="clrealy"
category="dev"
arch=(x86_64 aarch64)
aliases=(jj)
_tag=v$pkgver
# official prebuilt release binary
source_x86_64=("https://github.com/jj-vcs/jj/releases/download/${_tag}/jj-${_tag}-x86_64-unknown-linux-musl.tar.gz")
source_aarch64=("https://github.com/jj-vcs/jj/releases/download/${_tag}/jj-${_tag}-aarch64-unknown-linux-musl.tar.gz")
sha256sums_x86_64=(f35438350b5d61963aac5dd74ede510b31d6b9690769d1a6268cf058cc825f72)
sha256sums_aarch64=(7349a43dd5a20dbc998b10114daa0ee63d2ab863fb822c7eb6b0ebca5903cc69)

package() {
  local f
  f=$(find . -type f -name jj -perm -u+x | head -n1); [ -n "$f" ] || f=$(find . -type f -name jj | head -n1)
  install -Dm755 "$f" "$pkgdir$prefix/bin/jj"
}
