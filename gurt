#!/usr/bin/env bash
# ┌──────────────────────────────────────────────────────────────┐
# │ gurt — GURT Universal Repository Thingy                      │
# │ every distro's packages on every distro + the main GURT repo │
# │ made by clearly124 · MIT license                             │
# └──────────────────────────────────────────────────────────────┘
# recipes (GURTBUILD/PKGBUILD) set pkgname etc as arrays OR strings, that's on purpose:
# shellcheck disable=SC2128,SC2178,SC2034,SC2120
set -euo pipefail
shopt -s nullglob

GURT_VERSION="0.15.0"

# ───────────────────────── config ─────────────────────────
# load order: /etc/gurt.conf  →  ~/.config/gurt/gurt.conf  →  env vars win
_user_conf="${XDG_CONFIG_HOME:-$HOME/.config}/gurt/gurt.conf"
_envsave=$(declare -p GURT_REPO_URL GURT_BRANCH GURT_PREFIX GURT_ROOT GURT_CACHE \
  AUR_URL APT_MIRROR APT_SUITE APT_COMPONENTS DNF_MIRROR ZYPPER_MIRROR PACMAN_MIRROR PACMAN_REPOS 2>/dev/null || true)
# shellcheck disable=SC1090
[[ -r ${GURT_CONF:-/etc/gurt.conf} ]] && . "${GURT_CONF:-/etc/gurt.conf}"
# shellcheck disable=SC1090
[[ -r $_user_conf ]] && . "$_user_conf"
eval "$_envsave"

GURT_REPO_URL="${GURT_REPO_URL:-https://github.com/clrealy/GURT.git}"
GURT_BRANCH="${GURT_BRANCH:-main}"
GURT_PREFIX="${GURT_PREFIX:-/usr/local}"
GURT_ROOT="${GURT_ROOT:-/}"
GURT_CACHE="${GURT_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/gurt}"
GURT_REPO_DIR="${GURT_REPO_DIR:-$GURT_CACHE/repo}"

# ── foreign sources: other distros' repos, usable from ANY distro ──
AUR_URL="${AUR_URL:-https://aur.archlinux.org}"
APT_MIRROR="${APT_MIRROR:-https://deb.debian.org/debian}"
APT_SUITE="${APT_SUITE:-stable}"
APT_COMPONENTS="${APT_COMPONENTS:-main contrib}"
DNF_MIRROR="${DNF_MIRROR:-https://dl.fedoraproject.org/pub/fedora/linux/releases/44/Everything/\$arch/os}"
ZYPPER_MIRROR="${ZYPPER_MIRROR:-https://download.opensuse.org/tumbleweed/repo/oss}"
PACMAN_MIRROR="${PACMAN_MIRROR:-https://geo.mirror.pkgbuild.com}"
PACMAN_REPOS="${PACMAN_REPOS:-core extra}"
FOREIGN_SOURCES="aur apt dnf zypper pacman flatpak snap"
IDX_DIR="$GURT_CACHE/index"
IDX_MAX_AGE="${IDX_MAX_AGE:-86400}"   # re-download foreign indexes after a day

NOCONFIRM=false FORCE=false NODEPS=false NOCHECK=false KEEP=false ALLSRC=false REPO="" KEYSRC="" SUITE_OPT="" EXPECT_FPR="" BOX=false NOBOX=false SCAN=false NO_DESKTOP=false

# ───────────────────────── pretty output ─────────────────────────
if [[ -t 2 && -z ${NO_COLOR:-} ]]; then
  B=$'\e[1m' R0=$'\e[0m' RED=$'\e[31m' GRN=$'\e[32m' YLW=$'\e[33m' BLU=$'\e[34m' MAG=$'\e[35m'
else B='' R0='' RED='' GRN='' YLW='' BLU='' MAG=''; fi
msg()  { printf '%s==>%s %s%s%s\n' "$GRN" "$R0" "$B" "$*" "$R0" >&2; }
msg2() { printf '  %s->%s %s\n' "$BLU" "$R0" "$*" >&2; }
warn() { printf '%s==> heads up:%s %s\n' "$YLW" "$R0" "$*" >&2; }
die()  { printf '%s==> nah:%s %s\n' "$RED" "$R0" "$*" >&2; exit 1; }
ask()  {
  $NOCONFIRM && return 0
  local a; printf '%s::%s %s [y/N] ' "$MAG" "$R0" "$1" >&2
  { read -r a 2>/dev/null </dev/tty; } 2>/dev/null || read -r a || return 1
  [[ $a == [yY]* ]]
}

# ───────────────────────── paths ─────────────────────────
R="${GURT_ROOT%/}"                       # "" when root is /
DB="$R/var/lib/gurt/local"
SELF_DIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)

depmap_file() {
  local f
  for f in "$GURT_REPO_DIR/deps.map" "$SELF_DIR/deps.map" /usr/local/share/gurt/deps.map /usr/share/gurt/deps.map; do
    [[ -r $f ]] && { echo "$f"; return; }
  done
}

asroot() {
  if (( EUID == 0 )) || { [[ -n $R ]] && [[ -w $R ]]; }; then "$@"
  elif command -v sudo >/dev/null; then
    if [[ -n ${SUDO_ASKPASS:-} && -n ${GURT_GUI:-} ]]; then sudo -A "$@"; else sudo "$@"; fi
  elif command -v doas >/dev/null; then doas "$@"
  else die "need root for that (install sudo or doas)"; fi
}

# ───────────────────────── distro detection ─────────────────────────
detect_pm() {
  local id="" like=""
  if [[ -r /etc/os-release ]]; then
    id=$(. /etc/os-release; echo "${ID:-}"); like=$(. /etc/os-release; echo "${ID_LIKE:-}")
  fi
  local w
  for w in $id $like; do
    case $w in
      debian|ubuntu|linuxmint|pop|elementary|zorin|kali|raspbian|devuan) command -v apt-get >/dev/null && { echo apt; return; } ;;
      fedora|rhel|centos|rocky|almalinux|nobara) command -v dnf >/dev/null && { echo dnf; return; }
                                                 command -v yum >/dev/null && { echo yum; return; } ;;
      arch|manjaro|endeavouros|cachyos|garuda|artix) command -v pacman >/dev/null && { echo pacman; return; } ;;
      suse|opensuse|opensuse-tumbleweed|opensuse-leap|sles) command -v zypper >/dev/null && { echo zypper; return; } ;;
      alpine|postmarketos) command -v apk >/dev/null && { echo apk; return; } ;;
      void) command -v xbps-install >/dev/null && { echo xbps; return; } ;;
      gentoo|funtoo) command -v emerge >/dev/null && { echo emerge; return; } ;;
      solus) command -v eopkg >/dev/null && { echo eopkg; return; } ;;
    esac
  done
  # fallback: sniff for whatever package manager exists
  local pm
  for pm in apt-get dnf yum pacman zypper apk xbps-install emerge eopkg; do
    if command -v "$pm" >/dev/null; then
      case $pm in apt-get) echo apt ;; xbps-install) echo xbps ;; *) echo "$pm" ;; esac; return
    fi
  done
  echo none
}
PM=${GURT_PM:-$(detect_pm)}   # GURT_PM overrides detection (testing)

pm_has() {
  case $PM in
    apt)            dpkg-query -W -f='${Status}' "$1" 2>/dev/null | grep -q 'ok installed' ;;
    dnf|yum|zypper) rpm -q --whatprovides "$1" >/dev/null 2>&1 ;;
    pacman)         pacman -T "$1" >/dev/null 2>&1 || pacman -Qg "$1" >/dev/null 2>&1 ;;
    apk)            apk info -e "$1" >/dev/null 2>&1 ;;
    xbps)           xbps-query "$1" >/dev/null 2>&1 ;;
    emerge)         portageq has_version / "$1" >/dev/null 2>&1 ;;
    eopkg)          eopkg li 2>/dev/null | awk '{print $1}' | grep -qxF "$1" ;;
    *)              return 1 ;;
  esac
}

pm_install() {
  (( $# )) || return 0
  msg "installing distro deps via $PM: $*"
  case $PM in
    apt)    asroot apt-get install -y "$@" ;;
    dnf)    asroot dnf install -y "$@" ;;
    yum)    asroot yum install -y "$@" ;;
    # Arch doesn't support partial upgrades: installing something against a newer package list than the rest
    # of the system can break it (Qt/KDE/desktop). so deps come with a full upgrade, and pacman shows you it.
    pacman) if $NOCONFIRM; then asroot pacman -Syu --needed --noconfirm "$@"; else asroot pacman -Syu --needed "$@"; fi ;;
    zypper) asroot zypper --non-interactive install "$@" ;;
    apk)    asroot apk add "$@" ;;
    xbps)   asroot xbps-install -Sy "$@" ;;
    emerge) asroot emerge --noreplace "$@" ;;
    eopkg)  asroot eopkg install -y "$@" ;;
    *)      die "couldn't find a package manager I know. install these yourself then rerun with --nodeps: $*" ;;
  esac
}

# generic dep name -> native package name(s) for this distro ("-" = not needed)
map_dep() {
  local dep=$1 key=$PM map val
  [[ $key == yum ]] && key=dnf
  map=$(depmap_file)
  if [[ -n $map ]]; then
    val=$(awk -v d="$dep" -v k="$key" '
      /^[[:space:]]*#/ {next}
      $1==d { for (i=2;i<=NF;i++) { n=index($i,"="); if (substr($i,1,n-1)==k) { print substr($i,n+1); f=1 } }
              if (!f) print d; exit }' "$map")
  fi
  [[ -z ${val:-} ]] && val=$dep
  [[ $val == "-" ]] && return 0
  echo "${val//,/ }"
}
in_depmap() { local m; m=$(depmap_file); [[ -n $m ]] && awk -v d="$1" '$1==d{f=1} END{exit !f}' "$m"; }

# stdin: absolute paths → stdout: the ones your distro's package manager owns
# (checks the symlink-resolved path too — /usr/lib64 is /usr/lib on Arch, /lib is /usr/lib on Debian…)
sys_owned() {
  local p c paths=() line
  declare -A back=()
  while IFS= read -r p; do
    [[ -n $p && ( -e $p || -L $p ) ]] || continue
    # every spelling of this file maps back to it (several gurt paths can land on the same real file —
    # e.g. libfoo.so.1 → libfoo.so.1.2 — and ALL of them must be protected)
    for c in "$p" "$(readlink -f -- "$(dirname -- "$p")" 2>/dev/null)/$(basename -- "$p")" "$(readlink -f -- "$p" 2>/dev/null)"; do
      [[ -n $c ]] || continue
      [[ -n ${back[$c]:-} ]] || paths+=("$c")
      back[$c]+="$p"$'\n'
    done
  done
  (( ${#paths[@]} )) || return 0
  { case $PM in
    pacman) pacman -Qo -- "${paths[@]}" 2>/dev/null | sed -n 's/ is owned by .*//p' ;;
    apt)    dpkg -S -- "${paths[@]}" 2>/dev/null | sed -n 's|^.*: \(/.*\)$|\1|p' ;;
    dnf|yum|zypper) for p in "${paths[@]}"; do rpm -qf -- "$p" >/dev/null 2>&1 && echo "$p"; done ;;
    xbps)   for p in "${paths[@]}"; do xbps-query -o "$p" >/dev/null 2>&1 && echo "$p"; done ;;
    apk)    for p in "${paths[@]}"; do apk info -qW "$p" 2>/dev/null | grep -q . && echo "$p"; done ;;
    *)      return 0 ;;
  esac | while IFS= read -r line; do if [[ -n ${back[$line]:-} ]]; then printf '%s' "${back[$line]}"; fi; done | sed '/^$/d' | sort -u; } || true
  return 0
}

install_native() {
  local missing=() p
  for p in "$@"; do pm_has "$p" || missing+=("$p"); done
  pm_install "${missing[@]}"
}

# ───────────────────────── metadata helpers ─────────────────────────
# read "key = value" files (.gurtinfo / .PKGINFO) without executing anything
info_get() { awk -v k="$2" 'index($0, k" = ")==1 { print substr($0, length(k)+4) }' "$1"; }

# installed-db keys: main GURT packages use their plain name, foreign ones are "<source>:<name>"
pkey()   { if [[ $1 == gurt ]]; then echo "$2"; else echo "$1:$2"; fi; }
pretty() { if [[ $1 == *:* ]]; then echo "${1%%:*}/${1#*:}"; else echo "$1"; fi; }
is_installed()  { [[ -f $DB/$1/info ]]; }
inst_ver()      { local r; r=$(info_get "$DB/$1/info" pkgrel); echo "$(info_get "$DB/$1/info" pkgver)${r:+-$r}"; }
PKG_TREE=packages TREE_SRC=gurt   # packages/ = Main GURT, dirt/ = DIRT (opt-in, 18+)
repo_info()     { echo "$GURT_REPO_DIR/$PKG_TREE/$1/.gurtinfo"; }
is_gurt_pkg()   { [[ -f $(repo_info "$1") ]]; }
# download alias → real Main GURT package name
alias_lookup()  {
  local f
  for f in "$GURT_REPO_DIR/$PKG_TREE"/*/.gurtinfo; do
    grep -qxF "alias = $1" "$f" && { basename "$(dirname "$f")"; return 0; }
  done
  return 1
}
is_hidden()     { grep -qx 'hidden = true' "$(repo_info "$1")" 2>/dev/null; }
repo_ver()      { local f; f=$(repo_info "$1"); echo "$(info_get "$f" pkgver)-$(info_get "$f" pkgrel)"; }
# is $2 newer than $1?
vnewer() { [[ $1 != "$2" && $(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -n1) == "$2" ]]; }

ensure_repo() {
  [[ -d $GURT_REPO_DIR/packages ]] || cmd_sync
}

# ───────────────────────── recipes (GURTBUILD + AUR PKGBUILD) ─────────────────────────
CARCH=$(uname -m)
SUM_ALGOS="sha256 sha512 b2 sha384 sha224 sha1 md5 ck"

# safely expand an array that might not exist: arr_get NAME
arr_get() { eval "if [[ -n \${$1[@]+x} ]]; then printf '%s\n' \"\${$1[@]}\"; fi"; }
# split a TSV row into array F (keeps empty fields, unlike IFS=$'\t' read)
tsv() { mapfile -t F < <(tr '\t' '\n' <<<"$1"); }

load_recipe() {
  local f=GURTBUILD
  [[ -f GURTBUILD ]] || f=PKGBUILD
  [[ -f $f ]] || die "no GURTBUILD or PKGBUILD in $PWD"
  RECIPE=$f
  pkgname="" pkgbase="" pkgver="" pkgrel=1 epoch="" pkgdesc="" url="" license="" maintainer="" install=""
  via_repo="" via_type="" via_url="" via_suite="" via_components="" via_key="" via_fingerprint="" via_pkg=""
  aliases=() hidden="" desktop_icon="" secret=""
  arch=() depends=() makedepends=() checkdepends=() source=() noextract=() sums=() SUMALGO=sha256
  local a v fn
  for a in $SUM_ALGOS; do unset "${a}sums" "${a}sums_$CARCH"; done
  for v in source depends makedepends checkdepends; do unset "${v}_$CARCH"; done
  unset -f prepare build check package pkgver 2>/dev/null || true
  for fn in $(declare -F | awk '$3 ~ /^package_/ {print $3}'); do unset -f "$fn"; done

  # shellcheck disable=SC1090
  . "./$f"

  # split packages (AUR): pick the one we were asked for
  pkgbase=${pkgbase:-${pkgname[0]}}
  if [[ -n ${WANT_PKG:-} ]]; then
    local ok=0 n; for n in "${pkgname[@]}"; do [[ $n == "$WANT_PKG" ]] && ok=1; done
    (( ok )) || die "$f doesn't build a package called $WANT_PKG"
    pkgname=("$WANT_PKG")
  fi
  pkgname=${pkgname[0]}
  if ! declare -F package >/dev/null && declare -F "package_$pkgname" >/dev/null; then
    package() { "package_$pkgname" "$@"; }
  fi

  # arch-specific arrays get appended, makepkg-style
  for v in source depends makedepends; do
    mapfile -t _extra < <(arr_get "${v}_$CARCH")
    (( ${#_extra[@]} )) && eval "$v+=(\"\${_extra[@]}\")"
  done
  # checksums: strongest algo the recipe provides
  for a in $SUM_ALGOS; do
    mapfile -t sums < <(arr_get "${a}sums"; arr_get "${a}sums_$CARCH")
    (( ${#sums[@]} )) && { SUMALGO=$a; break; }
  done
  if (( ${#sums[@]} == 0 )); then for v in "${source[@]}"; do sums+=(SKIP); done; fi

  [[ $pkgname =~ ^[a-z0-9@_+][a-z0-9@._+-]*$ ]] || die "bad pkgname '$pkgname' (lowercase, digits, . _ + - only)"
  [[ -n $pkgver && $pkgver =~ ^[A-Za-z0-9._+~]+$ ]] || die "bad pkgver '$pkgver' (no dashes/spaces)"
  pkgrel=${pkgrel:-1}   # left blank → 1
  [[ $pkgrel =~ ^[0-9]+(\.[0-9]+)?$ ]]           || die "bad pkgrel '$pkgrel'"
  if [[ -n $via_repo ]]; then       # "official repo" recipe: no build, just a pinned pointer
    case $via_type in
      flatpak|snap) [[ -n $via_pkg ]] || die "$via_type recipes need via_pkg (the app id / snap name)" ;;
      *) [[ -n $via_type && -n $via_url ]] || die "via_repo recipes need via_type and via_url" ;;
    esac
    [[ -z $via_key || $via_fingerprint =~ ^[0-9A-F]{40}$ ]] || die "via_key needs a pinned via_fingerprint (40 hex chars, uppercase)"
  else
    declare -F package >/dev/null || die "$f needs a package() function"
  fi
  (( ${#arch[@]} )) || arch=(any)
  (( ${#source[@]} == ${#sums[@]} ))              || die "source has ${#source[@]} entries but ${SUMALGO}sums has ${#sums[@]}"
  local al
  for al in "${aliases[@]}"; do [[ ${al//°/} =~ ^[a-z0-9][a-z0-9._+-]*$ ]] || die "bad alias '$al' (same rules as pkgname, plus ° for secrets)"; done
  if [[ $f == GURTBUILD ]]; then
    [[ -n $pkgdesc ]] || die "pkgdesc is empty"
    [[ $SUMALGO == sha256 ]] || die "GURTBUILDs use sha256sums"
  fi
}

print_srcinfo() {
  local x
  printf 'pkgname = %s\npkgver = %s\npkgrel = %s\npkgdesc = %s\n' "$pkgname" "$pkgver" "$pkgrel" "$pkgdesc"
  [[ -n $url ]]        && printf 'url = %s\n' "$url"
  [[ -n $license ]]    && printf 'license = %s\n' "$license"
  [[ -n $maintainer ]] && printf 'maintainer = %s\n' "$maintainer"
  for x in "${arch[@]}";        do printf 'arch = %s\n' "$x"; done
  for x in "${depends[@]}";     do printf 'depends = %s\n' "$x"; done
  for x in "${makedepends[@]}"; do printf 'makedepends = %s\n' "$x"; done
  for x in "${source[@]}";      do printf 'source = %s\n' "$x"; done
  for x in "${aliases[@]}"; do printf 'alias = %s\n' "$x"; done
  case ${hidden,,} in 1|true|yes) printf 'hidden = true\n' ;; esac
  case ${desktop_icon,,} in 1|true|yes) printf 'desktop_icon = true\n' ;; esac
  case ${secret,,} in 1|true|yes) printf 'secret = true\n' ;; esac
  for x in via_repo via_type via_url via_suite via_components via_key via_fingerprint via_pkg; do
    [[ -n ${!x} ]] && printf '%s = %s\n' "$x" "${!x}"
  done
  return 0
}

arch_ok() {
  local a
  for a in "${arch[@]}"; do [[ $a == any || $a == "$CARCH" ]] && return 0; done
  return 1
}

download() {
  local bar=(-sS) wbar=(-q); [[ -t 2 ]] && bar=(--progress-bar) wbar=(-q --show-progress)
  if command -v curl >/dev/null; then curl -fL --retry 3 "${bar[@]}" -o "$2" "$1"
  elif command -v wget >/dev/null; then wget "${wbar[@]}" -O "$2" "$1"
  else die "need curl or wget to download stuff"; fi
}
fetch_quiet() {  # url dest — for indexes
  if command -v curl >/dev/null; then curl -fsSL --retry 2 -o "$2" "$1"
  else wget -q -O "$2" "$1"; fi
}

verify() { # file sum [algo]
  [[ $2 == SKIP ]] && return 0
  local got
  case ${3:-sha256} in
    ck) got=$(cksum < "$1" | awk '{print $1}') ;;
    b2) got=$(b2sum "$1" | awk '{print $1}') ;;
    *)  got=$("${3:-sha256}sum" "$1" | awk '{print $1}') ;;
  esac
  [[ $got == "$2" ]]
}

# extract anything: tarballs, zips, .deb, .rpm, .pkg.tar.* (into dir $2)
extract_any() {
  local f=$1 to=$2
  case $f in
    *.deb)
      if command -v bsdtar >/dev/null; then bsdtar -xf "$f" -C "$to"
      else command -v ar >/dev/null || die "need 'ar' (binutils) or bsdtar to open .deb files"
           (cd "$to" && ar x "$(readlink -f "$f")"); fi ;;
    *.rpm)
      if command -v bsdtar >/dev/null; then bsdtar -xf "$f" -C "$to"
      else command -v rpm2cpio >/dev/null && command -v cpio >/dev/null || die "need bsdtar, or rpm2cpio + cpio, to open .rpm files"
           (cd "$to" && rpm2cpio "$(readlink -f "$f")" | cpio -idm --quiet); fi ;;
    *.tar|*.tar.*|*.tgz|*.tbz2|*.txz|*.tzst) tar -xf "$f" -C "$to" ;;
    *.zip) if command -v bsdtar >/dev/null; then bsdtar -xf "$f" -C "$to"
           else command -v unzip >/dev/null || die "need unzip"; unzip -q -o "$f" -d "$to"; fi ;;
    *.gz)  gzip -dc "$f" > "$to/$(basename "${f%.gz}")" ;;
    *.xz)  xz -dc "$f"   > "$to/$(basename "${f%.xz}")" ;;
    *.bz2) bzip2 -dc "$f" > "$to/$(basename "${f%.bz2}")" ;;
    *.zst) zstd -qdc "$f" > "$to/$(basename "${f%.zst}")" ;;
    *) return 1 ;;
  esac
}

unpack() { # file name — makepkg-style: link into srcdir, then extract if it's an archive
  local f=$1 name=$2 n
  ln -sf "$f" "$srcdir/$name"
  for n in "${noextract[@]}"; do [[ $n == "$name" ]] && return 0; done
  extract_any "$f" "$srcdir" || true
}

fetch_sources() {
  local i s name loc sum dest
  mkdir -p "$SRCDEST"
  for i in "${!source[@]}"; do
    s=${source[$i]}; sum=${sums[$i]}
    if [[ $s == *::* ]]; then name=${s%%::*}; loc=${s#*::}; else loc=$s; name=${s%%#*}; name=${name##*/}; fi
    case $loc in
      git+*)
        local repo=${loc#git+} frag="" ref="" commit=""
        [[ $repo == *#* ]] && { frag=${repo#*#}; repo=${repo%%#*}; }
        repo=${repo%%\?*}
        case $frag in tag=*|branch=*) ref=${frag#*=} ;; commit=*) commit=${frag#*=} ;; esac
        [[ $s == *::* ]] || { name=${repo##*/}; name=${name%.git}; }
        msg2 "cloning $repo${ref:+ @ $ref}${commit:+ @ $commit}"
        if [[ -n $commit ]]; then
          git clone -q "$repo" "$srcdir/$name" && git -C "$srcdir/$name" -c advice.detachedHead=false checkout -q "$commit"
        elif [[ $RECIPE == PKGBUILD && -z $ref ]]; then
          git clone -q "$repo" "$srcdir/$name"     # -git packages need history for pkgver()
        else
          git clone -q --depth 1 ${ref:+--branch "$ref"} "$repo" "$srcdir/$name"
        fi ;;
      svn+*|hg+*|bzr+*|fossil+*) die "${loc%%+*} sources aren't supported (yet) — only git" ;;
      http://*|https://*|ftp://*)
        dest="$SRCDEST/$name"
        if [[ -f $dest ]] && ! verify "$dest" "$sum" "$SUMALGO"; then rm -f "$dest"; fi
        if [[ ! -f $dest ]]; then
          msg2 "downloading $name"
          download "$loc" "$dest.part" || { rm -f "$dest.part"; die "couldn't download $name from $loc"; }
          mv "$dest.part" "$dest"
        fi
        verify "$dest" "$sum" "$SUMALGO" || die "${SUMALGO} mismatch on $name — source changed or got tampered with 🚩"
        [[ $sum == SKIP ]] && warn "$name has no checksum (SKIP)"
        unpack "$dest" "$name" ;;
      *)  # local file shipped next to the recipe
        [[ -f $startdir/$loc ]] || die "missing local source file: $loc"
        verify "$startdir/$loc" "$sum" "$SUMALGO" || die "${SUMALGO} mismatch on local file $loc"
        cp -a "$startdir/$loc" "$srcdir/"
        for n in "${noextract[@]}"; do [[ $n == "$loc" ]] && continue 2; done
        case $loc in *.tar*|*.tgz|*.zip|*.deb|*.rpm) extract_any "$startdir/$loc" "$srcdir" ;; esac ;;
    esac
  done
}

# write .FILES/.DIRS/.PKGINFO and tar $pkgdir up into a .gurt  (args: work outfile, cwd = pkgdir)
pack_pkgdir() {
  local work=$1 out=$2 top=()
  [[ -n $(find . -mindepth 1 -print | head -n1) ]] || die "nothing to package (empty \$pkgdir)"
  find . -mindepth 1 ! -type d | sed 's|^\./||' | LC_ALL=C sort > "$work/.FILES"
  find . -mindepth 1 -type d   | sed 's|^\./||' | LC_ALL=C sort > "$work/.DIRS"
  mapfile -t top < <(find . -mindepth 1 -maxdepth 1 | sed 's|^\./||')
  cp "$work/.PKGINFO" "$work/.FILES" "$work/.DIRS" .
  tar --owner=0 --group=0 --numeric-owner -czf "$out" .PKGINFO .FILES .DIRS "${top[@]}"
}

# build a recipe dir (GURTBUILD or PKGBUILD) into a .gurt package (never needs root)
BUILT_PKG=""
build_pkg() {
  local rdir outdir work
  rdir=$(cd "$1" && pwd)
  mkdir -p "${2:-$PWD}"; outdir=$(cd "${2:-$PWD}" && pwd)
  if (( EUID == 0 )) && [[ -z ${GURT_ALLOW_ROOT:-} ]]; then
    die "don't build as root fr. run gurt as your normal user — it'll ask for sudo when it needs it (or set GURT_ALLOW_ROOT=1 in containers)"
  fi
  work=$(mktemp -d "${TMPDIR:-/tmp}/gurt-build.XXXXXX")
  (
    set -eE
    set +u +o pipefail                       # recipes run in makepkg-ish mode
    warning() { warn "$@"; }; error() { printf '%s==> ERROR:%s %s\n' "$RED" "$R0" "$*" >&2; }
    plain()   { printf '    %s\n' "$*" >&2; }
    cd "$rdir"
    local src="${GURT_SRC:-}"
    startdir=$rdir srcdir="$work/src" pkgdir="$work/pkg"
    if [[ -f GURTBUILD ]]; then prefix=$GURT_PREFIX; src=${src:-gurt}; else prefix=/usr; src=${src:-aur}; fi
    CHOST="$CARCH-pc-linux-gnu"
    mkdir -p "$srcdir" "$pkgdir"
    export startdir srcdir pkgdir prefix CARCH CHOST
    load_recipe
    arch_ok || die "$pkgname doesn't support $CARCH (arch: ${arch[*]})"
    SRCDEST="$GURT_CACHE/sources/$pkgbase"
    msg "building $(pretty "$(pkey "$src" "$pkgname")") ${epoch:+$epoch:}$pkgver-$pkgrel"
    [[ -n $install ]] && warn "$RECIPE has an install script ($install) — gurt doesn't run those, check it for post-install steps"
    fetch_sources
    export MAKEFLAGS="${MAKEFLAGS:--j$(nproc 2>/dev/null || echo 2)}"
    export CFLAGS="${CFLAGS:--O2 -pipe}" CXXFLAGS="${CXXFLAGS:--O2 -pipe}"
    if declare -F prepare >/dev/null; then msg "prepare()"; cd "$srcdir"; prepare; fi
    if declare -F pkgver  >/dev/null; then cd "$srcdir"; pkgver=$(pkgver); msg2 "pkgver() says $pkgver"; fi
    if declare -F build   >/dev/null; then msg "build()";   cd "$srcdir"; build;   fi
    if ! $NOCHECK && declare -F check >/dev/null; then msg "check()"; cd "$srcdir"; check; fi
    msg "package()"; cd "$srcdir"; package

    cd "$pkgdir"
    if [[ $RECIPE == GURTBUILD ]] && find . -mindepth 1 ! -type d | sed 's|^\./||' | grep -qv "^${prefix#/}/"; then
      warn "this package installs files outside $prefix — could clash with your distro's own packages"
    fi
    local a=any; [[ ${arch[*]} == any ]] || a=$CARCH
    { print_srcinfo; printf 'builddate = %s\nprefix = %s\ngurtsource = %s\n' "$(date +%s)" "$prefix" "$src"
      [[ -n ${GURT_EXTRA_INFO:-} ]] && printf '%s\n' "$GURT_EXTRA_INFO"; } > "$work/.PKGINFO"
    local out="$outdir/$pkgname-$pkgver-$pkgrel-$a.gurt"
    pack_pkgdir "$work" "$out"
    echo "$out" > "$work/.out"
    msg "built $(basename "$out") 📦"
  )
  BUILT_PKG=$(cat "$work/.out")
  if $KEEP; then msg2 "kept build dir: $work"; else rm -rf "$work"; fi
}

# ───────────────────────── install / remove ─────────────────────────
install_file() { # file.gurt [reason]
  local f reason=${2:-explicit} tmp name src key dbd
  f=$(readlink -f "$1")
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/gurt-inst.XXXXXX")
  tar -xzf "$f" -C "$tmp" .PKGINFO .FILES .DIRS 2>/dev/null || { rm -rf "$tmp"; die "not a gurt package: $1"; }
  name=$(info_get "$tmp/.PKGINFO" pkgname)
  src=$(info_get "$tmp/.PKGINFO" gurtsource); src=${src:-gurt}
  [[ -n $name ]] || die "package has no name??"
  if grep -qE '(^|/)\.\.(/|$)|^/' "$tmp/.FILES" "$tmp/.DIRS"; then die "package has sketchy paths (.. or absolute) — refusing"; fi
  key=$(pkey "$src" "$name"); dbd="$DB/$key"
  [[ $reason == dep && -f $dbd/reason ]] && reason=$(cat "$dbd/reason")

  # 1) anything your distro owns is off limits — no exceptions, no --force
  if [[ -z $R ]]; then
    local sysfiles
    sysfiles=$(sed 's|^|/|' "$tmp/.FILES" | sys_owned)
    if [[ -n $sysfiles ]]; then
      sed 's/^/   /' <<<"$sysfiles" | head -n 15 >&2
      rm -rf "$tmp"
      local hint=""; [[ $src != gurt && $src != aur ]] && hint=" — if you really need it, run it in a container instead: gurt install --box $(pretty "$key")"
      die "$(pretty "$key") would overwrite files your distro ($PM) owns ^ — gurt NEVER does that, not even with --force 🛡️$hint"
    fi
  fi

  # 2) file conflicts with other gurt packages / stray files
  local rel owner o conflicts=()
  while IFS= read -r rel; do
    [[ -e $R/$rel || -L $R/$rel ]] || continue
    [[ -f $dbd/files ]] && grep -qxF "$rel" "$dbd/files" && continue
    owner=""
    for o in "$DB"/*/files; do grep -qxF "$rel" "$o" && { owner=$(pretty "$(basename "$(dirname "$o")")"); break; }; done
    conflicts+=("/$rel  (owned by ${owner:-your distro / not gurt})")
  done < "$tmp/.FILES"
  if (( ${#conflicts[@]} )); then
    printf '   %s\n' "${conflicts[@]:0:25}" >&2
    (( ${#conflicts[@]} > 25 )) && printf '   …and %s more\n' $(( ${#conflicts[@]} - 25 )) >&2
    $FORCE || { rm -rf "$tmp"; die "$(pretty "$key") would overwrite existing files ^ (use --force if you're sure)"; }
    warn "--force: overwriting anyway"
  fi

  # remember which dirs WE create so remove only cleans those up
  : > "$tmp/newdirs"
  while IFS= read -r rel; do [[ -d $R/$rel ]] || echo "$rel" >> "$tmp/newdirs"; done < "$tmp/.DIRS"
  [[ -f $dbd/dirs ]] && cat "$dbd/dirs" >> "$tmp/newdirs"
  LC_ALL=C sort -u -o "$tmp/newdirs" "$tmp/newdirs"

  local r; r=$(info_get "$tmp/.PKGINFO" pkgrel)
  msg "installing $(pretty "$key") $(info_get "$tmp/.PKGINFO" pkgver)${r:+-$r}"
  asroot mkdir -p "${R:-/}" "$DB"
  asroot tar -xzf "$f" -C "${R:-/}" --no-overwrite-dir --keep-directory-symlink \
    --exclude=./.PKGINFO --exclude=.PKGINFO --exclude=.FILES --exclude=.DIRS

  # upgrade: drop files the new version no longer ships
  if [[ -f $dbd/files ]]; then
    LC_ALL=C comm -23 <(LC_ALL=C sort "$dbd/files") "$tmp/.FILES" | while IFS= read -r rel; do
      [[ -n $rel ]] && asroot rm -f -- "$R/$rel"
    done
  fi

  echo "$reason" > "$tmp/reason"
  stash_pkg "$key" "$f" > "$tmp/pkgfile"
  asroot mkdir -p "$dbd"
  asroot cp "$tmp/.PKGINFO" "$dbd/info"
  asroot cp "$tmp/.FILES"   "$dbd/files"
  asroot cp "$tmp/newdirs"  "$dbd/dirs"
  asroot cp "$tmp/reason"   "$dbd/reason"
  asroot cp "$tmp/pkgfile"  "$dbd/pkgfile"
  rm -rf "$tmp"
  post_install "$key"
  msg "$(pretty "$key") installed ✅"
}

# recipes with desktop_icon=true get a shortcut on your desktop (skip with --no-desktop or GURT_DESKTOP_ICONS=0)
desktop_dir() { local d; d=$(xdg-user-dir DESKTOP 2>/dev/null) || d=""; [[ -n $d && $d != "$HOME" ]] || d="$HOME/Desktop"; echo "$d"; }
add_desktop_icons() {
  local key=$1 desk rel f out made=()
  { $NO_DESKTOP || [[ ${GURT_DESKTOP_ICONS:-1} == 0 ]]; } && return 0
  (( EUID == 0 )) && return 0   # root's desktop isn't yours
  desk=$(desktop_dir); mkdir -p "$desk" 2>/dev/null || return 0
  while IFS= read -r rel; do
    f="$R/$rel"; out="$desk/${rel##*/}"
    [[ -f $f ]] || continue
    if [[ -e $out ]] && ! grep -qxF "$out" "$DB/$key/desktop" 2>/dev/null; then warn "there's already a $out on your desktop, left it alone"; continue; fi
    cp -f -- "$f" "$out" && chmod 755 "$out" || continue
    command -v gio >/dev/null && gio set "$out" metadata::trusted true 2>/dev/null || true   # GNOME: no "untrusted launcher" nag
    made+=("$out")
  done < <(grep -E '(^|/)share/applications/[^/]+\.desktop$' "$DB/$key/files")
  (( ${#made[@]} )) || return 0
  printf '%s\n' "${made[@]}" | asroot tee "$DB/$key/desktop" >/dev/null
  msg2 "put a shortcut on your desktop 🖥️"
}
rm_desktop_icons() { local f; [[ -f $DB/$1/desktop ]] || return 0; while IFS= read -r f; do [[ -n $f ]] && rm -f -- "$f"; done < "$DB/$1/desktop"; }

# after install: refresh the linker cache, teach it about foreign lib dirs, sanity-check binaries
post_install() {
  local key=$1 files="$DB/$1/files" f
  if [[ -z $R ]]; then
    # gurt < 0.8.2 put foreign lib folders on the GLOBAL linker path — that let an app's private libs
    # (Electron ships its own libvulkan/libEGL/libGLESv2…) hijack every program, desktop included. undo it.
    if [[ -f /etc/ld.so.conf.d/gurt.conf ]]; then
      warn "removing /etc/ld.so.conf.d/gurt.conf — old gurt put app-private libs on the global library path (that can break your desktop)"
      asroot rm -f /etc/ld.so.conf.d/gurt.conf
      asroot ldconfig 2>/dev/null || true
    fi
    grep -qE '(^|/)lib[^/]*\.so(\.[0-9.]+)?$' "$files" && { asroot ldconfig 2>/dev/null || true; }
    LDCACHE=""
    fix_rpaths "$key"
    [[ $(info_get "$DB/$key/info" desktop_icon) == true ]] && add_desktop_icons "$key"
  fi
  # do the binaries actually have what they need?
  command -v ldd >/dev/null || return 0
  local lacks="" n=0 out
  while IFS= read -r f; do
    [[ -f $R/$f && ! -L $R/$f ]] || continue
    [[ $(head -c4 "$R/$f" 2>/dev/null | od -An -c | tr -d ' ') == 177ELF ]] || continue
    (( n++ > 60 )) && break
    out=$(LD_LIBRARY_PATH="$R/usr/lib:$R/usr/lib64:$R/usr/local/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ldd "$R/$f" 2>&1 || true)
    lacks+=$(grep -oE "^[[:space:]]*[^ ]+ => not found|version \`[^']+' not found" <<<"$out" | sed -E 's/^[[:space:]]*//; s/ => not found//; s/version `([^'"'"']+)'"'"' not found/needs \1/' || true)$'\n'
  done < <(grep -E '(^|/)(s?bin|lib[^/]*|libexec)/' "$files")
  lacks=$(sort -u <<<"$lacks" | sed '/^$/d' | head -n 15)
  if [[ -n $lacks ]]; then
    warn "$(pretty "$key") installed but some binaries are missing stuff:"
    sed 's/^/     /' <<<"$lacks" >&2
    if grep -q '^needs GLIBC' <<<"$lacks"; then
      msg2 "that one's a glibc version gap — your distro's glibc is older than the one this was built for 😬 try the aur/ version (builds from source), or run it in a container: gurt install --box $(pretty "$key")"
    else
      msg2 "try installing those libs from your distro, or reinstall so gurt pulls them from $(pretty "${key%%:*}")"
    fi
  fi
}

# an app needs a lib that another gurt package put somewhere non-standard → point THAT app at it
# (RUNPATH via patchelf) instead of touching the system-wide library path
fix_rpaths() { # key
  command -v ldd >/dev/null || return 0
  local key=$1 f lib hit n=0 need=()
  while IFS= read -r f; do
    [[ -f /$f && ! -L /$f ]] || continue
    [[ $(head -c4 "/$f" 2>/dev/null | od -An -c | tr -d ' ') == 177ELF ]] || continue
    (( n++ > 300 )) && break
    while IFS= read -r lib; do
      hit=$(cat "$DB"/*/files 2>/dev/null | awk -v l="/$lib" 'length($0) >= length(l) && substr($0, length($0) - length(l) + 1) == l { print; exit }')
      [[ -n $hit ]] && need+=("$f|/$(dirname "$hit")")
    done < <(ldd "/$f" 2>/dev/null | awk '/=> not found/ {print $1}')
  done < "$DB/$key/files"
  (( ${#need[@]} )) || return 0
  if ! command -v patchelf >/dev/null; then
    if ! $NODEPS; then install_native "$(map_dep patchelf)" || true; fi
    command -v patchelf >/dev/null || { warn "some files need libs from other gurt packages — install patchelf and reinstall so gurt can link them"; return 0; }
  fi
  local e fixed=0
  for e in "${need[@]}"; do
    asroot patchelf --add-rpath "${e#*|}" "/${e%%|*}" 2>/dev/null && fixed=$((fixed + 1))
  done
  (( fixed )) && msg2 "linked $fixed file(s) to their libs — only those files, your system's library path is untouched 🛡️"
  return 0
}

resolve_key() { # user spec (name or src/name) -> installed db key
  local spec=$1 src name k
  if [[ $spec == */* ]]; then src=$(norm_src "${spec%%/*}"); name=${spec#*/}; k=$(pkey "$src" "$name")
    is_installed "$k" && { echo "$k"; return; }; return 1; fi
  is_installed "$spec" && { echo "$spec"; return; }
  local hits=() d
  for d in "$DB"/*:"$spec"/; do hits+=("$(basename "$d")"); done
  local lo
  for d in "$DB"/flatpak:*/; do d=$(basename "$d"); lo=${d,,}; [[ ${lo##*.} == "${spec,,}" || $lo == "flatpak:${spec,,}" ]] && hits+=("$d"); done
  (( ${#hits[@]} == 1 )) && { echo "${hits[0]}"; return; }
  (( ${#hits[@]} > 1 )) && die "$spec is installed from multiple sources: $(for k in "${hits[@]}"; do printf '%s ' "$(pretty "$k")"; done)— say which one"
  return 1
}

rdeps_of() { # key -> installed packages that depend on it (pretty names)
  local key=$1 name=${1#*:} o other gives
  gives=("$name" "$(pretty "$key")")
  mapfile -t -O 2 gives < <(info_get "$DB/$key/info" provides)
  for o in "$DB"/*/info; do
    other=$(basename "$(dirname "$o")")
    [[ $other == "$key" ]] && continue
    info_get "$o" depends | sed 's/[<>=].*//' | grep -qxF -f <(printf '%s\n' "${gives[@]}") && pretty "$other"
  done
  return 0
}

cmd_autoremove() {
  local d k orphans=() round=1
  while (( round )); do
    round=0
    for d in "$DB"/*/; do
      k=$(basename "$d")
      [[ $(cat "$d/reason" 2>/dev/null) == dep ]] || continue
      [[ " ${orphans[*]} " == *" $k "* ]] && continue
      if [[ -z $(rdeps_of "$k" | grep -vxF -f <(for o in "${orphans[@]}"; do pretty "$o"; done; echo /)) ]]; then orphans+=("$k"); round=1; fi
    done
  done
  (( ${#orphans[@]} )) || { msg "no leftover deps, you're clean ✨"; return 0; }
  msg "these were only pulled in as deps and nothing needs them anymore:"
  for k in "${orphans[@]}"; do msg2 "$(pretty "$k") $(inst_ver "$k")"; done
  ask "yeet them?" || die "aborted"
  local was=$FORCE; FORCE=true
  for k in "${orphans[@]}"; do remove_pkg "$(pretty "$k")"; done
  FORCE=$was
}

remove_pkg() {
  local key name o
  key=$(resolve_key "$1") || die "$1 isn't installed"
  name=${key#*:}
  case $key in
    flatpak:*) msg "removing $(pretty "$key")"; flatpak uninstall --user -y --noninteractive "$name" || warn "flatpak couldn't remove it (already gone?)"
               asroot rm -rf -- "$DB/$key"; msg "$(pretty "$key") removed 🗑️"; return ;;
    snap:*)    msg "removing $(pretty "$key")"; asroot snap remove "$name" || warn "snap couldn't remove it (already gone?)"
               asroot rm -rf -- "$DB/$key"; msg "$(pretty "$key") removed 🗑️"; return ;;
    box-*:*)   box_remove "$key"; return ;;
  esac
  local dbd="$DB/$key" rdeps=()
  mapfile -t rdeps < <(rdeps_of "$key")
  if (( ${#rdeps[@]} )) && ! $FORCE; then die "$(pretty "$key") is needed by: ${rdeps[*]} (use --force to yeet it anyway)"; fi
  msg "removing $(pretty "$key")"
  local rel keep=""
  [[ -z $R ]] && keep=$(sed 's|^|/|' "$dbd/files" | sys_owned)
  while IFS= read -r rel; do
    [[ -n $rel ]] || continue
    if [[ -n $keep ]] && grep -qxF -- "/$rel" <<<"$keep"; then warn "kept /$rel — your distro owns it"; continue; fi
    asroot rm -f -- "$R/$rel"
  done < "$dbd/files"
  rm_desktop_icons "$key"
  LC_ALL=C sort -r "$dbd/dirs" | while IFS= read -r rel; do
    [[ -n $rel ]] && asroot rmdir -- "$R/$rel" 2>/dev/null || true
  done
  asroot rm -rf -- "$dbd"
  msg "$(pretty "$key") removed 🗑️"
}

declare -A VISITED=()
NATIVE_Q=()
flush_native() {
  (( ${#NATIVE_Q[@]} )) || return 0
  # shellcheck disable=SC2046
  if $NODEPS; then warn "--nodeps: skipping distro deps: ${NATIVE_Q[*]}"
  else install_native $(printf '%s\n' "${NATIVE_Q[@]}" | sort -u); fi
  NATIVE_Q=()
}

# ── main GURT repo ──
resolve_and_install() { # name reason
  local name=$1 reason=${2:-dep} real
  if ! is_gurt_pkg "$name" && real=$(alias_lookup "$name"); then msg2 "$name is an alias → $real"; name=$real
  elif is_gurt_pkg "$name" && grep -qx 'secret = true' "$(repo_info "$name")" && ! is_installed "$(pkey "$TREE_SRC" "$name")"; then
    die "no package '$name' in main GURT (try: gurt search $name, or gurt search -a $name for every source)"   # 🤫 only the secret alias works
  fi
  local key; key=$(pkey "$TREE_SRC" "$name")
  [[ -n ${VISITED[$key]:-} ]] && return 0
  VISITED[$key]=1
  local rdir="$GURT_REPO_DIR/$PKG_TREE/$name" info
  info=$(repo_info "$name")
  if [[ ! -f $info ]]; then
    [[ $TREE_SRC == dirt ]] && die "no package '$name' in DIRT"
    die "no package '$name' in main GURT (try: gurt search $name, or gurt search -a $name for every source)"
  fi

  # official-repo recipe → add the vendor's repo (key fingerprint pinned by the recipe), install from it
  local via; via=$(info_get "$info" via_repo)
  case $(info_get "$info" via_type) in
    flatpak) flatpak_install "$(info_get "$info" via_pkg)" "$reason"; return ;;
    snap)    snap_install "$(info_get "$info" via_pkg)" "$reason"; return ;;
  esac
  if [[ -n $via ]]; then
    if ! repo_file "$via" >/dev/null; then
      msg "$name comes from its official repo — adding '$via' 🔏"
      local g; g() { info_get "$info" "$1"; }
      # shellcheck disable=SC2046
      KEYSRC=$(g via_key) EXPECT_FPR=$(g via_fingerprint) SUITE_OPT="" \
        repo_add "$via" "$(g via_type)" "$(g via_url)" "$(g via_suite)" $(g via_components)
    fi
    local vp; vp=$(info_get "$info" via_pkg)
    foreign_install "$via" "${vp:-$name}" "$reason"
    return
  fi

  if is_installed "$key" && ! $FORCE && ! vnewer "$(inst_ver "$key")" "$(repo_ver "$name")"; then
    [[ $reason == explicit ]] && msg "$(pretty "$key") $(inst_ver "$key") is already installed and up to date 👍"
    return 0
  fi

  local d
  for d in $(info_get "$info" depends) $(info_get "$info" makedepends); do
    if [[ $d == */* ]]; then
      install_any "$d" dep                      # recipes can depend on aur/…, apt/… etc
    elif is_gurt_pkg "$d" && ! in_depmap "$d"; then
      is_installed "$d" || { msg2 "$name needs gurt package $d"; resolve_and_install "$d" dep; }
    else
      # shellcheck disable=SC2207
      NATIVE_Q+=($(map_dep "$d"))
    fi
  done
  flush_native

  if ! $NOCONFIRM; then
    printf '\n%s──── %s/GURTBUILD ────%s\n' "$B" "$name" "$R0" >&2
    cat "$rdir/GURTBUILD" >&2
    printf '%s───────────────────────%s\n' "$B" "$R0" >&2
    ask "read that GURTBUILD? build + install $name $(repo_ver "$name")?" || die "aborted, no cap"
  fi
  GURT_SRC=$TREE_SRC build_pkg "$rdir" "$GURT_CACHE/pkg"
  install_file "$BUILT_PKG" "$reason"
}

install_any() { # spec reason
  local spec=$1 reason=${2:-explicit} src name
  if [[ $spec == */* ]]; then src=$(norm_src "${spec%%/*}"); name=${spec#*/}; else src=gurt; name=$spec; fi
  [[ -n $name ]] || die "install what from $src tho"
  if [[ $src == mac || $src == macos || $src == osx ]]; then   # 👁️
    printf '\n%s        👁️      👁️%s\n\n' "$RED" "$R0" >&2
    printf '%s  Linus Torvalds is here. He sees you.%s\n\n' "$B" "$R0" >&2
    exit 1
  fi
  if $BOX || [[ $src == box-* ]]; then
    src=${src#box-}
    case $src in apt|dnf|zypper|pacman) box_install "$src" "$name" "$reason"; return ;;
      *) die "--box works with apt/ dnf/ zypper/ pacman/ (gurt, aur, flatpak and snap already run fine without it)" ;; esac
  fi
  case $src in
    gurt) ensure_repo; PKG_TREE=packages TREE_SRC=gurt resolve_and_install "$name" "$reason" ;;
    dirt) dirt_install "$name" "$reason" ;;
    git)  local u; u=$(info_get "$DB/git:$name/info" outsource_url 2>/dev/null)
          [[ -n $u ]] || die "git/ packages come from a url: gurt outsource https://github.com/user/repo"
          outsource_install "$u" "$reason" ;;
    aur)  aur_install "$name" "$reason" ;;
    flatpak) flatpak_install "$name" "$reason" ;;
    snap)    snap_install "$name" "$reason" ;;
    *) is_binary_src "$src" || die "unknown source '$src' — pick one of: gurt $(all_sources) (or add one: gurt repo add)"
       foreign_install "$src" "$name" "$reason" ;;
  esac
}

# ───────────────────────── foreign sources ─────────────────────────
# apt    → Debian/Ubuntu binary packages (.deb)
# dnf    → Fedora binary packages (.rpm)
# zypper → openSUSE binary packages (.rpm)
# pacman → Arch official binary packages (.pkg.tar.zst)
# aur    → Arch User Repository PKGBUILDs, built from source
#
# binary indexes get flattened into one TSV per source:
#   name \t version \t path-on-mirror \t algo:sum \t deps,comma,separated \t description

norm_src() {
  case ${1,,} in
    gurt|main)                      echo gurt ;;
    dirt)                           echo dirt ;;
    git|outsource)                  echo git ;;
    apt|deb|debian|ubuntu|mint)     echo apt ;;
    dnf|yum|rpm|fedora)             echo dnf ;;
    zypper|suse|opensuse)           echo zypper ;;
    pacman|arch|archlinux)          echo pacman ;;
    aur)                            echo aur ;;
    flatpak|flathub)                echo flatpak ;;
    snap|snapcraft|snapd)           echo snap ;;
    *)                              echo "$1" ;;
  esac
}
# ── custom repos (gurt repo add) ──
# one file per repo:  ~/.config/gurt/repos.d/<name>.conf  (or /etc/gurt/repos.d/ for everyone)
#   type=apt|rpm|pacman   url=…   suite=…   components=…   key=/path/to/key.asc
USER_REPO_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gurt/repos.d"
KEY_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/gurt/keys"
REPO_DIRS=(/etc/gurt/repos.d "$USER_REPO_DIR")
repo_file() { local d; for d in "${REPO_DIRS[@]}"; do [[ -f $d/$1.conf ]] && { echo "$d/$1.conf"; return 0; }; done; return 1; }
repo_get()  { local f; f=$(repo_file "$1") || return 0; awk -v k="$2" 'index($0, k "=") == 1 { print substr($0, length(k) + 2); exit }' "$f"; }
custom_repos() { local d f; for d in "${REPO_DIRS[@]}"; do for f in "$d"/*.conf; do basename "$f" .conf; done; done | sort -u; }
all_sources()  { echo "$FOREIGN_SOURCES $(custom_repos | tr '\n' ' ')"; }
src_kind() {
  case $1 in
    gurt) echo gurt ;; aur) echo aur ;; apt) echo apt ;; dnf|zypper) echo rpm ;; pacman) echo pacman ;;
    flatpak) echo flatpak ;; snap) echo snap ;;
    *) if repo_file "$1" >/dev/null; then repo_get "$1" type; else echo unknown; fi ;;
  esac
}
is_binary_src() { case $(src_kind "$1") in apt|rpm|pacman) return 0 ;; *) return 1 ;; esac; }
src_pm() {
  case $1 in
    aur|pacman) echo pacman ;; apt|dnf|zypper) echo "$1" ;;
    *) case $(src_kind "$1") in apt) echo apt ;; rpm) echo dnf ;; pacman) echo pacman ;; esac ;;
  esac
}
# the built-in source a custom repo falls back to for deps (a PPA's libs live in Ubuntu/Debian, etc)
src_fallback() { case $(src_kind "$1") in apt) echo apt ;; rpm) echo dnf ;; pacman) echo pacman ;; esac; }
src_base() {
  case $1 in
    apt)    echo "$APT_MIRROR" ;;
    dnf)    echo "${DNF_MIRROR//\$arch/$CARCH}" ;;
    zypper) echo "${ZYPPER_MIRROR//\$arch/$CARCH}" ;;
    pacman) echo "$PACMAN_MIRROR" ;;
    *)      local u; u=$(repo_get "$1" url); echo "${u//\$arch/$CARCH}" ;;
  esac
}
# armored or binary key → a keyring gpgv can use
gpg_keyring() { # key out
  need_tool gpg "signed repos"
  if grep -q 'BEGIN PGP' "$1" 2>/dev/null; then gpg --dearmor < "$1" > "$2"; else cp "$1" "$2"; fi
}
debarch() { case $CARCH in x86_64) echo amd64 ;; aarch64) echo arm64 ;; armv7l) echo armhf ;; i?86) echo i386 ;; ppc64le) echo ppc64el ;; *) echo "$CARCH" ;; esac; }
idx_file() { echo "$IDX_DIR/$1.tsv"; }
idx_fresh() { local f; f=$(idx_file "$1"); [[ -s $f ]] && (( $(date +%s) - $(stat -c %Y "$f") < IDX_MAX_AGE )); }
ensure_idx() { idx_fresh "$1" || sync_source "$1"; }
idx_lookup() { [[ -s $(idx_file "$1") ]] && awk -F'\t' -v n="$2" '$1==n {print; exit}' "$(idx_file "$1")"; }
# who provides a virtual name / soname?  (prints the package name)
idx_provider() {
  [[ -s $(idx_file "$1") ]] || return 0
  awk -F'\t' -v d="$2" '{ c=split($7, a, ","); for (i=1; i<=c; i++) if (a[i] == d) { print $1; exit } }' "$(idx_file "$1")"
}

need_tool() { command -v "$1" >/dev/null || die "the $2 source needs '$1' — install it from your distro first"; }

sync_source() {
  local s=$1 tmp out
  case $(src_kind "$s") in
    aur) msg2 "aur is searched live, nothing to sync"; return 0 ;;
    flatpak|snap) msg2 "$s keeps its own index, nothing to sync"; return 0 ;;
    apt|rpm|pacman) ;;
    *) die "unknown source '$s' (have: gurt $(all_sources))" ;;
  esac
  mkdir -p "$IDX_DIR"; tmp=$(mktemp -d "${TMPDIR:-/tmp}/gurt-idx.XXXXXX"); out=$(idx_file "$s")
  msg "syncing $s index from $(src_base "$s")"
  case $s in
    apt)        sync_apt "$tmp" "$APT_MIRROR" "$APT_SUITE" "$APT_COMPONENTS" "" ;;
    dnf|zypper) sync_rpm "$s" "$tmp" "" ;;
    pacman)     sync_pacman "$tmp" "$PACMAN_MIRROR/\$repo/os/\$arch" "$PACMAN_REPOS" ;;
    *) case $(src_kind "$s") in
         apt)    sync_apt "$tmp" "$(src_base "$s")" "$(repo_get "$s" suite)" "$(repo_get "$s" components)" "$(repo_get "$s" key)" ;;
         rpm)    sync_rpm "$s" "$tmp" "$(repo_get "$s" key)" ;;
         pacman) sync_pacman "$tmp" "$(repo_get "$s" url)" "$(repo_get "$s" suite)" ;;
       esac ;;
  esac > "$tmp/index.tsv"
  [[ -s $tmp/index.tsv ]] || { rm -rf "$tmp"; die "$s index came back empty (mirror down? check gurt.conf)"; }
  mv "$tmp/index.tsv" "$out"; rm -rf "$tmp"
  msg2 "$(wc -l < "$out") packages in $s"
}

sync_apt() { # tmp mirror suite components [key]
  local tmp=$1 mirror=$2 suite=$3 comps=$4 key=${5:-} c u da rel="" ext rp got want; da=$(debarch)
  if [[ -n $key ]]; then
    need_tool gpgv "signed repos"
    fetch_quiet "$mirror/dists/$suite/InRelease" "$tmp/InRelease" || die "no InRelease at $mirror/dists/$suite — can't check the signature"
    gpg_keyring "$key" "$tmp/kr.gpg"
    gpgv --keyring "$tmp/kr.gpg" --output "$tmp/Release" "$tmp/InRelease" 2>/dev/null ||
      die "🚩 signature check FAILED for $mirror ($suite) — not trusting this repo"
    rel="$tmp/Release"; msg2 "signature ok 🔏"
  fi
  for c in $comps; do
    rm -f "$tmp/P" "$tmp/P.xz" "$tmp/P.gz"; rp=""
    for ext in xz gz; do
      if fetch_quiet "$mirror/dists/$suite/$c/binary-$da/Packages.$ext" "$tmp/P.$ext" 2>/dev/null; then rp="$c/binary-$da/Packages.$ext"; break; fi
    done
    [[ -n $rp ]] || { warn "no package index for $suite/$c at $mirror"; continue; }
    if [[ -n $rel ]]; then
      want=$(awk -v f="$rp" '/^SHA256:/ {s=1; next} /^[^ ]/ {s=0} s && $3 == f {print $1; exit}' "$rel")
      got=$(sha256sum "$tmp/P.$ext" | awk '{print $1}')
      [[ -n $want && $got == "$want" ]] || die "🚩 $rp doesn't match the signed Release file — refusing"
    fi
    case $ext in xz) xz -dc "$tmp/P.xz" > "$tmp/P" ;; gz) gzip -dc "$tmp/P.gz" > "$tmp/P" ;; esac
    awk 'BEGIN { RS=""; FS="\n"; OFS="\t" }
    { n=v=f=s=d=pd=ds=pv=""
      for (i=1; i<=NF; i++) { l=$i
        if      (l ~ /^Package: /)     n=substr(l,10)
        else if (l ~ /^Version: /)     v=substr(l,10)
        else if (l ~ /^Filename: /)    f=substr(l,11)
        else if (l ~ /^SHA256: /)      s=substr(l,9)
        else if (l ~ /^Depends: /)     d=substr(l,10)
        else if (l ~ /^Pre-Depends: /) pd=substr(l,14)
        else if (l ~ /^Provides: /)    pv=substr(l,11)
        else if (l ~ /^Description: /) ds=substr(l,14) }
      if (pd != "") d = (d == "" ? pd : pd ", " d)
      out=""; m=split(d, arr, /, */)
      for (j=1; j<=m; j++) { x=arr[j]; sub(/ *\|.*/, "", x); sub(/ *\(.*/, "", x); sub(/:any$/, "", x); gsub(/ /, "", x)
        if (x != "") out = out (out == "" ? "" : ",") x }
      prov=""; m=split(pv, arr, /, */)
      for (j=1; j<=m; j++) { x=arr[j]; sub(/ *\(.*/, "", x); gsub(/ /, "", x); if (x != "") prov = prov (prov == "" ? "" : ",") x }
      gsub(/\t/, " ", ds)
      if (n != "" && f != "") print n, v, f, "sha256:" s, out, ds, prov }' "$tmp/P"
  done
}

sync_rpm() { # src tmp [key]
  local s=$1 tmp=$2 key=${3:-} base href want got
  need_tool python3 "$s"
  base=$(src_base "$s")
  fetch_quiet "$base/repodata/repomd.xml" "$tmp/repomd.xml" || die "can't reach $base"
  if [[ -n $key ]]; then
    need_tool gpgv "signed repos"
    fetch_quiet "$base/repodata/repomd.xml.asc" "$tmp/repomd.xml.asc" || die "$s has no repomd.xml.asc — can't check the signature"
    gpg_keyring "$key" "$tmp/kr.gpg"
    gpgv --keyring "$tmp/kr.gpg" "$tmp/repomd.xml.asc" "$tmp/repomd.xml" 2>/dev/null ||
      die "🚩 signature check FAILED for $s — not trusting this repo"
    msg2 "signature ok 🔏"
  fi
  href=$(awk '/<data type="primary">/ {p=1} p && /<location / { match($0, /href="[^"]+"/); print substr($0, RSTART+6, RLENGTH-7); exit }' "$tmp/repomd.xml")
  [[ -n $href ]] || die "couldn't find primary metadata in $s repomd.xml"
  msg2 "grabbing ${href##*/}"
  download "$base/$href" "$tmp/primary.${href##*.}" 2>&1 | tail -n0 >&2
  if [[ -n $key ]]; then
    want=$(awk '/<data type="primary">/ {p=1} p && /<checksum / { match($0, />[0-9a-f]+</); print substr($0, RSTART+1, RLENGTH-2); exit }' "$tmp/repomd.xml")
    got=$(sha256sum "$tmp/primary.${href##*.}" | awk '{print $1}')
    [[ $got == "$want" ]] || die "🚩 $s primary metadata doesn't match the signed repomd.xml — refusing"
  fi
  case $href in
    *.zst) need_tool zstd "$s"; zstd -qdc "$tmp/primary.zst" > "$tmp/primary.xml" ;;
    *.xz)  xz -dc "$tmp/primary.xz"  > "$tmp/primary.xml" ;;
    *.gz)  gzip -dc "$tmp/primary.gz" > "$tmp/primary.xml" ;;
    *.bz2) bzip2 -dc "$tmp/primary.bz2" > "$tmp/primary.xml" ;;
    *)     mv "$tmp/primary.${href##*.}" "$tmp/primary.xml" ;;
  esac
  python3 - "$tmp/primary.xml" "$CARCH" <<'PY'
import sys, xml.etree.ElementTree as ET
path, want = sys.argv[1], {sys.argv[2], "noarch"}
C = "{http://linux.duke.edu/metadata/common}"; R = "{http://linux.duke.edu/metadata/rpm}"
best = {}
for _, el in ET.iterparse(path):
    if el.tag != C + "package":
        continue
    if el.get("type") != "rpm" or el.findtext(C + "arch") not in want:
        el.clear(); continue
    n = el.findtext(C + "name"); v = el.find(C + "version")
    ep = v.get("epoch")
    ver = (ep + ":" if ep not in (None, "", "0") else "") + v.get("ver") + "-" + v.get("rel")
    ck = el.find(C + "checksum"); algo = ck.get("type"); algo = "sha1" if algo == "sha" else algo
    deps = []
    req = el.find(C + "format/" + R + "requires")
    if req is not None:
        for e in req.findall(R + "entry"):
            nm = e.get("name")
            if nm.startswith(("rpmlib(", "config(", "(")):
                continue
            if ".so" in nm:
                nm = nm.split("(")[0]
            elif "(" in nm:
                continue
            if nm not in deps:
                deps.append(nm)
    prov = []
    pr = el.find(C + "format/" + R + "provides")
    if pr is not None:
        for e in pr.findall(R + "entry"):
            nm = e.get("name")
            if ".so" in nm:
                nm = nm.split("(")[0]
            elif "(" in nm or nm == n:
                continue
            if nm not in prov:
                prov.append(nm)
    summ = (el.findtext(C + "summary") or "").replace("\t", " ").replace("\n", " ")
    best[n] = (n, ver, el.find(C + "location").get("href"), algo + ":" + ck.text, ",".join(deps), summ, ",".join(prov))
    el.clear()
for row in best.values():
    print("\t".join(row))
PY
}

sync_pacman() { # tmp server-template('$repo' '$arch') repos
  local tmp=$1 tpl=$2 repos=$3 r server
  local prog='
    function flush() { if (n != "") print n "\t" v "\t" server "/" f "\tsha256:" s "\t" d "\t" ds "\t" p; n=v=f=s=d=ds=p=""; sec="" }
    FNR == 1 { flush() }
    /^%[A-Z0-9]+%$/ { sec=$0; next }
    /^$/ { sec=""; next }
    sec == "%NAME%"      { n=$0 }
    sec == "%VERSION%"   { v=$0 }
    sec == "%FILENAME%"  { f=$0 }
    sec == "%SHA256SUM%" { s=$0 }
    sec == "%DESC%"      { ds=$0; gsub(/\t/, " ", ds) }
    sec == "%DEPENDS%"   { x=$0
      if (x ~ /\.so=/) { split(x, a, "="); y=a[2]; sub(/-.*/, "", y); x=a[1] "." y } else sub(/[<>=].*/, "", x)
      d = d (d == "" ? "" : ",") x }
    sec == "%PROVIDES%"  { x=$0
      if (x ~ /\.so=/) { split(x, a, "="); y=a[2]; sub(/-.*/, "", y); x=a[1] "." y } else sub(/[<>=].*/, "", x)
      p = p (p == "" ? "" : ",") x }
    END { flush() }'
  for r in $repos; do
    server=${tpl//\$repo/$r}; server=${server//\$arch/$CARCH}
    fetch_quiet "$server/$r.db" "$tmp/$r.db" 2>/dev/null || { warn "couldn't get $r.db from $server"; continue; }
    mkdir -p "$tmp/$r"
    tar -xf "$tmp/$r.db" -C "$tmp/$r" 2>/dev/null || { warn "couldn't open $r.db (install zstd?)"; continue; }
    find "$tmp/$r" -name desc -exec awk -v server="$server" "$prog" {} +
  done
}

# ── dependency smarts: prefer what the host already has / can get natively ──
CORE_RE='^(ncurses|ncurses-libs|ncurses-base|libncurses.*|libtinfo.*|readline|libreadline.*|bzip2-libs|libbz2.*|zlib|zlib1g|zlib-ng.*|openssl-libs|libssl.*|libcrypto.*|xz-libs|liblzma.*|libzstd.*|zstd-libs|libgcc_s1|glibc|glibc-common|glibc-minimal-langpack|libc6|libc-bin|libc|musl|filesystem|base-files|base|setup|systemd|systemd-libs|libsystemd0|libsystemd-shared|udev|libudev1|bash|sh|dash|coreutils|util-linux|shadow|dpkg|rpm|rpm-libs|pacman|zypper|libzypp|dnf|apt|debconf|debconf-2\.0|cdebconf|init-system-helpers|lsb-base|sysvinit-utils|gcc-libs|libgcc|libgcc-s1|libgcc_s1|libgcc1|libstdc\+\+|libstdc\+\+6|tzdata|ca-certificates|perl-base|linux-api-headers|fedora-release.*|openSUSE-release.*|glibc-langpack-.*)$'
LDCACHE=""
ld_has() {
  [[ -n $LDCACHE ]] || LDCACHE=$( { ldconfig -p || /sbin/ldconfig -p; } 2>/dev/null || true)
  local re; re=$(sed 's/[][\.*^$+?(){}|/]/\\&/g' <<<"$1")
  grep -qiE "^[[:space:]]+$re " <<<"$LDCACHE"      # -i: debian says libxss1, the lib is libXss.so.1
}
host_has() {
  local d=$1
  [[ -z $d || $d =~ $CORE_RE ]] && return 0
  case $d in
    /*)           [[ -e $d ]]; return ;;
    *.so|*.so.*)  ld_has "$d"; return ;;
  esac
  pm_has "$d" && return 0
  command -v "$d" >/dev/null 2>&1 && return 0
  # debian lib names encode the soname: libfoo6 → libfoo.so.6, libfoo-1.0-0 → libfoo-1.0.so.0, libfoo6t64 → libfoo.so.6
  local b=${d%t64}
  if [[ $b =~ ^(lib.*[a-z+_])([0-9]+)$ ]] || [[ $b =~ ^(lib.*[0-9])-([0-9]+)$ ]]; then
    ld_has "${BASH_REMATCH[1]}.so.${BASH_REMATCH[2]}" && return 0
  fi
  # some libs keep the number in the name: libnss3 → libnss3.so
  [[ $b == lib* ]] && ld_has "$b.so" && return 0
  # names with an API version baked in: libatspi2.0-0 → libatspi.so.0, libglib2.0-0 → libglib-2.0.so.0
  if [[ $b =~ ^(lib[a-z_+]+)-?([0-9][0-9.]*)-([0-9]+)$ ]]; then
    ld_has "${BASH_REMATCH[1]}.so.${BASH_REMATCH[3]}" && return 0
    ld_has "${BASH_REMATCH[1]}-${BASH_REMATCH[2]}.so.${BASH_REMATCH[3]}" && return 0
  fi
  return 1
}
# does the host's package manager have a package with this exact name?
pm_available() {
  case $PM in
    apt)    apt-cache show "$1" >/dev/null 2>&1 ;;
    dnf)    dnf -q repoquery "$1" 2>/dev/null | grep -q . ;;
    yum)    yum -q info "$1" >/dev/null 2>&1 ;;
    pacman) pacman -Si "$1" >/dev/null 2>&1 || pacman -Sg "$1" >/dev/null 2>&1 ;;
    zypper) zypper -q info "$1" 2>/dev/null | grep -q '^Name' ;;
    apk)    apk search -e "$1" 2>/dev/null | grep -q . ;;
    xbps)   xbps-query -R "$1" >/dev/null 2>&1 ;;
    eopkg)  eopkg info "$1" 2>/dev/null | grep -q '^Name' ;;
    *)      return 1 ;;
  esac
}
# foreign dep name → generic name (reverse deps.map lookup)
rev_map() {
  local m; m=$(depmap_file); [[ -n $m ]] || return 0
  awk -v k="$1" -v d="$2" '
    /^[[:space:]]*#/ || NF == 0 { next }
    { hk=0
      for (i=2; i<=NF; i++) { n=index($i, "=")
        if (substr($i, 1, n-1) == k) { hk=1; c=split(substr($i, n+1), a, ","); for (j=1; j<=c; j++) if (a[j] == d) { print $1; exit } } }
      if (!hk && $1 == d) { print $1; exit } }' "$m"
}

# resolve ONE dependency of a foreign package
foreign_dep() { # src dep
  local src=$1 dep=$2 g nat
  dep=${dep%%[<>=]*}
  [[ -z $dep ]] && return 0
  if [[ $dep =~ $OSPART_RE || $dep =~ $PMLIB_RE || $dep =~ $SYSTOOL_RE ]] && ! host_has "$dep"; then
    warn "not pulling $dep from $src — it's system plumbing (if this app needs it, try: gurt install --box $src/<app>)"; return 0
  fi
  if $NODEPS; then host_has "$dep" || warn "--nodeps: not getting $dep"; return 0; fi
  host_has "$dep" && return 0
  is_installed "$(pkey "$src" "$dep")" && return 0
  g=$(rev_map "$(src_pm "$src")" "$dep")
  if [[ -n $g ]]; then
    nat=$(map_dep "$g")
    if [[ -n $nat ]] && { [[ $(src_pm "$src") == "$PM" ]] || [[ $g != "$dep" ]] || pm_available "$nat"; }; then
      # shellcheck disable=SC2206
      NATIVE_Q+=($nat); return 0
    fi
  fi
  if pm_available "$dep"; then NATIVE_Q+=("$dep"); return 0; fi
  case $src in
    aur)
      if ( ensure_idx pacman ) >/dev/null 2>&1 && [[ -n $(idx_lookup pacman "$dep") ]]; then
        msg2 "pulling $dep from Arch's official repos"; foreign_install pacman "$dep" dep
      else
        msg2 "pulling $dep from the AUR"; aur_install "$dep" dep
      fi ;;
    *)
      local prov
      local fb; fb=$(src_fallback "$src")
      if [[ -n $(idx_lookup "$src" "$dep") ]]; then
        msg2 "pulling $dep from $src (your distro doesn't have it)"; foreign_install "$src" "$dep" dep
      elif [[ $fb != "$src" ]] && ( ensure_idx "$fb" ) >/dev/null 2>&1 && [[ -n $(idx_lookup "$fb" "$dep") ]]; then
        msg2 "pulling $dep from $fb (needed by $src)"; foreign_install "$fb" "$dep" dep
      elif prov=$(idx_provider "$src" "$dep") && [[ -n $prov ]]; then
        host_has "$prov" || is_installed "$(pkey "$src" "$prov")" && return 0
        msg2 "pulling $prov from $src (provides $dep)"; foreign_install "$src" "$prov" dep
      else
        warn "couldn't find dep '$dep' anywhere — skipping it, stuff might break"
      fi ;;
  esac
}

# ── what goes in a box ──
# distro-specific system utilities: need their real distro around them → auto-box
SYSTOOL_RE='^(dnf|dnf5|dnf-.*|dnf5daemon.*|dnfdragora.*|yum|yum-.*|yumex.*|rpm|rpm-.*|zypper|zypper-.*|yast2.*|libzypp|apt|apt-.*|aptitude|synaptic|dpkg|dpkg-.*|debconf.*|pacman|pacman-.*|pamac.*|octopi.*|packagekit.*|gnome-software.*|plasma-discover.*|mint(update|install|sources|backup|drivers|report).*|ubuntu-drivers.*|software-properties.*|update-manager.*|cockpit.*|firewalld.*|firewall-config|system-config-.*|anaconda.*|calamares.*|timeshift|tuned.*|abrt.*)$'
# libraries only package-manager tooling depends on
PMLIB_RE='^(libdnf.*|python3-dnf.*|python3-libdnf.*|dnf-data|libdnf5.*|libzypp.*|libapt-pkg.*|python3-apt|apt-utils|librpm.*|rpm-libs|python3-rpm|libalpm.*|pyalpm|packagekit.*|libpackagekit.*|libyui.*|python3-yui|python3-manatools)$'
# files that mean "this hooks into the system"
SYSFILE_RE='(^|/)lib/systemd/system/|^etc/systemd/system/|(^|/)lib/udev/rules\.d/|^etc/pam\.d/|(^|/)lib/modules/|^etc/sudoers\.d/|^usr/share/polkit-1/actions/|^usr/share/dbus-1/system-services/|^etc/dbus-1/system\.d/'
# the OS itself — a box can't help, use your own distro's
OSPART_RE='^(linux|linux-lts|linux-zen|linux-hardened|linux-image.*|linux-headers.*|kernel|kernel-.*|grub.*|grub2.*|shim.*|systemd|systemd-.*|udev|dracut.*|mkinitcpio.*|initramfs-tools.*|plymouth.*|efibootmgr|refind|syslinux|sysvinit.*|openrc.*|runit.*|.*-firmware|linux-firmware.*|firmware-.*)$'

# should this explicit install go in a box? prints the reason, empty = no
box_reason() { # src name deps files(newline list, may be empty)
  local src=$1 name=$2 deps=$3 files=${4:-} d
  case $src in apt|dnf|zypper|pacman) ;; *) return 0 ;; esac
  [[ $name =~ $SYSTOOL_RE ]] && { echo "it's a system utility for its own distro"; return; }
  local IFS=,; for d in $deps; do [[ ${d%%[<>=]*} =~ $PMLIB_RE ]] && { echo "it needs package-manager internals ($d)"; return; }; done
  if [[ -n $files ]] && grep -qE "$SYSFILE_RE" <<<"$files"; then echo "it installs system services/hooks"; return; fi
  if [[ -n $files && -z $R ]] && [[ -n $(sed 's|^|/|' <<<"$files" | sys_owned) ]]; then echo "it would overwrite files your distro owns"; return; fi
  return 0
}

# system stuff: your distro's own version beats a box, a box beats stomping on your system
system_route() { # src name reason why
  local src=$1 name=$2 reason=$3 why=$4
  if pm_available "$name"; then
    msg "⚙️  $src/$name is system stuff ($why) — your distro has its own $name, installing that instead ($PM)"
    install_native "$name"
    pm_has "$name" && msg "$name installed from $PM ✅" || die "$PM couldn't install $name"
    return 0
  fi
  msg "📦 $src/$name goes in a box — $why"
  box_install "$src" "$name" "$reason"
}

WARNED_FOREIGN=false
foreign_banner() {
  $WARNED_FOREIGN && return 0; WARNED_FOREIGN=true
  msg2 "foreign packages install into /usr like their distro expects. gurt never overwrites files your distro owns, and never touches glibc/systemd/etc 🛡️"
}

# binary package from another distro → .gurt
repack_foreign() { # src name ver path sum deps desc provides
  local src=$1 name=$2 ver=$3 path=$4 sum=$5 deps=$6 desc=$7 prov=${8:-} file algo hash work data
  mkdir -p "$GURT_CACHE/foreign/$src" "$GURT_CACHE/pkg"
  file="$GURT_CACHE/foreign/$src/${path##*/}"
  algo=${sum%%:*}; hash=${sum#*:}; [[ -z $hash ]] && hash=SKIP
  if [[ -f $file ]] && ! verify "$file" "$hash" "$algo"; then rm -f "$file"; fi
  if [[ ! -f $file ]]; then
    msg2 "downloading ${path##*/}"
    local src_url="$path"; [[ $path =~ ^[a-z]+:// ]] || src_url="$(src_base "$src")/$path"
    download "$src_url" "$file.part" && mv "$file.part" "$file"
  fi
  verify "$file" "$hash" "$algo" || { rm -f "$file"; die "checksum mismatch on ${path##*/} 🚩 (mirror out of sync? run: gurt sync $src)"; }
  work=$(mktemp -d "${TMPDIR:-/tmp}/gurt-repack.XXXXXX"); mkdir -p "$work/pkg" "$work/x"
  case $file in
    *.deb)
      extract_any "$file" "$work/x"
      data=$(find "$work/x" -maxdepth 1 -name 'data.tar*' | head -n1)
      [[ -n $data ]] || die "weird .deb, no data.tar inside"
      [[ $data == *.zst ]] && need_tool zstd apt
      tar -xf "$data" -C "$work/pkg" ;;
    *.rpm)
      extract_any "$file" "$work/pkg" ;;
    *.pkg.tar.*)
      [[ $file == *.zst ]] && need_tool zstd pacman
      tar -xf "$file" -C "$work/pkg"
      rm -f "$work/pkg/.PKGINFO" "$work/pkg/.BUILDINFO" "$work/pkg/.MTREE" "$work/pkg/.INSTALL" ;;
    *) die "don't know how to open ${file##*/}" ;;
  esac
  {
    printf 'pkgname = %s\npkgver = %s\npkgdesc = %s\narch = %s\n' "$name" "$ver" "$desc" "$CARCH"
    local d; IFS=, read -ra dl <<<"$deps"; for d in "${dl[@]}"; do [[ -n $d ]] && printf 'depends = %s\n' "$d"; done
    IFS=, read -ra dl <<<"$prov"; for d in "${dl[@]}"; do [[ -n $d ]] && printf 'provides = %s\n' "$d"; done
    printf 'builddate = %s\nprefix = /usr\ngurtsource = %s\nfrom = %s\n' "$(date +%s)" "$src" "${path##*/}"
  } > "$work/.PKGINFO"
  BUILT_PKG="$GURT_CACHE/pkg/$src-$name-${ver//[:\/]/_}.gurt"
  ( cd "$work/pkg" && pack_pkgdir "$work" "$BUILT_PKG" )
  chmod -R u+w "$work" 2>/dev/null; rm -rf "$work"
}

foreign_install() { # src name reason
  local src=$1 name=$2 reason=${3:-dep} key row ver path sum deps desc prov
  key=$(pkey "$src" "$name")
  [[ -n ${VISITED[$key]:-} ]] && return 0
  VISITED[$key]=1
  ensure_idx "$src"
  row=$(idx_lookup "$src" "$name")
  [[ -n $row ]] || die "no package '$name' in $src (try: gurt search $src/$name)"
  local F; tsv "$row"; ver=${F[1]:-}; path=${F[2]:-}; sum=${F[3]:-}; deps=${F[4]:-}; desc=${F[5]:-}; prov=${F[6]:-}
  if is_installed "$key" && ! $FORCE && ! vnewer "$(inst_ver "$key")" "$ver"; then
    [[ $reason == explicit ]] && msg "$(pretty "$key") $(inst_ver "$key") is already installed and up to date 👍"
    return 0
  fi
  if [[ $name =~ $OSPART_RE ]]; then
    die "$src/$name is part of an operating system (kernel/boot/init) — that has to come from YOUR distro, not another one or a box 💀"
  fi
  if [[ $name =~ $CORE_RE ]] && ! $FORCE; then
    die "$src/$name is a core system package — another distro's copy of it would wreck your install 💀"
  fi
  local why=""
  if [[ $reason == explicit ]] && ! $FORCE && ! $BOX && pm_has "$name"; then
    msg "you already have $name from your distro ($PM) 👍 — nothing to do (want $src's version anyway? gurt install --box $src/$name)"; return 0
  fi
  if [[ $reason == explicit ]] && ! $NOBOX; then
    why=$(box_reason "$src" "$name" "$deps")
    if [[ -n $why ]]; then system_route "$src" "$name" "$reason" "$why"; return; fi
  fi
  if [[ $reason == explicit ]]; then
    foreign_banner
    ask "install $src/$name $ver ($desc)?" || die "aborted, no cap"
  fi
  # unpack first so we can look inside before touching anything
  repack_foreign "$src" "$name" "$ver" "$path" "$sum" "$deps" "$desc" "$prov"
  local built=$BUILT_PKG
  if [[ $reason == explicit ]] && ! $NOBOX; then
    why=$(box_reason "$src" "$name" "" "$(tar -xzf "$built" -O .FILES 2>/dev/null || true)")
    if [[ -n $why ]]; then NOCONFIRM=true system_route "$src" "$name" "$reason" "$why"; return; fi
  fi
  local d dl=()
  IFS=, read -ra dl <<<"$deps"
  for d in "${dl[@]}"; do foreign_dep "$src" "$d"; done
  flush_native
  install_file "$built" "$reason"
}

# ── flatpak + snap: they manage their own installs, gurt drives them and remembers what it put there ──
record_meta() { # key name version desc reason source
  local dbd="$DB/$1" tmp; tmp=$(mktemp -d "${TMPDIR:-/tmp}/gurt-meta.XXXXXX")
  printf 'pkgname = %s\npkgver = %s\npkgdesc = %s\ngurtsource = %s\n' "$2" "$3" "$4" "$6" > "$tmp/info"
  : > "$tmp/files"; : > "$tmp/dirs"; echo "$5" > "$tmp/reason"
  asroot mkdir -p "$dbd"
  local f; for f in info files dirs reason; do asroot cp "$tmp/$f" "$dbd/$f"; done
  rm -rf "$tmp"
}

ensure_flatpak() {
  if ! command -v flatpak >/dev/null; then
    $NODEPS && die "flatpak isn't installed (and --nodeps is on)"
    msg "flatpak isn't installed — getting it from your distro"
    # shellcheck disable=SC2046
    install_native $(map_dep flatpak)
    command -v flatpak >/dev/null || die "couldn't install flatpak — install it with your package manager, then try again"
  fi
  if ! flatpak remotes --user --columns=name 2>/dev/null | grep -qx flathub; then
    msg2 "adding Flathub (for your user, no sudo needed)"
    flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || die "couldn't add Flathub"
  fi
}
flatpak_resolve() { # "gimp" or "org.gimp.GIMP" → app id
  local q=$1
  if [[ $q == *.*.* ]]; then echo "$q"; return; fi
  flatpak search --columns=application,name "$q" 2>/dev/null | awk -F'\t' -v q="${q,,}" '
    { id=$1; n=tolower($2); c=split(id, a, "."); last=tolower(a[c])
      if (best == "" && (last == q || n == q)) best=id
      if (first == "") first=id }
    END { print (best != "" ? best : first) }'
}
flatpak_install() { # name reason
  ensure_flatpak
  local id; id=$(flatpak_resolve "$1")
  [[ -n $id ]] || die "nothing on Flathub matches '$1' (try: gurt search flatpak/$1)"
  local key="flatpak:$id"
  if is_installed "$key" && ! $FORCE; then
    [[ ${2:-explicit} == explicit ]] && msg "$(pretty "$key") is already installed — flatpak updates it with: gurt upgrade 👍"
    return 0
  fi
  [[ ${2:-explicit} == explicit ]] && { ask "install $id from Flathub?" || die "aborted, no cap"; }
  msg "installing $id from Flathub 📦"
  flatpak install --user -y --noninteractive flathub "$id" || die "flatpak couldn't install $id"
  local ver; ver=$(flatpak info --user "$id" 2>/dev/null | awk -F': *' '/^ *Version:/ {print $2; exit}')
  record_meta "$key" "$id" "${ver:-latest}" "Flathub app" "${2:-explicit}" flatpak
  msg "$(pretty "$key") installed ✅  (it's in your app menu, or run: flatpak run $id)"
}

ensure_snap() {
  command -v snap >/dev/null && return 0
  $NODEPS && die "snap isn't installed (and --nodeps is on)"
  msg "snap isn't installed — setting up snapd"
  case $PM in
    apt)
      [[ -f /etc/apt/preferences.d/nosnap.pref ]] &&
        die "your distro blocks snap on purpose (Linux Mint does this). to allow it: sudo rm /etc/apt/preferences.d/nosnap.pref && sudo apt update — then try again"
      install_native snapd ;;
    pacman) msg2 "snapd isn't in Arch's repos — building it from the AUR"; aur_install snapd dep ;;
    dnf|yum|zypper|xbps|eopkg) install_native snapd ;;
    *) die "install snapd with your package manager first" ;;
  esac
  command -v snap >/dev/null || die "snapd didn't install right"
  if command -v systemctl >/dev/null; then
    asroot systemctl enable --now snapd.socket 2>/dev/null || true
    asroot systemctl enable --now snapd.apparmor.service 2>/dev/null || true
  fi
  [[ -e /snap ]] || asroot ln -s /var/lib/snapd/snap /snap 2>/dev/null || true
  warn "first time using snap: if it acts weird, log out and back in (or reboot) once"
}
snap_install() { # name reason
  local name=$1 key="snap:$1" out
  ensure_snap
  if is_installed "$key" && ! $FORCE; then
    [[ ${2:-explicit} == explicit ]] && msg "$(pretty "$key") is already installed — snap updates it with: gurt upgrade 👍"
    return 0
  fi
  [[ ${2:-explicit} == explicit ]] && { ask "install $name from the Snap Store?" || die "aborted, no cap"; }
  msg "installing $name from the Snap Store 📦"
  if ! out=$(asroot snap install "$name" 2>&1); then
    if grep -qi 'classic' <<<"$out"; then
      warn "$name needs 'classic' mode — that means it runs WITHOUT snap's sandbox (full access, like a normal app)"
      ask "install $name in classic mode?" || die "aborted"
      asroot snap install --classic "$name" || die "snap couldn't install $name"
    else
      printf '%s\n' "$out" >&2; die "snap couldn't install $name"
    fi
  fi
  local ver; ver=$(snap list "$name" 2>/dev/null | awk 'NR == 2 {print $2}')
  record_meta "$key" "$name" "${ver:-latest}" "Snap Store app" "${2:-explicit}" snap
  msg "$(pretty "$key") installed ✅"
}

# search helpers (use the CLI if you have it, else the public store APIs)
flatpak_search() {
  if command -v flatpak >/dev/null && flatpak remotes --columns=name 2>/dev/null | grep -qx flathub; then
    flatpak search --columns=application,version,description "$1" 2>/dev/null | head -n 30 | awk -F'\t' '{ print $1 "\t" $2 "\t\t\t\t" $3 }'
  else
    need_tool python3 flatpak
    local t; t=$(mktemp)
    curl -fsSL -m 20 -H 'Content-Type: application/json' -d "{\"query\": $(python3 -c 'import json,sys; print(json.dumps(sys.argv[1]))' "$1")}" \
      https://flathub.org/api/v2/search > "$t" 2>/dev/null || { rm -f "$t"; return 1; }
    python3 - "$t" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
for h in (d.get("hits") or [])[:30]:
    print("\t".join([h.get("app_id", ""), "", "", "", "", (h.get("summary") or "").replace("\t", " ")]))
PY
    rm -f "$t"
  fi
}
snap_search() {
  if command -v snap >/dev/null; then
    snap find "$1" 2>/dev/null | awk 'NR > 1 { n=$1; v=$2; $1=$2=$3=$4=""; sub(/^ +/, ""); print n "\t" v "\t\t\t\t" $0 }' | head -n 30
  else
    need_tool python3 snap
    local t; t=$(mktemp)
    curl -fsSL -m 20 -H 'Snap-Device-Series: 16' "https://api.snapcraft.io/v2/snaps/find?q=$(urlenc "$1")&fields=title,summary,version" > "$t" 2>/dev/null || { rm -f "$t"; return 1; }
    python3 - "$t" <<'PY'
import json, sys
d = json.load(open(sys.argv[1]))
for r in (d.get("results") or [])[:30]:
    s = r.get("snap") or {}
    print("\t".join([r.get("name", ""), (s.get("version") or ""), "", "", "", (s.get("summary") or "").replace("\t", " ")]))
PY
    rm -f "$t"
  fi
}

# ── boxes: the REAL distro in a container (podman/docker + distrobox) — for system tools & stubborn apps ──
box_name()  { case $1 in apt) echo gurt-debian ;; dnf) echo gurt-fedora ;; zypper) echo gurt-opensuse ;; pacman) echo gurt-arch ;; esac; }
box_image() {
  case $1 in
    apt)    if [[ $APT_MIRROR == *ubuntu* ]]; then echo "docker.io/library/ubuntu:${APT_SUITE:-latest}"; else echo docker.io/library/debian:stable; fi ;;
    dnf)    echo "registry.fedoraproject.org/fedora:$(sed -n 's|.*/releases/\([0-9]*\)/.*|\1|p' <<<"$DNF_MIRROR" | grep . || echo latest)" ;;
    zypper) echo registry.opensuse.org/opensuse/tumbleweed:latest ;;
    pacman) echo docker.io/library/archlinux:latest ;;
  esac
}
box_cmd() { # src action [pkg]
  local s=$1 a=$2 p=${3:-}
  case $s:$a in
    apt:install)    echo "sudo apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get install -y '$p'" ;;
    apt:remove)     echo "sudo apt-get remove -y '$p'" ;;
    apt:files)      echo "dpkg -L '$p'" ;;
    apt:upgrade)    echo "sudo apt-get update && sudo DEBIAN_FRONTEND=noninteractive apt-get upgrade -y" ;;
    dnf:install)    echo "sudo dnf install -y '$p'" ;;
    dnf:remove)     echo "sudo dnf remove -y '$p'" ;;
    dnf:files|zypper:files) echo "rpm -ql '$p'" ;;
    dnf:upgrade)    echo "sudo dnf upgrade -y" ;;
    zypper:install) echo "sudo zypper -n install '$p'" ;;
    zypper:remove)  echo "sudo zypper -n remove '$p'" ;;
    zypper:upgrade) echo "sudo zypper -n dup" ;;
    pacman:install) echo "sudo pacman -Syu --noconfirm '$p'" ;;
    pacman:remove)  echo "sudo pacman -Rns --noconfirm '$p'" ;;
    pacman:files)   echo "pacman -Qlq '$p'" ;;
    pacman:upgrade) echo "sudo pacman -Syu --noconfirm" ;;
  esac
}
ensure_box_tools() {
  local need=()
  command -v podman >/dev/null || command -v docker >/dev/null || need+=(podman)
  command -v distrobox >/dev/null || need+=(distrobox)
  if (( ${#need[@]} )); then
    $NODEPS && die "boxes need ${need[*]} (and --nodeps is on)"
    msg "boxes need ${need[*]} — getting them from your distro"
    install_native "${need[@]}"
  fi
  command -v distrobox >/dev/null || die "couldn't get distrobox — install it with your package manager, then try again"
}
ensure_box() { # src
  local n; n=$(box_name "$1")
  distrobox list 2>/dev/null | awk -F'|' '{gsub(/ /, "", $2); print $2}' | grep -qx "$n" && return 0
  msg "creating the $n box ($(box_image "$1")) — first time takes a minute ☕"
  distrobox create --yes --name "$n" --image "$(box_image "$1")" || die "couldn't create the $n box"
}
box_install() { # src pkg reason
  local src=$1 pkg=$2 reason=${3:-explicit} n key="box-$1:$2" files f exported=()
  n=$(box_name "$src")
  if is_installed "$key" && ! $FORCE; then
    [[ $reason == explicit ]] && msg "$(pretty "$key") is already installed — gurt upgrade keeps the box updated 👍"
    return 0
  fi
  ensure_box_tools
  [[ $reason == explicit ]] && { ask "install $pkg with the real ${src} inside a $n container?" || die "aborted, no cap"; }
  ensure_box "$src"
  msg "installing $pkg inside $n 📦"
  distrobox enter "$n" -- sh -c "$(box_cmd "$src" install "$pkg")" || die "$src couldn't install $pkg inside the box"
  files=$(distrobox enter "$n" -- sh -c "$(box_cmd "$src" files "$pkg")" 2>/dev/null || true)
  # apps → your app menu, commands → ~/.local/bin
  while IFS= read -r f; do
    [[ $f == /usr/share/applications/*.desktop ]] || continue
    distrobox enter "$n" -- distrobox-export --app "$f" >/dev/null 2>&1 && exported+=("app:$f") && msg2 "added $(basename "$f" .desktop) to your app menu"
  done <<<"$files"
  while IFS= read -r f; do
    [[ $f =~ ^/usr/s?bin/[^/]+$ ]] || continue
    (( ${#exported[@]} > 40 )) && break
    distrobox enter "$n" -- distrobox-export --bin "$f" --export-path "$HOME/.local/bin" >/dev/null 2>&1 && exported+=("bin:$f") && msg2 "command: $(basename "$f")"
  done <<<"$files"
  local tmp; tmp=$(mktemp -d "${TMPDIR:-/tmp}/gurt-box.XXXXXX")
  { printf 'pkgname = %s\npkgver = box\npkgdesc = %s inside the %s container\ngurtsource = box-%s\nbox = %s\n' "$pkg" "$pkg" "$n" "$src" "$n"
    for f in "${exported[@]}"; do printf 'export = %s\n' "$f"; done; } > "$tmp/info"
  : > "$tmp/files"; : > "$tmp/dirs"; echo "$reason" > "$tmp/reason"
  asroot mkdir -p "$DB/$key"; for f in info files dirs reason; do asroot cp "$tmp/$f" "$DB/$key/$f"; done; rm -rf "$tmp"
  (( ${#exported[@]} )) || warn "$pkg didn't have any apps or commands to export — use it with: distrobox enter $n"
  [[ ":$PATH:" == *":$HOME/.local/bin:"* ]] || warn "$HOME/.local/bin isn't in your PATH — add this to ~/.bashrc:  export PATH=\"\$HOME/.local/bin:\$PATH\""
  msg "$(pretty "$key") installed ✅ (it runs inside $n, so it can't touch your real system's files)"
}
box_remove() { # key
  local key=$1 src pkg n e
  src=${key%%:*}; src=${src#box-}; pkg=${key#*:}; n=$(box_name "$src")
  msg "removing $(pretty "$key")"
  if command -v distrobox >/dev/null; then
    while IFS= read -r e; do
      case $e in
        app:*) distrobox enter "$n" -- distrobox-export --app "${e#app:}" --delete >/dev/null 2>&1 || true ;;
        bin:*) distrobox enter "$n" -- distrobox-export --bin "${e#bin:}" --export-path "$HOME/.local/bin" --delete >/dev/null 2>&1 || true ;;
      esac
    done < <(info_get "$DB/$key/info" export)
    distrobox enter "$n" -- sh -c "$(box_cmd "$src" remove "$pkg")" || warn "couldn't uninstall it inside $n"
  fi
  asroot rm -rf -- "$DB/$key"
  msg "$(pretty "$key") removed 🗑️ (the $n box itself stays — delete it with: distrobox rm $n)"
}

# ── DIRT: opt-in section for mature packages (18+). off by default, never on the website ──
DIRT_FLAG="${XDG_CONFIG_HOME:-$HOME/.config}/gurt/dirt-enabled"
dirt_on() { [[ -f $DIRT_FLAG ]]; }
dirt_install() { # name reason
  dirt_on || die "DIRT is off 🔒 — it's the mature section. turn it on with: gurt dirt on (18+ only)"
  ensure_repo
  [[ -d $GURT_REPO_DIR/dirt ]] || die "DIRT is empty right now"
  PKG_TREE=dirt TREE_SRC=dirt resolve_and_install "$1" "${2:-explicit}"
}
cmd_dirt() {
  case ${1:-status} in
    on|enable)
      dirt_on && { msg "DIRT is already on"; return 0; }
      printf '%s⚠️  DIRT is the mature section of GURT — packages with mature/explicit themes.%s\n' "$YLW" "$R0" >&2
      printf '%s::%s are you 18 or older? type "yes" to turn it on: ' "$MAG" "$R0" >&2
      local a; { read -r a 2>/dev/null </dev/tty; } 2>/dev/null || read -r a || a=""
      [[ ${a,,} == yes ]] || die "DIRT stays off 👍"
      mkdir -p "$(dirname "$DIRT_FLAG")"; date +%s > "$DIRT_FLAG"
      msg "DIRT is on for your user. install with: gurt install dirt/<name> · list: gurt dirt list · off: gurt dirt off" ;;
    off|disable) rm -f "$DIRT_FLAG"; msg "DIRT is off 🔒 (already-installed DIRT packages stay until you remove them)" ;;
    status) if dirt_on; then msg "DIRT is on"; else msg "DIRT is off 🔒 (gurt dirt on — 18+ only)"; fi ;;
    list|ls)
      dirt_on || die "DIRT is off 🔒 (gurt dirt on — 18+ only)"
      ensure_repo
      PKG_TREE=dirt TREE_SRC=dirt search_main "" || msg "DIRT is empty right now" ;;
    *) die "usage: gurt dirt [on|off|status|list]" ;;
  esac
}

# ── --scanrepos: find a package everywhere, then pick ──
pm_version() { # what version would your distro install?
  case $PM in
    apt)    apt-cache policy "$1" 2>/dev/null | awk '/Candidate:/ {print $2; exit}' ;;
    pacman) pacman -Si "$1" 2>/dev/null | awk -F': ' '/^Version/ {print $2; exit}' ;;
    dnf|yum) dnf -q info "$1" 2>/dev/null | awk -F': ' '/^Version/ {v=$2} /^Release/ {print v "-" $2; exit}' ;;
    zypper) zypper -q info "$1" 2>/dev/null | awk -F': ' '/^Version/ {print $2; exit}' ;;
    *)      true ;;
  esac
}
SCAN_HITS=()   # "rank|source|name|version|note"
scan_add() { SCAN_HITS+=("$1|$2|$3|${4:-?}|${5:-}"); }
scan_sources() { # name
  local q=$1 lo=${1,,} row v s F
  SCAN_HITS=()
  msg "scanning every repo for '$q' 🔍"
  # 1. Main GURT
  if [[ -d $GURT_REPO_DIR/packages ]] || ( sync_main ) >/dev/null 2>&1; then
    local gq="$q" real
    if ! is_gurt_pkg "$gq" && real=$(alias_lookup "$gq"); then gq=$real; fi
    if is_gurt_pkg "$gq"; then
      local via; via=$(info_get "$(repo_info "$gq")" via_type)
      scan_add 1 gurt "$gq" "$(repo_ver "$gq")" "Main GURT${via:+ (official $via)}"
    fi
  fi
  # 2. your own distro
  if [[ $PM != none ]] && pm_available "$q"; then
    scan_add 2 native "$q" "$(pm_version "$q" || true)" "your distro's own package — usually the best pick"
  fi
  # 3. Flathub
  if command -v flatpak >/dev/null || command -v python3 >/dev/null; then
    row=$(flatpak_search "$q" 2>/dev/null | awk -F'\t' -v q="$lo" '{ c=split($1, a, "."); if (tolower(a[c]) == q) { print; exit } }' || true)
    [[ -n $row ]] && { tsv "$row"; scan_add 3 flatpak "${F[0]}" "${F[1]:-latest}" "Flathub — sandboxed"; }
  fi
  # 4. AUR
  row=$(aur_info "$q" 2>/dev/null | head -n1 || true)
  [[ -n $row ]] && { tsv "$row"; scan_add 4 aur "$q" "${F[1]}" "AUR — built from source"; }
  # 5/6. binary repos (same family as you first) + your custom repos
  for s in apt dnf zypper pacman $(custom_repos); do
    is_binary_src "$s" || continue
    ( ensure_idx "$s" ) >/dev/null 2>&1 || continue
    row=$(idx_lookup "$s" "$q" || true)
    [[ -n $row ]] || continue
    tsv "$row"
    if [[ $(src_pm "$s") == "$PM" ]]; then
      printf '%s\n' "${SCAN_HITS[@]}" | grep -q '^2|native|' && continue   # same thing as "your distro"
      scan_add 5 "$s" "$q" "${F[1]}" "binary, same family as your distro"
    elif [[ " apt dnf zypper pacman " == *" $s "* ]]; then scan_add 6 "$s" "$q" "${F[1]}" "binary from another distro"
    else scan_add 5 "$s" "$q" "${F[1]}" "your custom repo"; fi
  done
  # 7. Snap Store
  row=$(snap_search "$q" 2>/dev/null | awk -F'\t' -v q="$lo" 'tolower($1) == q { print; exit }' || true)
  [[ -n $row ]] && { tsv "$row"; scan_add 7 snap "$q" "${F[1]:-latest}" "Snap Store"; }
  mapfile -t SCAN_HITS < <(printf '%s\n' "${SCAN_HITS[@]}" | sed '/^$/d' | sort -t'|' -k1,1n)
}
scan_install() { # name
  local q=$1 i h pick
  scan_sources "$q"
  (( ${#SCAN_HITS[@]} )) || die "'$q' isn't in ANY repo gurt knows 😔 (try: gurt search -a $q)"
  printf '\n%sfound %s in %d place(s):%s\n' "$B" "$q" "${#SCAN_HITS[@]}" "$R0" >&2
  for i in "${!SCAN_HITS[@]}"; do
    IFS='|' read -r _ s n v note <<<"${SCAN_HITS[$i]}"
    printf '  %s%2d)%s %-26s %s%-18s%s %s\n' "$B" $((i + 1)) "$R0" "$( [[ $s == native ]] && echo "$n (your $PM)" || echo "$s/$n")" "$GRN" "$v" "$R0" "$note" >&2
  done
  if $NOCONFIRM; then pick=1
  else
    printf '%s::%s pick one [1-%d] (enter = 1, q = cancel): ' "$MAG" "$R0" "${#SCAN_HITS[@]}" >&2
    { read -r pick 2>/dev/null </dev/tty; } 2>/dev/null || read -r pick || pick=q
    [[ -z $pick ]] && pick=1
  fi
  [[ $pick =~ ^[0-9]+$ ]] && (( pick >= 1 && pick <= ${#SCAN_HITS[@]} )) || die "cancelled"
  IFS='|' read -r _ s n _ _ <<<"${SCAN_HITS[$((pick - 1))]}"
  if [[ $s == native ]]; then
    msg "installing $n from your distro ($PM)"; pm_install "$n"
  else
    local was=$NOCONFIRM; [[ $s == gurt ]] || NOCONFIRM=true   # you already picked — gurt recipes still show their build script
    install_any "$s/$n" explicit
    NOCONFIRM=$was
  fi
}

# ── AUR ──
aur_rpc() { local t; t=$(mktemp); fetch_quiet "$AUR_URL/rpc/v5/$1" "$t" 2>/dev/null || { rm -f "$t"; return 1; }; cat "$t"; rm -f "$t"; }
urlenc() { python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1], safe=""))' "$1" 2>/dev/null || echo "$1"; }
# rows: name \t version \t pkgbase \t description \t outofdate
aur_rows() {
  python3 -c '
import sys, json
d = json.load(sys.stdin)
if d.get("type") == "error": sys.exit("aur says: " + d.get("error", "?"))
want = sys.argv[1] if len(sys.argv) > 1 else None
for r in sorted(d.get("results", []), key=lambda r: -(r.get("Popularity") or 0))[:60]:
    if want and r["Name"] != want: continue
    print("\t".join([r["Name"], r["Version"], r.get("PackageBase") or r["Name"],
                     (r.get("Description") or "").replace("\t", " "), "1" if r.get("OutOfDate") else ""]))' "$@"
}
aur_search() { need_tool python3 aur; aur_rpc "search/$(urlenc "$1")?by=name-desc" | aur_rows; }
aur_info()   { command -v python3 >/dev/null || return 1; aur_rpc "info?arg%5B%5D=$(urlenc "$1")" | aur_rows "$1" 2>/dev/null; }
srcinfo_get() { awk -v k="$2" '{ sub(/^[ \t]+/, "") } index($0, k " = ") == 1 { print substr($0, length(k) + 4) }' "$1"; }
aur_srcinfo_ver() {
  local f=$1 e v r
  e=$(srcinfo_get "$f" epoch | head -n1); v=$(srcinfo_get "$f" pkgver | head -n1); r=$(srcinfo_get "$f" pkgrel | head -n1)
  echo "${e:+$e:}$v-$r"
}
aur_clone() { # name -> prints dir
  local name=$1 base=$1 row dir
  row=$(aur_info "$name" | head -n1) && [[ -n $row ]] && base=$(cut -f3 <<<"$row")
  dir="$GURT_CACHE/aur/$base"
  if [[ -d $dir/.git ]]; then git -C "$dir" pull -q --ff-only >&2 || { rm -rf "$dir"; git clone -q "$AUR_URL/$base.git" "$dir" >&2; }
  else mkdir -p "$GURT_CACHE/aur"; git clone -q "$AUR_URL/$base.git" "$dir" >&2 2>/dev/null || true; fi
  [[ -f $dir/PKGBUILD ]] || { rm -rf "$dir"; return 1; }
  echo "$dir"
}

aur_install() { # name reason
  local name=$1 reason=${2:-dep} key="aur:$1" dir ver d
  [[ -n ${VISITED[$key]:-} ]] && return 0
  VISITED[$key]=1
  need_tool git aur
  msg "fetching aur/$name"
  dir=$(aur_clone "$name") || die "no AUR package called '$name' (try: gurt search aur/$name)"
  [[ -f $dir/.SRCINFO ]] || die "aur/$name has no .SRCINFO (broken AUR package?)"
  ver=$(aur_srcinfo_ver "$dir/.SRCINFO")
  if is_installed "$key" && ! $FORCE && ! vnewer "$(inst_ver "$key")" "$ver"; then
    [[ $reason == explicit ]] && msg "aur/$name $(inst_ver "$key") is already installed and up to date 👍"
    return 0
  fi
  # base-devel is assumed on Arch — bring the equivalent
  # shellcheck disable=SC2207
  NATIVE_Q+=($(map_dep cc) $(map_dep make))
  for d in $(srcinfo_get "$dir/.SRCINFO" depends; srcinfo_get "$dir/.SRCINFO" makedepends
             srcinfo_get "$dir/.SRCINFO" "depends_$CARCH"; srcinfo_get "$dir/.SRCINFO" "makedepends_$CARCH"); do
    foreign_dep aur "$d"
  done
  flush_native
  if ! $NOCONFIRM; then
    printf '\n%s──── aur/%s/PKGBUILD ────%s\n' "$B" "$name" "$R0" >&2
    cat "$dir/PKGBUILD" >&2
    printf '%s───────────────────────%s\n' "$B" "$R0" >&2
    ask "this is a random PKGBUILD from the AUR — read it? build + install aur/$name $ver?" || die "aborted, no cap"
  fi
  GURT_SRC=aur WANT_PKG=$name build_pkg "$dir" "$GURT_CACHE/pkg"
  install_file "$BUILT_PKG" "$reason"
}

# ───────────────────────── rollback / hold ─────────────────────────
# every package gurt installs gets a copy in ~/.cache/gurt/rollback/<pkg>/ (last 3 versions)
ROLLBACK_KEEP=${GURT_ROLLBACK_KEEP:-3}
stash_pkg() { # key file → prints the stashed path
  local d="$GURT_CACHE/rollback/${1//\//_}" out
  mkdir -p "$d" 2>/dev/null || { echo "$2"; return 0; }
  out="$d/$(basename "$2")"
  [[ $2 -ef $out ]] || cp -f -- "$2" "$out" 2>/dev/null || { echo "$2"; return 0; }
  touch "$out"
  # shellcheck disable=SC2012
  ls -1t "$d"/*.gurt 2>/dev/null | tail -n +$((ROLLBACK_KEEP + 1)) | while IFS= read -r x; do rm -f -- "$x"; done
  echo "$out"
}
cmd_rollback() {
  local k cur d f pick="" list=()
  k=$(resolve_key "${1:?usage: gurt rollback <pkg>}") || die "$1 isn't installed"
  case $k in flatpak:*|snap:*|box-*) die "$(pretty "$k") is managed by ${k%%:*} — roll it back there" ;; esac
  d="$GURT_CACHE/rollback/${k//\//_}"
  cur=$(cat "$DB/$k/pkgfile" 2>/dev/null || true)
  # shellcheck disable=SC2012
  mapfile -t list < <(ls -1t "$d"/*.gurt 2>/dev/null)
  for f in "${list[@]}"; do [[ $f -ef $cur ]] || { pick=$f; break; }; done
  [[ -n $pick ]] || die "no older version of $(pretty "$k") saved 😔 (gurt keeps the last $ROLLBACK_KEEP versions it installs, starting from 0.13.0)"
  local v; v=$(tar -xzOf "$pick" .PKGINFO 2>/dev/null | awk -F' = ' '$1=="pkgver"{v=$2} $1=="pkgrel"{r=$2} END{print v (r ? "-" r : "")}')
  ask "roll $(pretty "$k") back $(inst_ver "$k") -> $v?" || die "aborted"
  install_file "$pick" "$(cat "$DB/$k/reason" 2>/dev/null || echo explicit)"
  echo held | asroot tee "$DB/$k/held" >/dev/null
  msg2 "held at $v so gurt upgrade won't undo it 📌 (gurt unhold $(pretty "$k") when you want updates again)"
}
cmd_hold() { local k; for p in "$@"; do k=$(resolve_key "$p") || die "$p isn't installed"; echo held | asroot tee "$DB/$k/held" >/dev/null; msg "$(pretty "$k") held 📌 — upgrade will skip it"; done; }
cmd_unhold() { local k; for p in "$@"; do k=$(resolve_key "$p") || die "$p isn't installed"; asroot rm -f "$DB/$k/held"; msg "$(pretty "$k") unheld — back to getting updates"; done; }
is_held() { [[ -f $DB/$1/held ]]; }

# ───────────────────────── export / import ─────────────────────────
# a plain text list of what you installed on purpose → reinstall it all on another machine
cmd_export() {
  local d k out=${1:--}
  {
    echo "# gurt export — $(date +%F) — reinstall with: gurt import <this file>"
    for d in "$DB"/*/; do
      [[ -d $d ]] || continue; k=$(basename "$d")
      [[ $(cat "$d/reason" 2>/dev/null) == explicit ]] || continue
      if [[ $k == git:* ]]; then echo "outsource $(info_get "$d/info" outsource_url)"
      else pretty "$k"; fi
    done
  } > "$( [[ $out == - ]] && echo /dev/stdout || echo "$out")"
  [[ $out == - ]] || msg "saved your package list to $out 📋 — on the other machine: gurt import $out"
}
cmd_import() {
  local f=${1:?usage: gurt import <file>} line specs=() ok=0 bad=()
  [[ -r $f ]] || die "can't read $f"
  while IFS= read -r line; do
    line=${line%%#*}; line=$(echo "$line" | xargs 2>/dev/null || true)
    [[ -n $line ]] && specs+=("$line")
  done < "$f"
  (( ${#specs[@]} )) || die "$f has no packages in it"
  printf '  %s\n' "${specs[@]}" >&2
  ask "install these ${#specs[@]} package(s)?" || die "aborted"
  local was=$NOCONFIRM; NOCONFIRM=true
  for line in "${specs[@]}"; do
    if [[ $line == outsource\ * ]]; then ( outsource_install "${line#outsource }" explicit ) && ok=$((ok+1)) || bad+=("$line")
    else ( install_any "$line" explicit ) && ok=$((ok+1)) || bad+=("$line"); fi
  done
  NOCONFIRM=$was
  msg "imported $ok/${#specs[@]} ✅"
  (( ${#bad[@]} )) && { warn "these didn't work:"; printf '   %s\n' "${bad[@]}" >&2; return 1; }
  return 0
}

# ───────────────────────── tab completion helper ─────────────────────────
# gurt __complete installed|available|commands  (used by the bash/zsh/fish completions)
cmd_complete() {
  local d f
  case ${1:-} in
    installed) for d in "$DB"/*/; do [[ -d $d ]] && pretty "$(basename "$d")"; done ;;
    available) for f in "$GURT_REPO_DIR"/packages/*/.gurtinfo; do [[ -f $f ]] || continue
                 info_get "$f" pkgname; awk -F' = ' '$1=="alias"{print $2}' "$f"; done ;;
    commands)  printf '%s\n' sync search info install update upgrade self-update remove autoremove list files owns \
                 build add srcinfo checksum new repo dirt gui outsource rollback hold unhold export import completions doctor version help yo ;;
    sources)   printf '%s/\n' aur apt dnf zypper pacman flatpak snap dirt ;;
  esac
  return 0
}

# ───────────────────────── gurt gui ─────────────────────────
# a local app window (python3 + your browser, nothing else to install). server only listens on 127.0.0.1
gui_script() {
  local self d f
  self=$(readlink -f "$0"); d=$(dirname "$self")
  for f in "$d/../share/gurt/gurt-gui.py" /usr/local/share/gurt/gurt-gui.py /usr/share/gurt/gurt-gui.py "$GURT_REPO_DIR/gui/gurt-gui.py"; do
    [[ -f $f ]] && { echo "$f"; return 0; }
  done
  return 1
}
gui_desktop_entry() { # add "GURT" to your app menu (just for you, no sudo)
  (( EUID == 0 )) && return 0
  local data="${XDG_DATA_HOME:-$HOME/.local/share}" icon="$GURT_REPO_DIR/site/assets/apple-touch-icon.png"
  mkdir -p "$data/applications" "$data/icons/hicolor/256x256/apps" 2>/dev/null || return 0
  [[ -f $icon ]] && cp -f "$icon" "$data/icons/hicolor/256x256/apps/gurt.png" 2>/dev/null
  printf '%s\n' "[Desktop Entry]" "Type=Application" "Name=GURT" "GenericName=Package Manager" \
    "Comment=every distro's packages, on every distro" "Exec=$(readlink -f "$0") gui" "Icon=gurt" "Terminal=false" "StartupWMClass=gurt" \
    "Categories=System;PackageManager;" "Keywords=packages;install;aur;apt;flatpak;" > "$data/applications/gurt.desktop"
}
gui_setup() { # install what a real app window needs (GTK + WebKit for python) from your distro
  local pkgs
  # shellcheck disable=SC2207
  pkgs=($(map_dep gui-webview))
  if [[ ${pkgs[*]} == gui-webview ]]; then   # older deps.map → built-in list
    case $PM in
      pacman) pkgs=(python-gobject webkit2gtk-4.1) ;;  apt) pkgs=(python3-gi gir1.2-webkit2-4.1) ;;
      dnf|yum) pkgs=(python3-gobject webkit2gtk4.1) ;; zypper) pkgs=(python3-gobject-Gdk typelib-1_0-WebKit2-4_1) ;;
      *) pkgs=() ;;
    esac
  fi
  (( ${#pkgs[@]} )) || die "don't know the app-window packages for $PM yet — install python GObject + WebKit2GTK yourself (or pywebview)"
  msg "installing the app window bits from $PM: ${pkgs[*]}"
  ask "install ${pkgs[*]}?" || die "aborted"
  install_native "${pkgs[@]}"
  if python3 "$1" --probe >/dev/null 2>&1; then msg "done ✅ gurt gui opens as a real app now 🖥️"
  else warn "installed, but python still can't open an app window — log out and back in, then try gurt gui again"; fi
}
cmd_gui() {
  command -v python3 >/dev/null || die "gurt gui needs python3 (install it from your distro)"
  [[ -d $GURT_REPO_DIR/.git ]] || sync_main >/dev/null
  local py; py=$(gui_script) || { sync_main >/dev/null; py=$(gui_script) || die "couldn't find gurt-gui.py (try: gurt sync)"; }
  gui_desktop_entry
  if [[ ${1:-} == --setup ]]; then gui_setup "$py"; return; fi
  if ! python3 "$py" --probe >/dev/null 2>&1 && [[ -t 0 && -t 1 ]]; then
    msg2 "tip: for a real app window instead of a browser tab, run: gurt gui --setup"
  fi
  msg "opening GURT 🦆 (close the window to quit)"
  exec python3 "$py" --gurt "$(readlink -f "$0")" "$@"
}

# ───────────────────────── outsource: build any git repo ─────────────────────────
# gurt outsource https://github.com/you/thing   → clone, build, install (tracked, so gurt remove/upgrade work)
# uses the repo's own GURTBUILD, then its PKGBUILD, then guesses: make / cmake / meson / cargo / go
norm_git_url() {
  local u=$1
  case $u in
    git@*|http://*|https://*|git://*|ssh://*|file://*) ;;
    github.com/*|gitlab.com/*|codeberg.org/*) u="https://$u" ;;
    */*) [[ $u =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] && u="https://github.com/$u" || die "that doesn't look like a git url: $1" ;;
    *) die "that doesn't look like a git url: $1 (try: gurt outsource https://github.com/user/repo)" ;;
  esac
  u=${u%/}; u=${u%.git}
  echo "$u"
}
os_build_kind() { # dir → make|cmake|meson|cargo|go|autotools
  local d=$1
  if   [[ -f $d/CMakeLists.txt ]]; then echo cmake
  elif [[ -f $d/meson.build ]]; then echo meson
  elif [[ -f $d/Cargo.toml ]]; then echo cargo
  elif [[ -f $d/go.mod ]]; then echo go
  elif [[ -x $d/configure || -f $d/configure.ac || -f $d/autogen.sh ]]; then echo autotools
  elif [[ -f $d/Makefile || -f $d/makefile || -f $d/GNUmakefile ]]; then echo make
  else return 1; fi
}
# write a GURTBUILD for a repo that doesn't have one
os_gen_recipe() { # dir name url sha kind ver → GURTBUILD in dir/.gurt-outsource/
  local dir=$1 name=$2 url=$3 sha=$4 kind=$5 ver=$6 out="$1/.gurt-outsource" md="cc make" b p
  mkdir -p "$out"
  case $kind in
    make)      b='make PREFIX="$prefix"'
               p='make PREFIX="$prefix" DESTDIR="$pkgdir" install' ;;
    autotools) b='[ -x configure ] || { [ -x autogen.sh ] && ./autogen.sh || autoreconf -fi; }; ./configure --prefix="$prefix"; make'
               p='make DESTDIR="$pkgdir" install'; md="cc make autoconf automake libtool pkg-config" ;;
    cmake)     b='cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX="$prefix"; cmake --build build'
               p='DESTDIR="$pkgdir" cmake --install build'; md="cc cmake make pkg-config" ;;
    meson)     b='meson setup build --prefix="$prefix" --buildtype=release; meson compile -C build'
               p='meson install -C build --destdir "$pkgdir"'; md="cc meson ninja pkg-config" ;;
    cargo)     b='cargo build --release --locked || cargo build --release'
               p='find target/release -maxdepth 1 -type f -perm -u+x ! -name "*.d" -exec install -Dm755 -t "$pkgdir$prefix/bin" {} +'; md="rust" ;;
    go)        b='mkdir -p out && go build -trimpath -o out/ ./...'
               p='install -Dm755 -t "$pkgdir$prefix/bin" out/*'; md="go" ;;
  esac
  cat > "$out/GURTBUILD" <<EOF
# made by gurt outsource from $url
pkgname=$name
pkgver=$ver
pkgrel=1
pkgdesc="$name (built from $url)"
url="$url"
arch=($CARCH)
makedepends=($md)
source=("src::git+$url#commit=$sha")
sha256sums=('SKIP')

build() {
  cd "\$srcdir/src"
  $b
}

package() {
  cd "\$srcdir/src"
  $p
  # no .desktop/icon from the build? ship the repo's own if it has one
  if [ ! -d "\$pkgdir\$prefix/share/applications" ]; then
    for f in *.desktop; do [ -f "\$f" ] && install -Dm644 "\$f" "\$pkgdir\$prefix/share/applications/\$f"; done
  fi
  for i in icon.svg "\$pkgname.svg"; do [ -f "\$i" ] && { install -Dm644 "\$i" "\$pkgdir\$prefix/share/icons/hicolor/scalable/apps/\$pkgname.svg"; break; }; done
  [ -f LICENSE ] && install -Dm644 LICENSE "\$pkgdir\$prefix/share/licenses/\$pkgname/LICENSE"
  true
}
EOF
  echo "$out"
}
# a PKGBUILD's deps are Arch names — on other distros building needs the -dev/-devel flavor
os_dep() {
  local d=${1%%[<>=]*} c
  [[ -n $d ]] || return 0
  # shellcheck disable=SC2207
  if in_depmap "$d"; then NATIVE_Q+=($(map_dep "$d")); return 0; fi
  [[ $PM == pacman ]] && { foreign_dep aur "$d"; return; }
  case $PM in
    apt)        for c in "lib$d-dev" "$d-dev" "lib${d%-*}-dev" "$d"; do pm_available "$c" && { NATIVE_Q+=("$c"); return 0; }; done ;;
    dnf|zypper) for c in "$d-devel" "lib$d-devel" "$d"; do pm_available "$c" && { NATIVE_Q+=("$c"); return 0; }; done ;;
    apk)        for c in "$d-dev" "$d"; do pm_available "$c" && { NATIVE_Q+=("$c"); return 0; }; done ;;
  esac
  foreign_dep aur "$d"
}
outsource_install() { # url reason
  local url name dir sha ver kind rdir recipe src_kind d reason=${2:-explicit}
  need_tool git outsource
  url=$(norm_git_url "$1")
  name=${url##*/}; name=${name,,}; name=${name//[^a-z0-9._+-]/-}
  dir="$GURT_CACHE/outsource/$name"
  msg "cloning $url"
  rm -rf "$dir"; mkdir -p "$GURT_CACHE/outsource"
  git clone -q --depth 1 "$url" "$dir" 2>/dev/null || die "couldn't clone $url (typo? private repo?)"
  sha=$(git -C "$dir" rev-parse HEAD)
  if [[ -f $dir/GURTBUILD ]]; then rdir=$dir; recipe=GURTBUILD; src_kind="the repo's own GURTBUILD 🦆"
  elif [[ -f $dir/PKGBUILD ]]; then rdir=$dir; recipe=PKGBUILD; src_kind="the repo's own PKGBUILD"
  elif kind=$(os_build_kind "$dir"); then
    ver="r$(git -C "$dir" log -1 --format=%cd --date=format:%Y%m%d).g${sha:0:7}"
    rdir=$(os_gen_recipe "$dir" "$name" "$url" "$sha" "$kind" "$ver"); recipe=GURTBUILD; src_kind="$kind (auto-detected)"
  else
    die "no Makefile/CMake/meson/cargo/go/GURTBUILD/PKGBUILD in $url — dunno how to build it 😔 (write a GURTBUILD: gurt new $name)"
  fi
  # what's it called + what does it need?
  local info; info=$(cd "$rdir" && load_recipe && print_srcinfo) || die "couldn't read $recipe"
  name=$(awk -F' = ' '$1=="pkgname"{print $2; exit}' <<<"$info")
  local key="git:$name"
  if is_installed "$key" && ! $FORCE && [[ $(info_get "$DB/$key/info" outsource_commit) == "$sha" ]]; then
    [[ $reason == explicit ]] && msg "git/$name is already installed from the latest commit 👍 (--force to rebuild)"
    return 0
  fi
  msg2 "how it builds: $src_kind"
  # shellcheck disable=SC2207
  NATIVE_Q+=($(map_dep cc) $(map_dep make))
  # shellcheck disable=SC2207
  for d in $(awk -F' = ' '$1=="depends"||$1=="makedepends"{print $2}' <<<"$info"); do
    if [[ $recipe == PKGBUILD ]]; then os_dep "$d"
    else case $d in */*) install_any "$d" dep ;; *) NATIVE_Q+=($(map_dep "$d")) ;; esac; fi
  done
  if ! $NOCONFIRM; then
    printf '\n%s──── %s (%s) ────%s\n' "$B" "$recipe" "$url" "$R0" >&2
    cat "$rdir/$recipe" >&2
    printf '%s──────────────────%s\n' "$B" "$R0" >&2
    warn "this builds + runs code straight from a random git repo — only do it if you trust $url"
    ask "build + install git/$name?" || die "aborted, no cap"
  fi
  flush_native
  GURT_SRC=git GURT_EXTRA_INFO="outsource_url = $url"$'\n'"outsource_commit = $sha" build_pkg "$rdir" "$GURT_CACHE/pkg"
  install_file "$BUILT_PKG" "$reason"
  msg2 "remove it with: gurt remove git/$name · update it with: gurt upgrade"
}

# ───────────────────────── commands ─────────────────────────
sync_main() {
  command -v git >/dev/null || die "need git to sync"
  if [[ -d $GURT_REPO_DIR/.git ]]; then
    msg "syncing main GURT repo"
    git -C "$GURT_REPO_DIR" pull -q --ff-only
  else
    msg "cloning main GURT repo from $GURT_REPO_URL"
    mkdir -p "$(dirname "$GURT_REPO_DIR")"
    git clone -q --depth 1 -b "$GURT_BRANCH" "$GURT_REPO_URL" "$GURT_REPO_DIR"
  fi
  local n; n=$(find "$GURT_REPO_DIR/packages" -mindepth 1 -maxdepth 1 -type d | wc -l)
  msg2 "$n packages available"
}
cmd_sync() { # [source...|all]
  (( $# )) || { sync_main; return; }
  local s
  for s in "$@"; do
    s=$(norm_src "$s")
    case $s in
      all) sync_main; local x; for x in apt dnf zypper pacman $(custom_repos); do ( sync_source "$x" ) || warn "$x didn't sync, skipping"; done ;;
      gurt) sync_main ;;
      *) sync_source "$s" ;;
    esac
  done
}

search_main() {
  local term=$1 f name desc ver tag found=0
  ensure_repo
  local aka
  for f in "$GURT_REPO_DIR/$PKG_TREE"/*/.gurtinfo; do
    name=$(info_get "$f" pkgname); desc=$(info_get "$f" pkgdesc)
    aka=$(info_get "$f" alias | paste -sd, - | sed 's/,/, /g')
    if grep -qx 'hidden = true' "$f" && [[ ${term,,} != "${name,,}" ]] && ! grep -qxiF "alias = $term" "$f"; then continue; fi
    if grep -qx 'secret = true' "$f" && ! grep -qxiF "alias = $term" "$f"; then continue; fi
    if [[ -z $term ]] || grep -qiF -- "$term" <<<"$name $desc $aka"; then
      ver=$(repo_ver "$name"); tag=""
      [[ -n $aka ]] && desc+="  (aka $aka)"
      [[ -n $(info_get "$f" via_repo) ]] && ver="official repo 🔏"
      is_installed "$(pkey "$TREE_SRC" "$name")" && tag=" ${GRN}[installed]${R0}"
      printf '%s%s/%s%s%s%s %s%s%s%s\n    %s\n' "$MAG" "$TREE_SRC" "$R0" "$B" "$name" "$R0" "$GRN" "$ver" "$R0" "$tag" "$desc"
      found=1
    fi
  done
  (( found ))
}
search_foreign() { # src term
  local src=$1 term=$2 rows
  if [[ $src == flatpak ]]; then
    rows=$(flatpak_search "$term") || { warn "couldn't search Flathub"; return 1; }
  elif [[ $src == snap ]]; then
    rows=$(snap_search "$term") || { warn "couldn't search the Snap Store"; return 1; }
  elif [[ $src == aur ]]; then
    (( ${#term} >= 2 )) || die "aur search needs at least 2 characters"
    rows=$(aur_search "$term") || { warn "couldn't reach the AUR"; return 1; }
    rows=$(awk -F'\t' '{ print $1 "\t" $2 "\t\t\t\t" $4 ($5 ? " [out of date]" : "") }' <<<"$rows")
  else
    ensure_idx "$src"
    rows=$(awk -F'\t' -v t="${term,,}" 't == "" || index(tolower($1 " " $6), t)' "$(idx_file "$src")" |
           awk -F'\t' -v t="${term,,}" '{ print ($1 == t ? 0 : index($1, t) == 1 ? 1 : index($1, t) ? 2 : 3) "\t" $0 }' |
           sort -t$'\t' -k1,1n -k2,2 | cut -f2- | head -n 40)
  fi
  [[ -n $rows ]] || return 1
  local name ver desc tag line F
  while IFS= read -r line; do
    tsv "$line"; name=${F[0]}; ver=${F[1]:-}; desc=${F[5]:-}
    tag=""; is_installed "$(pkey "$src" "$name")" && tag=" ${GRN}[installed]${R0}"
    printf '%s%s/%s%s%s%s %s%s%s%s\n    %s\n' "$MAG" "$src" "$R0" "$B" "$name" "$R0" "$GRN" "$ver" "$R0" "$tag" "${desc:-(no description)}"
  done <<<"$rows"
}
cmd_search() { # [-a] [src/]term
  local spec=${1:-} src term found=0
  if [[ $spec == */* ]]; then src=$(norm_src "${spec%%/*}"); term=${spec#*/}; else src=gurt; term=$spec; fi
  if $ALLSRC; then
    search_main "$term" && found=1
    for src in $(all_sources); do
      [[ $src == aur || $src == flatpak || $src == snap ]] && { search_foreign "$src" "$term" 2>/dev/null && found=1; continue; }
      ( idx_fresh "$src" || sync_source "$src" ) >/dev/null 2>&1 || { warn "$src unreachable, skipped"; continue; }
      search_foreign "$src" "$term" && found=1
    done
  elif [[ $src == gurt ]]; then search_main "$term" && found=1
  elif [[ $src == dirt ]]; then dirt_on || die "DIRT is off 🔒 (gurt dirt on — 18+ only)"; PKG_TREE=dirt TREE_SRC=dirt search_main "$term" && found=1
  else search_foreign "$src" "$term" && found=1; fi
  (( found )) || { echo "nothing matched '$term' 😔 womp womp"; [[ $src == gurt ]] && ! $ALLSRC && echo "try: gurt search -a $term   (searches aur, apt, dnf, zypper, pacman too)"; return 1; }
}

cmd_info() {
  local spec=${1:?usage: gurt info [source/]<pkg>} src name key row
  if [[ $spec == */* ]]; then src=$(norm_src "${spec%%/*}"); name=${spec#*/}; else src=gurt; name=$spec; fi
  key=$(pkey "$src" "$name")
  case $src in
    gurt)
      ensure_repo
      local real; if ! is_gurt_pkg "$name" && real=$(alias_lookup "$name"); then name=$real; key=$name
      elif grep -qx 'secret = true' "$(repo_info "$name")" 2>/dev/null && ! is_installed "$key"; then die "no package '$name' in main GURT"; fi
      if [[ -f $(repo_info "$name") ]]; then awk -F' = ' '{ printf "%-14s: %s\n", $1, substr($0, length($1)+4) }' "$(repo_info "$name")"
      elif is_installed "$key"; then awk -F' = ' '{ printf "%-14s: %s\n", $1, substr($0, length($1)+4) }' "$DB/$key/info"
      else die "no package '$name' in main GURT"; fi ;;
    aur)
      row=$(aur_info "$name" | head -n1) || true
      [[ -n $row ]] || die "no AUR package '$name' (or the AUR is unreachable)"
      local F v b d o; tsv "$row"; v=${F[1]:-}; b=${F[2]:-}; d=${F[3]:-}; o=${F[4]:-}
      printf '%-14s: %s\n' source "aur (built from source)" pkgname "$name" version "$v" pkgbase "$b" pkgdesc "$d" url "$AUR_URL/packages/$name"
      [[ -n $o ]] && printf '%-14s: %s\n' "out of date" yes ;;
    flatpak)
      ensure_flatpak; local id; id=$(flatpak_resolve "$name"); [[ -n $id ]] || die "nothing on Flathub matches '$name'"
      key="flatpak:$id"; flatpak remote-info flathub "$id" 2>/dev/null || die "couldn't get info for $id" ;;
    snap)
      command -v snap >/dev/null || die "snap isn't installed yet (gurt install snap/<name> sets it up)"
      snap info "$name" 2>/dev/null | head -n 20 || die "no snap called $name" ;;
    *)
      is_binary_src "$src" || die "unknown source '$src'"
      ensure_idx "$src"
      row=$(idx_lookup "$src" "$name"); [[ -n $row ]] || die "no package '$name' in $src"
      local F v p s deps d; tsv "$row"; v=${F[1]:-}; p=${F[2]:-}; s=${F[3]:-}; deps=${F[4]:-}; d=${F[5]:-}
      printf '%-14s: %s\n' source "$src (binary from $(src_base "$src"))" pkgname "$name" version "$v" pkgdesc "$d" file "${p##*/}" checksum "$s" depends "${deps//,/, }" ;;
  esac
  if is_installed "$key"; then printf '%-14s: %s (%s)\n' installed "$(inst_ver "$key")" "$(cat "$DB/$key/reason")"
  else printf '%-14s: no\n' installed; fi
}

cmd_list() {
  local d k
  for d in "$DB"/*/; do
    k=$(basename "$d"); printf '%s %s\n' "$(pretty "$k")" "$(inst_ver "$k")"
  done
}

# ── keeping stuff fresh ──
# find_outdated: fills TODO with keys that have a newer version (indexes must be synced first)
TODO=()
find_outdated() {
  local d k src name new dir
  TODO=()
  for d in "$DB"/*/; do
    k=$(basename "$d")
    if [[ $k == *:* ]]; then src=${k%%:*}; name=${k#*:}; else src=gurt; name=$k; fi
    new=""
    if is_held "$k"; then msg2 "$(pretty "$k") is held 📌 skipping"; continue; fi
    case $src in
      gurt) is_gurt_pkg "$name" && new=$(repo_ver "$name") ;;
      dirt) if PKG_TREE=dirt is_gurt_pkg "$name"; then new=$(PKG_TREE=dirt repo_ver "$name"); fi ;;
      aur)  dir=$(aur_clone "$name" 2>/dev/null) && new=$(aur_srcinfo_ver "$dir/.SRCINFO") ;;
      flatpak|snap|box-*) ;;   # they update themselves (see upgrade_containers)
      git)  local u c h; u=$(info_get "$d/info" outsource_url); c=$(info_get "$d/info" outsource_commit)
            h=$(git ls-remote "$u" HEAD 2>/dev/null | cut -f1)
            if [[ -n $h && $h != "$c" ]]; then msg2 "git/$name  ${c:0:7} -> ${h:0:7}"; TODO+=("$k"); fi
            continue ;;
      *)    new=$(idx_lookup "$src" "$name" | cut -f2 || true) ;;
    esac
    if [[ -n $new ]] && vnewer "$(inst_ver "$k")" "$new"; then
      msg2 "$(pretty "$k")  $(inst_ver "$k") -> $new"; TODO+=("$k")
    fi
  done
}

# sources you've actually installed from (so update doesn't download indexes you never use)
used_sources() {
  local d k seen=" "
  for d in "$DB"/*:*/; do k=$(basename "$d"); k=${k%%:*}; [[ $seen == *" $k "* ]] || { seen+="$k "; echo "$k"; }; done
  for k in apt dnf zypper pacman $(custom_repos); do [[ -f $(idx_file "$k") && $seen != *" $k "* ]] && { seen+="$k "; echo "$k"; }; done
  return 0
}

refresh_all() {
  local s
  sync_main
  for s in $(used_sources); do
    [[ $s == aur || $s == flatpak || $s == snap || $s == box-* ]] && continue
    ( sync_source "$s" ) || warn "couldn't refresh $s, skipping"
  done
}

# is there a newer gurt in the main repo?
repo_gurt_ver() { [[ -f $GURT_REPO_DIR/gurt ]] && sed -n 's/^GURT_VERSION="\(.*\)"$/\1/p' "$GURT_REPO_DIR/gurt" | head -n1; }
check_self() {
  local v; v=$(repo_gurt_ver)
  if [[ -n $v ]] && vnewer "$GURT_VERSION" "$v"; then
    printf '%s==> gurt %s is out (you have %s) — run: gurt self-update 🦆%s\n' "$MAG" "$v" "$GURT_VERSION" "$R0" >&2
  fi
}

cmd_update() {   # like apt update: refresh everything, install nothing
  refresh_all
  msg "checking for newer versions"
  find_outdated
  if (( ${#TODO[@]} )); then msg "${#TODO[@]} package(s) can be upgraded — run: gurt upgrade"
  else msg "everything's up to date, you're chillin 😎"; fi
  check_self
}

cmd_upgrade() {  # refresh + actually install the new versions
  refresh_all
  find_outdated
  check_self
  upgrade_containers
  (( ${#TODO[@]} )) || { msg "everything's up to date, you're chillin 😎"; return 0; }
  ask "upgrade ${#TODO[@]} package(s)?" || die "aborted"
  local k todo=("${TODO[@]}") was=$NOCONFIRM; NOCONFIRM=true   # already said yes
  for k in "${todo[@]}"; do install_any "$(pretty "$k")" "$(cat "$DB/$k/reason")"; done
  NOCONFIRM=$was
}
upgrade_containers() {   # flatpak + snap update their own apps
  local d
  d=("$DB"/flatpak:*/); if (( ${#d[@]} )) && command -v flatpak >/dev/null; then msg "updating flatpaks"; flatpak update --user -y --noninteractive || warn "flatpak update had problems"; fi
  d=("$DB"/snap:*/);    if (( ${#d[@]} )) && command -v snap >/dev/null;    then msg "updating snaps";    asroot snap refresh || warn "snap refresh had problems"; fi
  local s; for s in apt dnf zypper pacman; do
    d=("$DB"/box-"$s":*/)
    if (( ${#d[@]} )) && command -v distrobox >/dev/null; then
      msg "updating the $(box_name "$s") box"; distrobox enter "$(box_name "$s")" -- sh -c "$(box_cmd "$s" upgrade)" || warn "$(box_name "$s") update had problems"
    fi
  done
  return 0
}

# tab completion — scripts live right here, so there's nothing extra to install
completion_script() {
  case $1 in
    bash) cat <<'EOF'
_gurt() {
  local cur=${COMP_WORDS[COMP_CWORD]} cmd=${COMP_WORDS[1]}
  if (( COMP_CWORD == 1 )); then COMPREPLY=($(compgen -W "$(gurt __complete commands)" -- "$cur")); return; fi
  case $cmd in
    remove|rm|yeet|files|rollback|undo|hold|unhold|pin|unpin) COMPREPLY=($(compgen -W "$(gurt __complete installed)" -- "$cur")) ;;
    install|i|get|info|search|s) compopt -o nospace 2>/dev/null
      COMPREPLY=($(compgen -W "$(gurt __complete available; gurt __complete sources)" -- "$cur"))
      [[ ${#COMPREPLY[@]} == 1 && ${COMPREPLY[0]} != */ ]] && COMPREPLY[0]+=" " ;;
    dirt) COMPREPLY=($(compgen -W "on off status list" -- "$cur")) ;;
    repo|repos) COMPREPLY=($(compgen -W "add list remove" -- "$cur")) ;;
    sync) COMPREPLY=($(compgen -W "all aur apt dnf zypper pacman" -- "$cur")) ;;
    import|add|export|build) COMPREPLY=($(compgen -f -- "$cur")) ;;
    completions) COMPREPLY=($(compgen -W "bash zsh fish" -- "$cur")) ;;
  esac
}
complete -F _gurt gurt
EOF
;;
    zsh) cat <<'EOF'
#compdef gurt
_gurt() {
  if (( CURRENT == 2 )); then compadd -- ${(f)"$(gurt __complete commands)"}; return; fi
  case $words[2] in
    remove|rm|yeet|files|rollback|undo|hold|unhold|pin|unpin) compadd -- ${(f)"$(gurt __complete installed)"} ;;
    install|i|get|info|search|s) compadd -- ${(f)"$(gurt __complete available)"}; compadd -S '' -- ${(f)"$(gurt __complete sources)"} ;;
    dirt) compadd on off status list ;;
    repo|repos) compadd add list remove ;;
    sync) compadd all aur apt dnf zypper pacman ;;
    import|add|export|build) _files ;;
    completions) compadd bash zsh fish ;;
  esac
}
compdef _gurt gurt
EOF
;;
    fish) cat <<'EOF'
complete -c gurt -f
complete -c gurt -n '__fish_is_first_arg' -a '(gurt __complete commands)'
complete -c gurt -n '__fish_seen_subcommand_from remove rm yeet files rollback undo hold unhold pin unpin' -a '(gurt __complete installed)'
complete -c gurt -n '__fish_seen_subcommand_from install i get info search s' -a '(gurt __complete available; gurt __complete sources)'
complete -c gurt -n '__fish_seen_subcommand_from dirt' -a 'on off status list'
complete -c gurt -n '__fish_seen_subcommand_from repo repos' -a 'add list remove'
complete -c gurt -n '__fish_seen_subcommand_from sync' -a 'all aur apt dnf zypper pacman'
complete -c gurt -n '__fish_seen_subcommand_from import add export build' -F
complete -c gurt -n '__fish_seen_subcommand_from completions' -a 'bash zsh fish'
EOF
;;
    *) die "completions for: bash, zsh, fish" ;;
  esac
}
# drop bash + fish completions into your home the first time a new gurt runs (no sudo, no setup)
ensure_completions() {
  (( EUID == 0 )) && return 0
  [[ -n ${HOME:-} && -w $HOME ]] || return 0
  local data="${XDG_DATA_HOME:-$HOME/.local/share}" stamp
  stamp="$data/gurt/completions-version"
  [[ $(cat "$stamp" 2>/dev/null) == "$GURT_VERSION" ]] && return 0
  {
    mkdir -p "$data/bash-completion/completions" "$data/gurt" &&
    completion_script bash > "$data/bash-completion/completions/gurt" &&
    if command -v fish >/dev/null; then mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions" &&
      completion_script fish > "${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions/gurt.fish"; fi &&
    echo "$GURT_VERSION" > "$stamp"
  } 2>/dev/null || true
}
cmd_self_update() {
  local self new tmp dir
  self=$(readlink -f "$0")
  sync_main
  new=$(repo_gurt_ver)
  [[ -n $new ]] || die "couldn't find gurt in the main repo"
  if ! vnewer "$GURT_VERSION" "$new" && ! $FORCE; then
    msg "gurt $GURT_VERSION is already the newest 😎"; return 0
  fi
  bash -n "$GURT_REPO_DIR/gurt" || die "the new gurt has a syntax error?? not installing it"
  ask "update gurt $GURT_VERSION -> $new ($self)?" || die "aborted"
  dir=$(dirname "$self")
  tmp="$dir/.gurt.new.$$"
  # write a new file then rename over the old one, so this running copy doesn't get corrupted mid-run
  asroot cp "$GURT_REPO_DIR/gurt" "$tmp"
  asroot chmod 755 "$tmp"
  asroot mv -f "$tmp" "$self"
  for f in /usr/local/share/gurt/deps.map /usr/share/gurt/deps.map; do
    [[ -f $f ]] && asroot cp "$GURT_REPO_DIR/deps.map" "$f"
  done
  for f in /usr/local/share/gurt /usr/share/gurt; do
    [[ -d $f && -f $GURT_REPO_DIR/gui/gurt-gui.py ]] && asroot cp "$GURT_REPO_DIR/gui/gurt-gui.py" "$f/gurt-gui.py"
  done
  msg "gurt updated to $new ✅"
  exit 0
}

cmd_files() { local k; k=$(resolve_key "${1:?usage: gurt files <pkg>}") || die "$1 isn't installed"; sed 's|^|/|' "$DB/$k/files"; }

cmd_owns() {
  local p=${1:?usage: gurt owns <path>} f k
  p=$(readlink -m "$p"); p=${p#"$R"}; p=${p#/}
  for f in "$DB"/*/files; do
    grep -qxF "$p" "$f" && { k=$(basename "$(dirname "$f")"); echo "/$p is owned by $(pretty "$k") $(inst_ver "$k")"; return 0; }
  done
  echo "no gurt package owns /$p"; return 1
}

cmd_srcinfo() { ( cd "${1:-.}" && load_recipe && print_srcinfo ); }

cmd_new() {
  local n=${1:?usage: gurt new <pkgname>}
  [[ -e $n ]] && die "$n already exists"
  mkdir -p "$n"
  cat > "$n/GURTBUILD" <<EOF
# GURTBUILD for $n
# docs: see CONTRIBUTING.md in the gurt repo
pkgname=$n
pkgver=1.0.0
pkgrel=1
pkgdesc="describe it in one line"
url="https://example.com/$n"
license="MIT"
maintainer="your-handle"
arch=(x86_64 aarch64)          # or (any) for scripts
depends=()                     # runtime deps, GENERIC names from deps.map
makedepends=(cc make)          # build-time deps
source=("\$pkgname-\$pkgver.tar.gz::https://example.com/\$pkgname-\$pkgver.tar.gz")
sha256sums=(SKIP)              # run: gurt checksum

build() {
  cd "\$pkgname-\$pkgver"
  ./configure --prefix="\$prefix"
  make
}

package() {
  cd "\$pkgname-\$pkgver"
  make DESTDIR="\$pkgdir" install
}
EOF
  msg "made $n/GURTBUILD — edit it, then: gurt build $n && gurt srcinfo $n > $n/.gurtinfo"
}

cmd_checksum() {
  ( cd "${1:-.}"; load_recipe
    local s loc name tmp; tmp=$(mktemp -d)
    for s in "${source[@]}"; do
      if [[ $s == *::* ]]; then name=${s%%::*}; loc=${s#*::}; else loc=$s; name=${s##*/}; fi
      case $loc in
        git+*) echo "SKIP  # $name (git)";;
        http*|ftp*) download "$loc" "$tmp/$name" >/dev/null 2>&1 || die "couldn't download $loc"
                    echo "$(sha256sum "$tmp/$name" | awk '{print $1}')  # $name";;
        *) echo "$(sha256sum "$loc" | awk '{print $1}')  # $name";;
      esac
    done; rm -rf "$tmp" )
}

# ── gurt repo: add your own apt/rpm/pacman repos (PPAs, vendor repos, COPRs…) ──
fetch_key() { # name source(url|file) -> prints stored key path
  local name=$1 src=$2 out="$KEY_DIR/$1.asc"
  mkdir -p "$KEY_DIR"
  if [[ $src =~ ^https?:// ]]; then fetch_quiet "$src" "$out.part" || die "couldn't download key from $src"; mv "$out.part" "$out"
  else [[ -f $src ]] || die "no key file at $src"; cp "$src" "$out"; fi
  grep -q 'BEGIN PGP PUBLIC KEY' "$out" || gpg --show-keys "$out" >/dev/null 2>&1 || { rm -f "$out"; die "that doesn't look like a PGP public key"; }
  echo "$out"
}
show_fpr() { command -v gpg >/dev/null && gpg --show-keys --with-fingerprint "$1" 2>/dev/null | awk 'NR<=4' | sed 's/^/     /' >&2; return 0; }

repo_add() {
  local name type url suite comps="" key=""
  if [[ ${1:-} == ppa:*/* ]]; then                 # ppa:owner/name shortcut
    local owner=${1#ppa:}; local ppa=${owner#*/}; owner=${owner%%/*}
    name="ppa-${owner,,}-${ppa,,}"; type=apt; comps=main
    url="https://ppa.launchpadcontent.net/$owner/$ppa/ubuntu"
    suite=${SUITE_OPT:-$( . /etc/os-release 2>/dev/null; echo "${UBUNTU_CODENAME:-}")}
    suite=${suite:-noble}
    if [[ -z $KEYSRC ]] && command -v python3 >/dev/null; then
      local fpr
      fpr=$(fetch_quiet "https://api.launchpad.net/1.0/~$owner/+archive/ubuntu/$ppa" /dev/stdout 2>/dev/null |
            python3 -c 'import sys,json; print(json.load(sys.stdin).get("signing_key_fingerprint") or "")' 2>/dev/null || true)
      [[ -n $fpr ]] && KEYSRC="https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x$fpr"
    fi
    msg2 "PPA → $url ($suite)"
  else
    name=${1:-}; type=${2:-}; url=${3:-}; suite=${SUITE_OPT:-${4:-}}
    (( $# > 4 )) && { shift 4; comps="$*"; }
    [[ -n $name && -n $type && -n $url ]] || die "usage: gurt repo add <name> <apt|rpm|pacman> <url> [suite] [components…] [--key URL|file]
     e.g. gurt repo add claude apt https://downloads.claude.ai/claude-code/apt/stable stable main --key https://downloads.claude.ai/keys/claude-code.asc
          gurt repo add ppa:owner/name"
  fi
  name=${name,,}
  [[ $name =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "repo names are lowercase letters, digits, . _ - only"
  if [[ " gurt main $FOREIGN_SOURCES " == *" $name "* || $(norm_src "$name") != "$name" ]]; then die "'$name' is a built-in source name, pick another"; fi
  case ${type,,} in
    apt|deb|debian|ubuntu) type=apt; suite=${suite:-stable}; comps=${comps:-main} ;;
    rpm|dnf|yum|zypper|fedora|suse) type=rpm ;;
    pacman|arch) type=pacman; suite=${suite:-$name} ;;
    *) die "type has to be apt, rpm or pacman" ;;
  esac
  [[ $url =~ ^(https?|file)://  ]] || die "url should start with https://"
  [[ $url == http://* ]] && warn "that's plain http — only safe with a signing key (--key)"
  if [[ $type == pacman ]]; then
    [[ -n $KEYSRC ]] && warn "pacman repo signatures aren't checked yet — ignoring --key (packages are still sha256-checked against the repo db)"
    KEYSRC=""
  fi
  if [[ -n $KEYSRC ]]; then
    key=$(fetch_key "$name" "$KEYSRC")
    if [[ -n ${EXPECT_FPR:-} ]]; then
      # key files can hold several keys (e.g. an old + a current one) — the pinned one has to be among them
      local got_fpr; got_fpr=$(gpg --show-keys --with-colons "$key" 2>/dev/null | awk -F: '$1 == "fpr" {print toupper($10)}')
      if ! grep -qxF "${EXPECT_FPR^^}" <<<"$got_fpr"; then
        rm -f "$key"; die "🚩 key fingerprint mismatch for $name: expected $EXPECT_FPR, got $(head -n1 <<<"$got_fpr" || true) — NOT adding it"
      fi
      msg2 "key fingerprint matches the pinned one ✅"
    fi
    msg2 "signing key saved — make sure this fingerprint is legit:"; show_fpr "$key"
  else
    warn "no signing key (--key) — packages are still checksum-checked, but the repo's index itself isn't signature-verified"
  fi
  mkdir -p "$USER_REPO_DIR"
  { printf 'type=%s\nurl=%s\n' "$type" "${url%/}"
    [[ -n $suite ]] && printf 'suite=%s\n' "$suite"
    [[ -n $comps ]] && printf 'components=%s\n' "$comps"
    [[ -n $key ]] && printf 'key=%s\n' "$key"
  } > "$USER_REPO_DIR/$name.conf"
  msg "added repo $name ($type) ✅"
  if ( sync_source "$name" ); then
    msg "now:  gurt search $name/<term>   ·   gurt install <pkg> --repo $name"
  else
    rm -f "$USER_REPO_DIR/$name.conf" "$KEY_DIR/$name.asc"
    die "didn't add $name — the first sync failed (bad url/suite, or it failed the signature check) 🚫"
  fi
}

repo_list() {
  local r f
  printf '%s%-22s %-7s %s%s\n' "$B" "name" "type" "url" "$R0"
  printf '%-22s %-7s %s\n' gurt main "$GURT_REPO_URL" aur build "$AUR_URL" apt apt "$APT_MIRROR ($APT_SUITE)" \
    dnf rpm "$(src_base dnf)" zypper rpm "$(src_base zypper)" pacman pacman "$PACMAN_MIRROR"
  for r in $(custom_repos); do
    f=$(repo_file "$r")
    printf '%-22s %-7s %s%s%s\n' "$r" "$(repo_get "$r" type)" "$(repo_get "$r" url)" \
      "$([[ -n $(repo_get "$r" suite) ]] && echo " ($(repo_get "$r" suite))")" "$([[ -n $(repo_get "$r" key) ]] && echo " 🔏")"
  done
}

repo_remove() {
  local name=${1:?usage: gurt repo remove <name>} f d users=()
  f=$(repo_file "$name") || die "no custom repo called $name"
  for d in "$DB"/"$name":*/; do users+=("$(pretty "$(basename "$d")")"); done
  (( ${#users[@]} )) && warn "still installed from $name: ${users[*]} (they stay installed, but won't get updates)"
  [[ -w $f ]] || die "$f belongs to root — sudo rm it yourself"
  rm -f "$f" "$KEY_DIR/$name.asc" "$(idx_file "$name")"
  msg "removed repo $name 🗑️"
}

cmd_repo() {
  local sub=${1:-list}; shift || true
  case $sub in
    add)            repo_add "$@" ;;
    list|ls)        repo_list ;;
    remove|rm|del)  repo_remove "$@" ;;
    *) die "usage: gurt repo [list | add … | remove <name>]" ;;
  esac
}

cmd_doctor() {
  local id="unknown"; [[ -r /etc/os-release ]] && id=$(. /etc/os-release; echo "${PRETTY_NAME:-$ID}")
  printf '%-14s %s\n' gurt "$GURT_VERSION" distro "$id" "pkg manager" "$PM" arch "$CARCH" \
    prefix "$GURT_PREFIX" root "${GURT_ROOT}" "main repo" "$GURT_REPO_URL" cache "$GURT_CACHE" \
    deps.map "$(depmap_file || true)"
  local t ok=0
  for t in bash git tar sha256sum find awk; do command -v "$t" >/dev/null || { warn "missing: $t"; ok=1; }; done
  command -v curl >/dev/null || command -v wget >/dev/null || { warn "missing: curl or wget"; ok=1; }
  tar --version 2>/dev/null | grep -q GNU || { warn "gurt needs GNU tar (Alpine: apk add tar)"; ok=1; }
  command -v sudo >/dev/null || command -v doas >/dev/null || (( EUID == 0 )) || warn "no sudo/doas found"
  [[ $PM == none ]] && warn "no known package manager — you'll have to install deps yourself (--nodeps)"

  printf '\n%ssources%s\n' "$B" "$R0"
  has() { command -v "$1" >/dev/null; }
  srcline() { # name ok? detail
    if [[ $2 == 1 ]]; then printf '  %s✓%s %-8s %s\n' "$GRN" "$R0" "$1" "$3"
    else printf '  %s✗%s %-8s %s\n' "$YLW" "$R0" "$1" "$3"; fi
  }
  srcline gurt 1 "main GURT repo — $GURT_REPO_URL"
  srcline aur "$(has git && has python3 && echo 1)" "Arch User Repository, built from source — $AUR_URL$(has python3 || echo '  (needs python3 for search)')"
  srcline apt "$( { has ar || has bsdtar; } && has xz && echo 1)" "$APT_MIRROR $APT_SUITE [$APT_COMPONENTS]$( { has ar || has bsdtar; } || echo '  (needs ar or bsdtar)')"
  srcline dnf "$(has python3 && has zstd && { has bsdtar || { has rpm2cpio && has cpio; }; } && echo 1)" "$(src_base dnf)  (needs python3, zstd, bsdtar or rpm2cpio+cpio)"
  srcline zypper "$(has python3 && has zstd && { has bsdtar || { has rpm2cpio && has cpio; }; } && echo 1)" "$(src_base zypper)  (needs python3, zstd, bsdtar or rpm2cpio+cpio)"
  srcline pacman "$(has zstd && echo 1)" "$PACMAN_MIRROR [$PACMAN_REPOS]  (needs zstd)"
  srcline flatpak "$(has flatpak && echo 1)" "Flathub$(has flatpak || echo '  (gurt installs flatpak the first time you use it)')"
  srcline snap "$(has snap && echo 1)" "Snap Store$(has snap || echo '  (gurt sets up snapd the first time you use it)')"
  local r; for r in $(custom_repos); do
    srcline "$r" "$( { [[ -z $(repo_get "$r" key) ]] || has gpgv; } && echo 1)" "$(repo_get "$r" type) · $(repo_get "$r" url)$([[ -n $(repo_get "$r" key) ]] && echo ' 🔏')"
  done
  (( ok == 0 )) && msg "all good bestie ✨"
}

# ───────────────────────── the banner ─────────────────────────
# "gurt" in the logo's colors: g = your terminal's text color (black on light, white on dark), u red, r green, t blue
GURT_ART_G=('           ' '           ' ' .oooooooo ' "888' \`88b  " '888   888  ' "\`88bod8P'  " '`8oooooo.  ' 'd"     YD  ' "\"Y88888P'  ")
GURT_ART_U=('            ' '            ' 'oooo  oooo  ' '`888  `888  ' ' 888   888  ' ' 888   888  ' " \`V88V\"V8P' " '            ' '            ')
GURT_ART_R=('         ' '         ' 'oooo d8b ' '`888""8P ' ' 888     ' ' 888     ' 'd888b    ' '         ' '         ')
GURT_ART_T=('    .   ' '  .o8   ' '.o888oo ' '  888   ' '  888   ' '  888 . ' '  "888" ' '        ' '        ')
cmd_version() {
  if [[ ! -t 1 ]]; then echo "gurt $GURT_VERSION"; return; fi   # scripts get the plain line
  local c0='' c1='' c2='' c3='' c4='' b='' d='' r=''
  if [[ -z ${NO_COLOR:-} ]]; then
    c1=$'\e[1m' c2=$'\e[1;91m' c3=$'\e[1;92m' c4=$'\e[1;94m' b=$'\e[1m' d=$'\e[2m' r=$'\e[0m'
  fi
  local distro="unknown" k n=0 dirt="off 🔒" line i
  [[ -r /etc/os-release ]] && distro=$(. /etc/os-release; echo "${PRETTY_NAME:-${ID:-unknown}}")
  declare -A per=()
  for k in "$DB"/*/; do
    [[ -d $k ]] || continue; k=$(basename "$k"); n=$((n + 1))
    if [[ $k == *:* ]]; then per[${k%%:*}]=$(( ${per[${k%%:*}]:-0} + 1 )); else per[gurt]=$(( ${per[gurt]:-0} + 1 )); fi
  done
  local breakdown="" s
  for s in "${!per[@]}"; do breakdown+="$s ${per[$s]}, "; done
  breakdown=${breakdown%, }
  dirt_on && dirt="on 🔞"
  local recipes="not synced yet (gurt sync)"
  [[ -d $GURT_REPO_DIR/packages ]] && recipes="$(find "$GURT_REPO_DIR/packages" -mindepth 1 -maxdepth 1 -type d | wc -l) in Main GURT"
  local info=(
    "${b}gurt${r}@${b}${GURT_VERSION}${r}"
    "${d}──────────────────────────${r}"
    "${c2}GURT${r}     GURT Universal Repository Thingy"
    "${c3}version${r}  $GURT_VERSION"
    "${c4}distro${r}   $distro"
    "${c2}host pm${r}  $PM"
    "${c3}arch${r}     $CARCH"
    "${c4}packages${r} $n installed${breakdown:+ ($breakdown)}"
    "${c2}recipes${r}  $recipes"
    "${c3}sources${r}  gurt aur apt dnf zypper pacman flatpak snap"
    "${c4}DIRT${r}     $dirt"
    "${c2}site${r}     https://clrealy.github.io/GURT"
    ""
    "\e[40m   \e[41m   \e[42m   \e[43m   \e[44m   \e[45m   \e[46m   \e[47m   ${r}"
  )
  [[ -z $r ]] && info[13]=""
  echo
  for (( i = 0; i < 14; i++ )); do
    if (( i < 9 )); then
      line="  ${c1}${GURT_ART_G[i]}${r}${c2}${GURT_ART_U[i]}${r}${c3}${GURT_ART_R[i]}${r}${c4}${GURT_ART_T[i]}${r}   "
    else line=$(printf '%*s' 45 ''); fi
    printf '%s%b\n' "$line" "${info[i]:-}"
  done
  echo
}

usage() {
  cat <<EOF
${B}gurt${R0} $GURT_VERSION — GURT Universal Repository Thingy 🦆
every distro's packages, on every distro. + the main GURT repo.

${B}usage:${R0} gurt <command> [options] [source/]<pkg>

${B}sources${R0}   (no prefix = main GURT · write it as aur/yay OR  yay --repo aur)
  btop                 main GURT — community recipes, built for your distro
  aur/yay              Arch User Repository — PKGBUILDs built from source
  apt/htop             Debian/Ubuntu binary packages      (aliases: debian/ ubuntu/ deb/)
  dnf/htop             Fedora binary packages             (aliases: fedora/ yum/ rpm/)
  zypper/htop          openSUSE binary packages           (aliases: suse/ opensuse/)
  pacman/htop          Arch official binary packages      (aliases: arch/)
  flatpak/gimp         Flathub apps (gurt sets up flatpak for you)  (alias: flathub/)
  snap/spotify         Snap Store apps (gurt sets up snapd for you)

${B}DIRT${R0}   (the mature section — off by default, 18+, never on the website)
  dirt on | off | status | list        then: gurt install dirt/<name>

${B}your own repos${R0}   (PPAs, vendor apt/rpm repos, COPRs, custom pacman repos)
  repo list                      every source gurt knows
  repo add ppa:owner/name        add an Ubuntu PPA (key fetched automatically)
  repo add <name> <apt|rpm|pacman> <url> [suite] [components…] --key <url|file>
  repo remove <name>
  then: gurt install <pkg> --repo <name>

${B}using packages${R0}
  sync [source|all]    pull the latest recipes / package indexes
  search [src/]term    find packages   (-a searches every source)
  info [src/]pkg       show package details
  install [src/]pkg…   install (deps come from your distro first, then the source)
  update               refresh package lists + show what's outdated (installs nothing)
  upgrade              update everything gurt installed, from every source
  self-update          update gurt itself
  remove pkg…          uninstall (only removes files gurt put there)
  autoremove           remove deps nothing needs anymore
  list                 what you've got installed
  files pkg            files a package owns
  owns <path>          which package owns a file

${B}making packages${R0}
  new <name>           scaffold a GURTBUILD
  build <dir> [out]    build a GURTBUILD or PKGBUILD into a .gurt file (doesn't install)
  add <file.gurt>      install a .gurt file
  srcinfo [dir]        print .gurtinfo for a recipe (commit this!)
  checksum [dir]       print sha256sums for a recipe's sources

${B}misc${R0}
  doctor               check your setup + which sources work
  outsource <git url>  clone + build + install any repo (github user/repo works too) → git/<name>
  rollback <pkg>       go back to the version before (gurt keeps the last 3) + hold it there
  hold / unhold <pkg>  stop / resume upgrades for a package
  export [file]        save the list of stuff you installed
  import <file>        install everything from an export (new PC speedrun)
  completions <shell>  print tab completion for bash/zsh/fish (bash+fish set themselves up)
  gui                  open the GURT app 🖥️ (also in your app menu after the first run)
  gui --setup          install what's needed for a real app window (instead of a browser tab)
  version              the gurt banner + your setup (also just: gurt)
  yo                   gurt

${B}options${R0}
  -y, --noconfirm      don't ask, just send it
  -f, --force          reinstall / overwrite / ignore reverse deps
  -r, --repo SRC       use this source for bare names, e.g.  gurt install htop --repo apt
  --box                force apt/ dnf/ zypper/ pacman/ stuff into a real container of that distro
                       (system utilities go there automatically)
  --no-box             never auto-box (you know what you're doing)
  -a, --all            search every source
  --scanrepos          install: look for the package in EVERY source, then pick where to get it
  --nodeps             don't install distro deps
  --nocheck            skip check()
  --no-desktop         don't put desktop shortcuts on your desktop (or GURT_DESKTOP_ICONS=0)
  --keep               keep the build dir
  --root DIR           install into another root (testing, chroots)
EOF
}

# ───────────────────────── main ─────────────────────────
main() {
  local args=()
  while (( $# )); do
    case $1 in
      -y|--noconfirm) NOCONFIRM=true ;;
      -f|--force)     FORCE=true ;;
      -a|--all)       ALLSRC=true ;;
      --box|--container) BOX=true ;;
      --no-box)       NOBOX=true ;;
      --scanrepos|--scan) SCAN=true ;;
      -r|--repo|--from) shift; REPO=${1:?--repo needs a source (gurt aur apt dnf zypper pacman)} ;;
      --repo=*|--from=*)  REPO=${1#*=} ;;
      --key)          shift; KEYSRC=${1:?--key needs a url or file} ;;
      --key=*)        KEYSRC=${1#*=} ;;
      --suite)        shift; SUITE_OPT=${1:?--suite needs a value} ;;
      --fingerprint)  shift; EXPECT_FPR=${1:?--fingerprint needs a value}; EXPECT_FPR=${EXPECT_FPR// /} ;;
      --suite=*)      SUITE_OPT=${1#*=} ;;
      --nodeps)       NODEPS=true ;;
      --nocheck)      NOCHECK=true ;;
      --no-desktop)   NO_DESKTOP=true ;;
      --keep)         KEEP=true ;;
      --root)         shift; GURT_ROOT=${1:?--root needs a dir}; R="${GURT_ROOT%/}"; DB="$R/var/lib/gurt/local" ;;
      --root=*)       GURT_ROOT=${1#*=}; R="${GURT_ROOT%/}"; DB="$R/var/lib/gurt/local" ;;
      -h|--help)      args=(help "${args[@]}") ;;
      -V|--version)   args=(version) ;;
      *)              args+=("$1") ;;
    esac
    shift
  done
  set -- "${args[@]}"
  local cmd=${1:-hi}; shift || true
  [[ $cmd == __complete ]] || ensure_completions
  local p
  # --repo X  →  every bare package name becomes X/name
  if [[ -n $REPO ]]; then
    REPO=$(norm_src "$REPO")
    [[ " gurt $(all_sources) " == *" $REPO "* ]] || die "unknown repo '$REPO' — pick one of: gurt $(all_sources) (or add one: gurt repo add)"
    case $cmd in
      install|i|get|search|s|info|remove|rm|yeet|files)
        local withrepo=()
        for p; do if [[ $p == */* ]]; then withrepo+=("$p"); else withrepo+=("$REPO/$p"); fi; done
        (( $# )) || [[ $cmd != search && $cmd != s ]] || withrepo=("$REPO/")
        set -- "${withrepo[@]}" ;;
      sync) set -- "$REPO" ;;
    esac
  fi
  case $cmd in
    sync)              cmd_sync "$@" ;;
    search|s)          cmd_search "$@" ;;
    info)              cmd_info "$@" ;;
    install|i|get)     (( $# )) || die "install what tho"
                       for p; do if $SCAN && [[ $p != */* ]]; then scan_install "$p"; else install_any "$p" explicit; fi; done ;;
    update|refresh)    cmd_update ;;
    upgrade|up)        cmd_upgrade ;;
    self-update|selfupdate) cmd_self_update ;;
    remove|rm|yeet)    (( $# )) || die "remove what tho"; for p; do remove_pkg "$p"; done ;;
    autoremove|clean)  cmd_autoremove ;;
    list|ls)           cmd_list ;;
    files)             cmd_files "$@" ;;
    owns)              cmd_owns "$@" ;;
    build)             build_pkg "${1:-.}" "${2:-$PWD}"; echo "$BUILT_PKG" ;;
    add)               (( $# )) || die "add what tho"; for p; do install_file "$p" explicit; done ;;
    srcinfo)           cmd_srcinfo "$@" ;;
    checksum)          cmd_checksum "$@" ;;
    new)               cmd_new "$@" ;;
    repo|repos)        cmd_repo "$@" ;;
    dirt)              cmd_dirt "$@" ;;
    rollback|undo)     cmd_rollback "$@" ;;
    hold|pin)          (( $# )) || die "hold what tho"; cmd_hold "$@" ;;
    unhold|unpin)      (( $# )) || die "unhold what tho"; cmd_unhold "$@" ;;
    export)            cmd_export "$@" ;;
    import)            cmd_import "$@" ;;
    __complete)        cmd_complete "$@" ;;
    __paths)           printf 'version=%s\nrepo=%s\ndb=%s\ncache=%s\ndirt=%s\npm=%s\n' "$GURT_VERSION" "$GURT_REPO_DIR" "$DB" "$GURT_CACHE" "$(dirt_on && echo on || echo off)" "$PM" ;;
    gui)               cmd_gui "$@" ;;
    completions)       completion_script "${1:?usage: gurt completions bash|zsh|fish}" ;;
    outsource|os|clone) (( $# )) || die "outsource what tho — gurt outsource https://github.com/user/repo"
                       for p; do outsource_install "$p" explicit; done ;;
    doctor)            cmd_doctor ;;
    yo)                echo "gurt: yo 🦆" ;;
    version)           cmd_version ;;
    hi)                cmd_version; [[ -t 1 ]] && echo "  gurt help  → all the commands 🦆" && echo ;;
    help)              usage ;;
    *)                 die "unknown command '$cmd' (try: gurt help)" ;;
  esac
}
main "$@"
